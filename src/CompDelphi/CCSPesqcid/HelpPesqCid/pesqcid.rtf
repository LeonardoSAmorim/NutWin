\par }\pard\plain \s1\li115\ri130\keepn\nowidctlpar\widctlpar\outlinelevel0\adjustright \b\f1\fs16\kerning28\cgrid {\page }{\cs23\super #{\footnote \pard\plain \s22\li115\ri130\sa48\nowidctlpar\widctlpar\adjustright \f1\fs20\cgrid {\cs23\super #}{ PesquisaAutomatica}}}{ }{\cs23\super ${\footnote \pard\plain \s22\li115\ri130\sa48\nowidctlpar\widctlpar\adjustright \f1\fs20\cgrid {\cs23\super $}{ PesqCID.PesquisaAutom\'e1tica}}}{ }{\cs23\super K{\footnote \pard\plain \s22\li115\ri130\sa48\nowidctlpar\widctlpar\adjustright \f1\fs20\cgrid {\cs23\super K}{ PesquisaAutomatica}}}{ }{\cs23\super +{\footnote \pard\plain \s22\li115\ri130\sa48\nowidctlpar\widctlpar\adjustright \f1\fs20\cgrid {\cs23\super +}{ PESQCID:0}}}{ PesqCID.PesquisaAutomatica 
