\par }\pard \li115\ri130\sa48\nowidctlpar\widctlpar\adjustright {
\par }{\b\ul Exemplo em Delphi
\par }{
\par O seguinte c\'f3digo demonstra o uso das principais carateristicas do componente.
\par 
\par unit ExPesqCID;
\par 
\par interface
\par 
\par uses
\par   Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
\par   OleCtrls, PesqCidXCntrl_TLB, StdCtrls;
\par 
\par type
\par   TForm1 = class(TForm)
\par     Edit2: TEdit;
\par     Edit3: TEdit;
\par     Button1: TButton;
\par     PesqCidX1: TPesqCidX;
\par     Edit1: TEdit;
\par     Label1: TLabel;
\par     Label2: TLabel;
\par     Label3: TLabel;
\par     procedure Button1Click(Sender: TObject);
\par     procedure FormCreate(Sender: TObject);
\par     procedure PesqCidX1CanClose(Sender: TObject; const NewCID: WideString;
\par       var CanClose: WordBool);
\par   private
\par     \{ Private declarations \}
\par   public
\par     \{ Public declarations \}
\par   end;
\par 
\par var
\par   Form1: TForm1;
\par 
\par implementation
\par 
\par \{$R *.DFM\}
\par 
\par procedure TForm1.FormCreate(Sender: TObject);
\par begin
\par //Inicializa para pesquisar por indu\'e7\'e3o de parto
\par Edit1.Text:='indu\'e7\'e3o';
\par end;
\par 
\par procedure TForm1.Button1Click(Sender: TObject);
\par begin
\par 
\par //Inicializa a pesquisa
\par PesqCidX1.PesquisaInicial :=Edit1.text;
\par 
\par //Abre a tela de pesquisa para que o usuario escolha
\par //um diagnostico
\par if PesqCidX1.Execute then
\par    begin
\par 
\par    //Apresenta o codigo e a descricao do diagnostico escolhido
\par    Edit2.Text:=PesqCidX1.CodigoCID + '-'+PesqCidX1.DescricaoCID ;
\par 
\par    //Apresenta a ultima palavra pesquisada
\par    Edit3.Text:=PesqCidX1.PesquisaInicial;
\par 
\par    end;
\par end;
\par 
\par procedure TForm1.PesqCidX1CanClose(Sender: TObject;
\par   const NewCID: WideString; var CanClose: WordBool);
\par begin
\par if (Pos ('O6',NewCID) <> 0) then
\par    begin
\par    ShowMessage('Estes diagn\'f3sticos s\'f3 podem ser usados em mulheres');
\par    CanClose:=False;
\par    end
\par else
\par     CanClose:=True;
\par end;
\par 
\par end.
\par 
\par A aplica\'e7\'e3o apresentar\'e1 a seguinte tela,
\par 
\par }{\pard\plain \li115\ri130\sa48\nowidctlpar\widctlpar\adjustright \f1\fs16\cgrid \{bml ExmpBef.bmp\}}{
\par 
\par Depois de escolher um c\'f3digo aparecer\'e1 assim:
\par 
\par }{\pard\plain \li115\ri130\sa48\nowidctlpar\widctlpar\adjustright \f1\fs16\cgrid \{bml ExmpAft.bmp\}}{
\par 
\par 
\par 
\par }\pard\plain \s1\li115\ri130\keepn\nowidctlpar\widctlpar\outlinelevel0\adjustright \b\f1\fs16\kerning28\cgrid {\page }{\cs23\super #{\footnote \pard\plain \s22\li115\ri130\sa48\nowidctlpar\widctlpar\adjustright \f1\fs20\cgrid {\cs23\super #}{ TelaPesquisa}}}{ }{\cs23\super ${\footnote \pard\plain \s22\li115\ri130\sa48\nowidctlpar\widctlpar\adjustright \f1\fs20\cgrid {\cs23\super $}{ Tela de Pesquisa}}}{ }{\cs23\super K{\footnote \pard\plain \s22\li115\ri130\sa48\nowidctlpar\widctlpar\adjustright \f1\fs20\cgrid {\cs23\super K}{ TelaPesquisa}}}{ }{\cs23\super +{\footnote \pard\plain \s22\li115\ri130\sa48\nowidctlpar\widctlpar\adjustright \f1\fs20\cgrid {\cs23\super +}{ PESQCID:0}}}{ Tela de Pesquisa
\par }\pard\plain \li115\ri130\sa48\nowidctlpar\widctlpar\adjustright \f1\fs16\cgrid {Para obter ajuda a respeito de um item, clique com o bot\'e3o do mouse na figura correspondente.
