package PsqCID;

{$R *.RES}
{$R 'UPesqCid.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $00400000}
{$DESCRIPTION 'Componentes PesqCID - CCSSIS'}
{$IMPLICITBUILD OFF}

requires
  vcl40,
  VCLDB40;

contains
  Index32 in 'INDEX32.PAS',
  UPesqCid in 'UPesqCid.pas' {BuscaCodigo},
  PesqCidXCntrl_TLB in 'VersaoOCX\PesqCidXCntrl_TLB.pas';

end.
