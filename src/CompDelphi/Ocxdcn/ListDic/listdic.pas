{ Write method for property Dicionario }
procedure TListDic.SetDicionario(Value : TDicionario);
{********************************************************
SetDicionario:
Atualiza o valor da referencia para o Dicionario
Ver Nota 1
**********************************************************}
begin
  //: ver Nota 3
  if not(csLoading in ComponentState) then
     begin
     SetActive (False);
     if Assigned (TreeDic) then
        begin
        TreeDic.OnClick:=nil;
        TreeDic:=nil;
        FUser:='';
        FPassword:='';
        end;
     end;

  FDicionario:=Value;
  if Value <> nil then Value.FreeNotification(Self);
 end;

procedure TListDic.SetActive(Value : Boolean);
begin
  if not(csLoading in ComponentState) then
    begin
    if Assigned (FDicionario) and FActive <> Value then
     begin
      if Value then
       begin
       if (FDicionario.Connected) then
          //Dicionario previamente conectado
          begin
          BeforeOpen;
          FActive := True;
          end
       else
          if (FDicionario.ConnectDictionary(FUser,FPassword)) then
          //Dicionario conectado
          begin
          BeforeOpen;
          FActive := True;
          end;

       end
      else
       begin
       AfterClose;
       FActive := False;
       end;
     end;
    end else FActive := Value;
end;

