procedure TListDic.ClickOnTreeDic(Sender: TObject; Code, Description: string);
begin
if FCode = Code then Exit;

FCode:=Code;
FDescription:=Description;
MontaFrasePreencheList;
end;

{********************************************************
BeforeOpen:
Nesta rotina é inicializado o primeiro no do TreeView :o ROOT.
Como descrição vai a SiglaDicionario do dicionario. Pode ir o
NomeDicionario. Como Código vai 'ROOT'.
A rotina PreencheTree, completa os primeiros filhos do ROOT.
O resto da arvore e preenchido a medida que é solicitado (Ver DblClick).
**********************************************************}
procedure TListDic.BeforeOpen;
//var
//   ChildCount: Smallint;
//   SonCode: String;
//   SonDesc: String;
begin
FDicionario.GetCurrentParent (FCode,Fdescription);
MontaFrasePreencheList;
end;
{********************************************************
AfterClose:
Nesta rotina são reinicializados o TreeView e o StrList.
**********************************************************}
procedure TListDic.AfterClose;
begin
Items.Clear;
end;


