{ Adiciona Code e Description }
procedure TListDic.Click;
var
   NewItem : TListItem;
   DescAtual: WideString;
   CodePai : WideString;
begin
{ Code to execute before activating click
       behavior of component's parent class }
{ Activate click behavior of parent }
inherited Click;

{ Code to execute after click behavior
       of parent }

NewItem:=GetItemAt(m_Xpos, m_Ypos);

if NewItem <> NIL then
   begin
   if not m_ModoProcura then
      begin
      FDescription:=NewItem.SubItems[0];
      FCode:=NewItem.Caption;

      if (FDicionario.HasChilds (FCode) = FALSE)  then
        DescAtual := m_DescricaoPai + ' : '+ Trim (FDescription)
      else
        DescAtual := Trim (FDescription);

      if Assigned(FLblFrase) then
        FLblFrase.Caption := Trim (FCode) + ' - ' + DescAtual;
      end
   else
      if NewItem.Caption = '...' then
         BotaoProcuraClick(self)
      else
      begin
         m_ContadorPalavras :=0;
         FDescription:=NewItem.SubItems[0];
         FCode:=NewItem.Caption;
         FDicionario.FindParents(FCode,CodePai);
         FDicionario.GetFirstParent(CodePai,m_DescricaoPai);
         m_DescricaoPai:=Trim (m_DescricaoPai);
         MontaFrasePreencheList;
      end;
   end;


if Assigned (FOnClickDic) then
     FOnClickDic (Self,FCode,FDescription);


end;

procedure TListDic.DblClick;
//var
//   ChildCount: Smallint;
//   NewItem : TListItem;
begin

inherited DblClick;
MontaFrasePreencheList;

end;

procedure TListDic.MontaFrasePreencheList;
var
   ChildCount: Smallint;
   DescAtual: string;
begin

if Assigned (FDicionario) then
     begin
     if (FDicionario.HasChilds (FCode) = FALSE)  then
          DescAtual := m_DescricaoPai + ' : '+ Trim (FDescription)
     else
          DescAtual := Trim (FDescription);

     if Assigned(FLblFrase) then
          FLblFrase.Caption := Trim (FCode) + ' - ' + DescAtual;

     if (FDicionario.ExpandCode(FCode,ChildCount)) then
          begin
          m_DescricaoPai:=Trim (FDescription);
          PreencheListView;
          end;
     end;



end;

procedure TListDic.PreencheListView;
var
   NewItem : TListItem;
   Code : WideString;
   Description : WideString;

begin
//Limpo a lista
Items.Clear;

//Adiciono o item retorno da arvore
if Assigned(FDicionario) then
   begin
        with FDicionario do
        begin
        GetCurrentParent(Code,Description);
        while (Code <> 'ROOT') do
              begin
              NewItem:=Items.Insert(0);
              NewItem.Caption := Code;
              NewItem.SubItems.Add(Description);
              NewItem.ImageIndex:=2;
              FindParents(Code,Code);
              GetFirstParent (Code,Description);
              end;

        //Pega o Primeiro Filho do Novo Pai
        GetFirstSon(Code,Description);
        NewItem:=Items.Add;
        NewItem.Caption := Code;
        NewItem.SubItems.Add(Description);

        if HasChilds(Code) then
              NewItem.ImageIndex:=1
        else
              NewItem.ImageIndex:=0;

        //Pego os outros filhos
        while (GetNextBrother(Code,Description)) do
              begin
              NewItem:=Items.Add;
              NewItem.Caption := Code;
              NewItem.SubItems.Add(Description);
              if HasChilds(Code) then
                 NewItem.ImageIndex:=1
              else
                 NewItem.ImageIndex:=0;
              end;
        end;
   end;
end;


procedure TListDic.BotaoProcuraClick(Sender: TObject);
var
   NewItem : TListItem;
   Code : WideString;
   Description : WideString;
   MoreItems : Boolean;

begin
if Assigned (FDicionario) and Assigned (FPalavraPesquisada) then
with FDicionario do
     begin
     if not m_ModoProcura then
     begin
     Description := '%' + FPalavraPesquisada.Text + '%';
     if (FindCodeByDescription(Code,Description) > 0) then
        begin
        m_ModoProcura:=True;
        m_ContadorPalavras:=0;
        //Limpo a lista
        Items.Clear;

        //Pega o Primeiro da Lista
        GetFirstCodeByDesc(Code,Description);
        NewItem:=Items.Add;
        NewItem.Caption := Code;
        NewItem.SubItems.Add(Description);

        //m_CIDAtual := Trim (Code);

        if HasChilds(Code) then
           begin
           NewItem.ImageIndex:=1;
           end
        else
           begin
           NewItem.ImageIndex:=0;
           end;
        end;
     end
     else
     begin
     //Limpo o ultimo item que tem o '...' 'Mais items ...'
     Items.Delete (Items.Count -1);
     end;
     begin
        //Pego os outros filhos
        MoreItems:=GetNextCodeByDesc(Code,Description);
        while (MoreItems and (m_ContadorPalavras < 30)) do
           begin
           m_ContadorPalavras:=m_ContadorPalavras + 1;
           NewItem:=Items.Add;
           NewItem.Caption := Code;
           NewItem.SubItems.Add(Description);
           if HasChilds(Code) then
              NewItem.ImageIndex:=1
           else
              NewItem.ImageIndex:=0;
           MoreItems:=GetNextCodeByDesc(Code,Description);
           end;

        m_ContadorPalavras:=0;
        if MoreItems then
           begin
           NewItem:=Items.Add;
           NewItem.Caption := '...';
           NewItem.SubItems.Add('Mais items..');
           end
        else
           m_ModoProcura:= False;
        end;
     end;
end;


