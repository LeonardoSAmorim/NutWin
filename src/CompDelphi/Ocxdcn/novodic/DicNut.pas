function TAttributedDic.GetAttributeByCode(Code: WideString;
  AttributeName: string; var Attribute: string): boolean;
begin

with AuxTab do
  begin
    if not Active then
    try
    { First try to use an alias }
      if DataSourceName <> '' then
         begin
         DatabaseName := DataSourceName;
         TableName := SiglaDicionario;
         Active := True;
         end;
    except
      on E:EDatabaseError do
      { If that fails, try to use the drive and directory }
      ShowMessage ('Erro 2114: ' + E.Message  + DataSourceName + ' - ' +SiglaDicionario);
    end;

    if Locate ('cod_'+SiglaDicionario,Code,[])then
       begin
       Attribute:=FieldByName(AttributeName).AsString;
       Result:=True;
       end
    else
       begin
       Attribute:='';
       Result:=False;
       end;

  end;
end;

