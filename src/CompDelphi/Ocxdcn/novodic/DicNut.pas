//Pesquisa e constroi uma lista sem repetições de todas as instancias (folhas)
//da árvore embaixo do galho pasado como código
//Esta rotina é recursiva e verifica que não pase duas vezes pelo mesmo código
//Isto é para prevenir travamentos por causa de listas mal construidas
//A pesquisa é por profundidade
function TNewDic.CollectAllInstances (Code : string; var Instancias: TStringList): boolean;
var
ListaFilhos: TStringList;
SonCount: smallint;
Codigo, Descricao: WideString;
Index : integer;
begin

{********************** Desativando, pois estava dando problemas
//Esta lista mantam os codigos navegados em profundidade
//Se pasamos duas vezes pelo mesmo codigo (tem repetição)
//quer dizer que a tabela esta furada
if DeepList.Find (Code,Index) then
   begin
   //Estamos com problemas. Já pasamos por este código antes.
   //Limpa a lista
   DeepList.clear;
   //Sai com erro
   Result:=False;
   exit;
   end
else
***************************************************************}
    //Ok. Adicione o codigo
    DeepList.Add (Code);

//Verifica a quantidade máxima de níveis
if DeepList.Count > MaximoNiveis then MaximoNiveis:=DeepList.Count;

//Lista auxiliar
ListaFilhos:=TStringList.Create;

Codigo := Code;
//Expande o codigo recebido
if (ExpandCode (Codigo, SonCount)) then
    begin
    //Monta a lista auxiliar de todos os filhos que tem este código
    GetFirstSon( Codigo, Descricao);
    ListaFilhos.Insert(0, Codigo);
    while (GetNextBrother(Codigo, Descricao)) do
          ListaFilhos.Insert(0, Codigo);

    //Depois de construir a lista de filhos, percorre ele um
    //por um, coletando as instancias deles.
    while SonCount <>0 do
          begin
          //Se um filho tem netos, colecta as instancias dele (recursão)
          if HasChilds(ListaFilhos [SonCount-1]) then
             begin
             if not CollectAllInstances ( ListaFilhos [SonCount-1],Instancias) then
                begin
                //Libera a lista auxiliar
                ListaFilhos.Free;
                Result:=False;
                exit
                end;
             end
          else
             begin
             //Senão, é uma folha (instancia). Adiciona ela na lista.
             if Instancias.IndexOf ( ListaFilhos[SonCount-1])=-1 then
                Instancias.Add (ListaFilhos[SonCount-1]);
             end;
          SonCount:=SonCount-1;
          end;
    end;
//Libera a lista auxiliar
ListaFilhos.Free;
Result:=True;
//Apaga o codigo da lista de profundidade
if DeepList.Find (Code,Index) then DeepList.Delete (Index);
end;

//Constroi uma lista de codigos que representa o cminho ate o ROOT
//O promeiro elemento do array ([0]), é o ROOT e o último ([n]), é o codigo
//pasado para pesquisa
function TNewDic.FindROOTPath (code:string;var ROOTPath: TStringList) : boolean;

var
 Index: integer;
 DADsCount: SmallInt;
 SonCode, FirstFatherCode: WideString;
begin
SonCode:=code;

//Limpa a lista
ROOTPath.clear;

//Insere o proprio como ultimo elemento da lista
ROOTPath.Insert (0,SonCode);

//Procura o primeiro pai
DADsCount:=FindParents(SonCode,FirstFatherCode);

 while (DADsCount > 0) do
       begin
       //Verifica que a arvore nao tem heranca multipla.
       //Este metodo nao funciona em codigos que tem mais de um pai.
       if DADsCount > 1 then
          begin
          Result:=False;
          exit;
          end;

       //Verifica que a tabela de pais e filhos nao tem erros
       //Quer dizer, checa se nao esta pasando de novo pelo mesmo lugar
       if (ROOTPath.Find (FirstFatherCode,Index)) then
          begin
          Result:=False;
          exit;
          end
       else
          ROOTPath.Insert (0,FirstFatherCode);
       SonCode:=FirstFatherCode;

       //Procura o proximo pai
       DADsCount:=FindParents(SonCode,FirstFatherCode);

       end;

Result:=True;
end;

//Obtem o ancestro comum entre dosi codigos
function TNewDic.GetLowestAncestor (FirstCode, SecondCode: string; var CommonAncestor: string) : integer;
var
FirstPath,SecondPath : TStringList;
MinIndex, Index: integer;
begin
//Listas que armazenam a rota ate o ROOT
FirstPath:=TStringList.Create;
SecondPath:=TStringList.Create;

//Pega a rota ate o ROOT
FindROOTPath (FirstCode, FirstPath);
FindROOTPath (SecondCode, SecondPath);


// find the shortest path
if (FirstPath.Count < SecondPath.Count) then
   MinIndex := FirstPath.Count - 1
else
    MinIndex := SecondPath.Count - 1;

Index:=0;

//* find the LCA node */
while (Index <= MinIndex) do
      begin
      if (FirstPath[Index] = SecondPath[Index]) then
         begin
         //O ancestro em comum
         CommonAncestor:= FirstPath[Index];
         Index:=Index+1
         end

      else
         break;
      end;

//Se o index é um, quer dizer que sao filhos de deus, por isso sao irmaos
//mais pertencem a familias diferentes
if Index=1 then
   Result:=-1
else
    //A relacao de parentesco
    Result:=(FirstPath.Count - Index) * (SecondPath.Count - Index);

end;

//Procura o ancestro em comum e retorna os dois primeiros filhos dele (irmãos )
//que correspondem a linha direta dos códigos pasados
function TNewDic.GetFarParents (FirstCode, SecondCode: string; var Parent1, Parent2: string) : integer;
var
FirstPath,SecondPath : TStringList;
MinIndex, Index: integer;
begin
//Listas que armazenam a rota ate o ROOT
FirstPath:=TStringList.Create;
SecondPath:=TStringList.Create;

//Pega a rota ate o ROOT
FindROOTPath (FirstCode, FirstPath);
FindROOTPath (SecondCode, SecondPath);


// find the shortest path
if (FirstPath.Count < SecondPath.Count) then
   MinIndex := FirstPath.Count - 1
else
    MinIndex := SecondPath.Count - 1;

Index:=0;

//* find the LCA node */
while (Index <= MinIndex) do
      begin
      //Os dois primeiros irmaos
      Parent1:= FirstPath[Index];
      Parent2:= SecondPath [Index];
      if (FirstPath[Index] = SecondPath[Index]) then
         begin
         Index:=Index+1
         end

      else
         break;
      end;

//Se o index é um, quer dizer que sao filhos de deus, porisso sao irmaos
//mais pertencem a familias diferentes
if Index=1 then
   Result:=-1
else
    //A relacao de parentesco
    Result:=(FirstPath.Count - Index) * (SecondPath.Count - Index);

end;

//Pesquisa e constroi uma lista de todos os pais e filhos, na ordem de navegação
// da direita para esquerda e de cima pra baixo,
//da árvore embaixo do galho pasado como código
//Esta rotina é recursiva e verifica que não pase duas vezes pelo mesmo código
//Isto é para prevenir travamentos por causa de listas mal construidas
//A pesquisa é por profundidade
function TNewDic.ListAll( Code : String; var AllInstances: TStringList ) : boolean;
var
   ListaFilhos: TStringList;
   SonCount: smallint;
   Codigo, Descricao: WideString;
   Index : integer;
begin

{*************************** Desativando, pois estava dando problemas
   //Esta lista mantam os codigos navegados em profundidade
   //Se pasamos duas vezes pelo mesmo codigo (tem repetição)
   //quer dizer que a tabela esta furada
   if DeepList.Find (Code,Index) then
      begin
         //Estamos com problemas. Já pasamos por este código antes.
         //Limpa a lista
         DeepList.clear;
         //Sai com erro
         Result:=False;
         exit;
      end
   else
**********************************************************************}
      //Ok. Adicione o codigo
      DeepList.Add (Code);

   //Verifica a quantidade máxima de níveis
   if DeepList.Count > MaximoNiveis then MaximoNiveis:=DeepList.Count;

   //Lista auxiliar
   ListaFilhos:=TStringList.Create;

   //Expande o codigo recebido
   Codigo := Code;
   if (ExpandCode (Codigo, SonCount)) then
      begin
          //Monta a lista auxiliar de todos os filhos que tem este código
          GetFirstSon( Codigo, Descricao);
          ListaFilhos.Insert(0, Codigo);
          while (GetNextBrother(Codigo, Descricao)) do
                ListaFilhos.Insert(0, Codigo);

          //Depois de construir a lista de filhos, percorre ele um
          //por um, coletando as instancias deles.
          while SonCount <>0 do
             begin
                //Se um filho tem netos, colecta as instancias dele (recursão)
                if HasChilds(ListaFilhos [SonCount-1]) then
                   begin
                     // Pega primeira instancia da lista.
                     AllInstances.Add(ListaFilhos [SonCount-1]);
                     if not ListAll(ListaFilhos [SonCount-1], AllInstances) then
                        begin
                           //Libera a lista auxiliar
                           ListaFilhos.Free;
                           Result:=False;
                           exit
                        end;
                   end
                else
                   begin
                      //Senão, é uma folha (instancia).
                      AllInstances.Add(ListaFilhos [SonCount-1]);
                   end;
                SonCount:=SonCount-1;
             end;
      end;

   //Libera a lista auxiliar
   ListaFilhos.Free;
   Result:=True;
   //Apaga o codigo da lista de profundidade
   if DeepList.Find (Code,Index) then DeepList.Delete (Index);
end;

function TNewDic.CollectListInstances (Code : string; var ListaFilhos: TStringList; ListaTipo: TListaTipoDic = ltDescription): boolean;
var
   Codigo, Descricao: WideString;
   SonCount : smallint;
begin
   Result := True;

   //Lista auxiliar
//   ListaFilhos:=TStringList.Create;

   //Expande o codigo recebido
   Codigo := Code;
   if (ExpandCode (Codigo, SonCount)) then
      begin
          //Monta a lista auxiliar de todos os filhos que tem este código
          GetFirstSon( Codigo, Descricao);
          if ListaTipo = ltDescription then
             ListaFilhos.Insert(0, Descricao)
          else
             ListaFilhos.Insert(0, Codigo);
          while (GetNextBrother(Codigo, Descricao)) do
              if ListaTipo = ltDescription then
                ListaFilhos.Insert(0, Descricao)
              else
                ListaFilhos.Insert(0, Codigo);
      end
   else
      Result:=False;
end;

