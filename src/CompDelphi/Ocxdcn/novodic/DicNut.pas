// Coleta as instancias de TMedidas
function TCacheDic.ListAll( Code : String; var AllInstances: TStringList ) : boolean;
begin

with Cache1Tab do
  begin
    if not Active then
    try
    { First try to use an alias }
      if DataSourceName <> '' then
         begin
         DatabaseName := DataSourceName;
         TableName := SiglaDicionario + '_PF';
         IndexName := SiglaDicionario + '_PF1';
         ReadOnly := True;
         Active := True;
         end;
    except
      on E: EDatabaseError do
      { If that fails, try to use the drive and directory }
      ShowMessage ('Erro 2115: ' + E.Message  + DataSourceName );
    end;
    Filter := 'CODPAI_' + SiglaDicionario + ' = ''' + Code + ''' AND MEDIDA_' + SiglaDicionario + ' = ''T'' ';;
    Filtered := True;
    if IsEmpty or not ActiveCache then
      begin
       Result:=inherited ListAll(Code, AllInstances);
       FCached := False;
      end
    else
       begin
          while not EOF do
             begin
                AllInstances.Add( FieldByName( 'CODFILHO_' + SiglaDicionario ).AsString );
                Next;
             end;
          Result:=True;
          FCached := True;
       end;
  end;

end;

function TCacheDic.CollectAllInstances (Code : string; var Instancias: TStringList): boolean;
begin

with Cache2Tab do
  begin
    if not Active then
    try
    { First try to use an alias }
      if DataSourceName <> '' then
         begin
         DatabaseName := DataSourceName;
         TableName := SiglaDicionario + '_PF';
         IndexName := SiglaDicionario + '_PF1';
         ReadOnly := True;
         Active := True;
         end;
    except
      on E:EDatabaseError do
      { If that fails, try to use the drive and directory }
      ShowMessage ('Erro 2116: ' + E.Message  + DataSourceName );
    end;
    Close;
    Filter := 'CODPAI_' + SiglaDicionario + ' = ''' + Code + ''' AND MEDIDA_' + SiglaDicionario + ' = ''T'' ';
    Filtered := True;
    Open;
    if IsEmpty or not ActiveCache then
       begin
       ClearDeepList;
       Result:=inherited CollectAllInstances(Code, Instancias);
       FCached := False;
       end
    else
       begin
          while not EOF do
             begin
                Instancias.Add( FieldByName( 'CODFILHO_' + SiglaDicionario ).AsString );
                Next;
             end;
          Result:=True;
          FCached := True;
       end;
  end;

end;

