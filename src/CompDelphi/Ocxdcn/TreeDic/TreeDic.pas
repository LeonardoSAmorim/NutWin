{********************************************************
 Loaded: ver Nota 3
 O Form acabou de ser carregado e as conexoes podem ser
 reestabelecidas.
 ********************************************************}
procedure TTreeDic.Loaded;
begin
     inherited Loaded;

     { Perform any component setup that depends on the property
       values having been set }
if  Assigned (FDicionario) and FActive  then
       begin
       if (FDicionario.Connected) then
          //Dicionario previamente conectado
          begin
          BeforeOpen;
          FActive := True;
          end
       else
       if (FDicionario.ConnectDictionary(FUser,FPassword)) then
          //Dicionario conectado
          begin
          BeforeOpen;
          FActive := True;
          end else FActive := False;
       end;
end;

{********************************************************
PreencheTree:
Esta rotina preenche um galho da árvore, pegando os filhos do Dicionário.
Para poder definir qual é o código de cada nó do TreeView é necesario
armazenar ele junto de cada nó. Isto é feito usando a variavel :
Node.Data.
Esta variável armazena apenas um ponteiro. Por isso é necesário alocar
espaço dinámicamente para um string a fim de armazenar o Código do
item no Dicionário. O ponteiro de essa área, é armazenado no
Node.Data.
A descrição do Código vai direto na variável Node.Text
**********************************************************}
procedure TTreeDic.PreencheTree (Code : string; Node : TTreeNode);
var
  ChildCount : Smallint;
  pSonCode : ^string;
  SonCode : WideString;
  Description : WideString;
  NewNode : TTreeNode;
begin
with FDicionario do
     //Expande o código no Dicionário
     if (ExpandCode  (Code, ChildCount)) Then
        begin
        GetFirstSon (SonCode,Description);
        repeat
        
          // Interceptando Descricao para alteracao
          if Assigned( FOnNewDescription ) then
             FOnNewDescription(self,SonCode,Description);

          //Aloca espaço para armazenar o código
          new (pSonCode);
          //Copia o código
          pSonCode^:= SonCode;
          StrList.Add(pSonCode);
          //Acrescenta um nó na árvore
          NewNode := Items.AddChildObject(Node,Description, pSonCode);  //pSonCode
          //Se o Código tem filhos, então põe figura de livro fechado, senão, vai uma folha
          if HasChilds (SonCode) Then NewNode.ImageIndex := 1 Else NewNode.ImageIndex := 0;
          NewNode.SelectedIndex := NewNode.ImageIndex;
        until ( not GetNextBrother(SonCode,Description));
        if assigned (Selected) Then Selected.Expand(FALSE);
        end else SetActive (False);  //: ver Nota 3
end;

{********************************************************
BeforeOpen:
Nesta rotina é inicializado o primeiro no do TreeView :o ROOT.
Como descrição vai a SiglaDicionario do dicionario. Pode ir o
NomeDicionario. Como Código vai 'ROOT'.
A rotina PreencheTree, completa os primeiros filhos do ROOT.
O resto da arvore e preenchido a medida que é solicitado (Ver DblClick).
**********************************************************}
procedure TTreeDic.BeforeOpen;
var
pData : ^string;
begin
//Espaco pra armazenar o Codigo
new (pData);
pData^ := 'ROOT';
StrList.Clear;
//A lista serve pra poder liberar a memoria alocada para os strings: ver Nota 5
StrList.Add (pData);
//Se tudo da certo
//Cria o primeiro nó
Items.AddChildObject(nil,FDicionario.SiglaDicionario, pData).Selected := True;
with Selected  do
     begin
    //Põe figura de livro fechado
     ImageIndex := 1;
     SelectedIndex := ImageIndex;
     end;
//Preenche os primeiros filhos
PreencheTree ('ROOT',Selected);
end;
{********************************************************
AfterClose:
Nesta rotina são reinicializados o TreeView e o StrList.
**********************************************************}
procedure TTreeDic.AfterClose;
begin
StrList.Clear;
Items.Clear;
end;


{********************************************************
 SetActive: ver Nota 3
 Altera o estado da conexao com o dicionario.
 ********************************************************}
procedure TTreeDic.SetActive(Value: Boolean);
begin
  if not(csLoading in ComponentState) then
    begin
    if Assigned (FDicionario) and FActive <> Value then
     begin
      if Value then
       begin
       if (FDicionario.Connected) then
          //Dicionario previamente conectado
          begin
          BeforeOpen;
          FActive := True;
          end
       else
          if (FDicionario.ConnectDictionary(FUser,FPassword)) then
          //Dicionario conectado
          begin
          BeforeOpen;
          FActive := True;
          end;

       end
      else
       begin
       AfterClose;
       FActive := False;
       end;
     end;
    end else FActive := Value;
end;

{********************************************************
Nota 1: Object Properties
Este componente precisa de um outro pra funcionar. Especificamente,
e necesário uma referência para um TDicionario que esta no Form.
Para conseguir fazer isso, crio uma variavel (FDicionario) do tipo
TDicionario, pra quem é atribuido o valor passado pelo usuario.
Quem cuida disso e a rotina SetDicionario. Ela chama a rotina FreeNotification
para pedir pro dicionario que avise quando ele for deletado do Form.
Senao, da EReadAccessError porque a referencia FDicionario fica inválida.
Se o dicionario for destruido (alguem da <Del> durante a edicao do form)
o TTreeDic será notificado (rotina Notification) para colocar nil
na referencia FDicionario.
**********************************************************}
{********************************************************
Nota 2: Read Only, Public Properties
Estas propriedades so podem ser acessadas em runtime (public e nao published)
e so pra escrita (nao tem write, só read).
Ex:
var
T1: TTreeDic;
Codigo: string;
begin
Codigo:=T1.Code;
.....
Pra isso defino assim:
    public
        property Code : String read FCode;
        property Description : String read FDescription;
onde FCode,FDesc... são as variáveis internas (private) do componente.
**********************************************************}
{********************************************************
Nota 3: Ativacao e desativacao da conexao com o dicionario
em edicao e runtime.
Esta propriedade define a aparencia do componente durante a edicao.
É um exemplo de propriedade que é lida diretamente da variavel
FActive, mais pra ser alterada usa o método SetActive
e usa um default (False).

property Active: Boolean read FActive write SetActive default False;

Como existe uma rotina (SetActive) para definir o valor de FActive,
nao é necesário fazer isto durante o Create.

Durante a carga do Form quando e aberta a aplicacao (pra edicao
ou pra executar), é chamado o método SetActive.
Por isso usa o
  if not(csLoading in ComponentState) then ...
  ...
  else FActive:=Value;
pois neste caso (csLoading: carregando o form) é necesário apenas
atualizar o valor de FActive.
Depois de carregado o Form (rotina Loaded),é quando deve ser
reestabelecida a conexao com o Dicionário.É o momento certo.
SetActive so restabelece a conexao se ela nao existia anteriormente e
se o FDicionario é válido.
Cada vez que acontece algum evento que invalida a conexao com o
dicionario, (P.ex: É atribuido um novo valor para FDicionario,
rotina SetDicionario), é necesário setar FActive:= False
usando o SetActive (False).
**********************************************************}
{********************************************************
Nota 4: Read write properties.
Propriedades normais, só precisam ter uma variavel definida
(P.Ex: FUser) e uma declaracao na area
published:
        property User: string read FUser write FUser;
Os valores default de variaveis strings, precisam ser definidos
no constructor (rotina Autoinitialize).
**********************************************************}
{********************************************************
Nota 5: Objetos private.
StrList é um variavel que só tem sentido ser utilizada
por esta classe. Por isso é declarada private.
StrList armazena os enderecos de toda a memoria alocada dinamicamente pra os
strings do TreeView que depois é liberada no destructor (Autodestroy).
**********************************************************}
{********************************************************
Nota 6: Redefinindo eventos.
OnClick é um evento já definido no TCustomTreeView pai, do
TTreeDic. Queremos alterar o comportamento para que o usuário
do componente receba como parámetros, ao tratar o evento OnClick,
o Código e a Descrição do item que foi clicado no tree view.
Para fazer isto, primeiro é necessário definir o formato que terá
o métdo OnClick do meu usuário.
A definição de
  TClickDicEvent = procedure (Sender: TObject; Code: String; Description: String) of object;
faz isto.
Quando o OnClick seja tratado no form do usuário do componente,
ele ficará assim:

procedure TForm1.TreeDic1Click(Sender: TObject; Code, Description: string);
begin
end;
Alem disso, preciso definir uma variavel private:
        FOnClickDic : TClickDicEvent;
e uma property:
        property OnClick: TClickDicEvent read FOnClickDic write FOnClickDic;

que armazenam o endereco da rotina do usuario para o tratamento
do click.
Depois temos que definir a rotina:
        procedure Click; override; //: ver Nota 6
A rotina Click é um override no handler do evento original do Click.

**********************************************************}

end.

