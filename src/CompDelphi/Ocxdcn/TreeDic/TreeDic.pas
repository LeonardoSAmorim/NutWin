{********************************************************
AutoInitialize:
**********************************************************}
{ Method to set variable and property values and create objects }
procedure TTreeDic.AutoInitialize;
begin
StrList := TList.Create; //: ver Nota 5

//Set default values: ver Nota 4
FUser:='';
FPassword:='';

end; { of AutoInitialize }

{********************************************************
 AutoDestroy:
 Method to free any objects created by AutoInitialize
**********************************************************}
procedure TTreeDic.AutoDestroy;
begin
if Assigned (FDicionario) then FDicionario.DisconnectDictionary();
StrList.Free;             //: ver Nota 5
end; { of AutoDestroy }

{********************************************************
Notification:
Se o dicionario for destruido (alguem da <Del> durante a edicao do form)
o TTreeDic será notificado para colocar nil na referencia FDicionario
**********************************************************}

procedure TTreeDic.Notification(AComponent: TComponent;
  Operation: TOperation);
begin
  inherited Notification(AComponent, Operation);
  if (Operation = opRemove) and (FDicionario <> nil) and
     (AComponent = FDicionario) then
     begin
     FDicionario := nil;
     SetActive(False); //: ver Nota 3
     end;
end;

{********************************************************
SetDicionario:
Atualiza o valor da referencia para o Dicionario
Ver Nota 1
**********************************************************}
procedure TTreeDic.SetDicionario(Value: TDicionario);
begin
  //: ver Nota 3
  if not(csLoading in ComponentState) then SetActive (False);
  FDicionario := Value;
  if Value <> nil then Value.FreeNotification(Self);
 end;


{********************************************************
DblClick:
Duplo clique num nó qualquer da árvore :
Se o nó tem filhos e ainda não foi preenchido, então preenche.
********************************************************}
procedure TTreeDic.DblClick;

begin
     { Code to execute before activating click
       behavior of component's parent class }

     if (FActive and (Selected.Count = 0) and (Selected.ImageIndex <> 0)) then
        begin
        FCode := PChar (Selected.Data^);
        FDescription := Selected.Text;
        PreencheTree (PChar (Selected.Data^), Selected);
        end;
     { Activate click behavior of parent }
     inherited DblClick;

     { Code to execute after click behavior
       of parent }

end;
{********************************************************
 Override OnClick handler from TCustomTreeView: ver Nota 6
********************************************************}
procedure TTreeDic.Click;
begin
     { Code to execute before activating click
       behavior of component's parent class }

     { Activate click behavior of parent }
     inherited Click;

     { Code to execute after click behavior
       of parent }
     if FActive then
        begin
        FCode := PChar (Selected.Data^);
        FDescription := Selected.Text;
        if Assigned (FOnClickDic) then
         FOnClickDic (Self,FCode,FDescription);
        end;


end;


{********************************************************
CanExpand :
 Override OnExpanding handler from TCustomTreeView
Usado para mudar a figura de livro aberto pra fechado.
********************************************************}
function TTreeDic.CanExpand(Node: TTreeNode): Boolean;
begin
   with Node do
   begin
   ImageIndex := 2;
   SelectedIndex := ImageIndex;
   end;
{ Activate CanExpand behavior of parent }
   Result:=inherited CanExpand(Node);
end;

{********************************************************
CanCollapse :
 Override OnCollapsing handler from TCustomTreeView
Usado para mudar a figura de livro aberto pra fechado.
********************************************************}
function TTreeDic.CanCollapse(Node: TTreeNode): Boolean;
begin
   with Node do
   begin
   ImageIndex := 1;
   SelectedIndex := ImageIndex;
   end;
{ Activate CanCollapse behavior of parent }
   Result:=inherited CanCollapse(Node);

end;

