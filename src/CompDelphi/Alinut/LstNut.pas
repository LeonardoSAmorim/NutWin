{ Ativar dados }
procedure TListaNutriente.SetAtivar( Value : Boolean );
begin

   // Ativar e Desativar conforme lista de Alimentos
   if (csLoading in ComponentState) then
      FAtivar := Value
   else if Value = FAtivar then
   else if FListaAlimento = nil then
      ShowMessage( 'Lista de Alimentos não definida' )
   else if not Value then
      begin
         ListaAlimento.DMAlimento.dsQNut.DataSet.Close;
         FAtivar := Value;
      end
   else if FAchaPalavra = nil then
      ShowMessage( 'AchaPalavra não definido' )
   else if FAchaDoInicio = nil then
      ShowMessage( 'AchaDoInicio não definido' )
   else if FOrdenarNutrientePor = nil then
      ShowMessage( 'OrdenarNutrientePor não definido' )
   else if FTipoDeOrdem = nil then
      ShowMessage( 'TipoDeOrdem não definido' )
   else if FVerTodos = nil then
      ShowMessage( 'VerTodos não definido' )
   else if FLocalizaTexto = nil then
      ShowMessage( 'LocalizaTexto não definido' )
   else
      begin
         SetEventos;

         FUserName := FListaAlimento.Usuario.Text;
         FPalavra := FAchaPalavra.Text;
         FDoInicio := FAchaDoInicio.Checked;
         FOrdenarPor := FOrdenarNutrientePor.ItemIndex;
         FOrdem := FTipoDeOrdem.ItemIndex;
         FTextoLocalizar := FLocalizaTexto.Text;
//         FVerTodos.Checked := True;

//         ListaAlimento.DMAlimento.dsQNut.DataSet := ListaAlimento.DMAlimento.quNut;
         FListaNutriente.DataSource := FListaAlimento.DMAlimento.dsQNut;

         ExecSQL;
         FAtivar := Value;
      end;
end;

