        FAchaPalavra.OnExit := OnAchaPalavraExit;
        FOnAchaDoInicioClick := FAchaDoInicio.OnClick;
        FAchaDoInicio.OnClick := OnAchaDoInicioClick;
        FOnVerTodosClick := FVerTodos.OnClick;
        FVerTodos.OnClick := OnVerTodosClick;
        FOnLocalizaTextoChange := FLocalizaTexto.OnChange;
        FLocalizaTexto.OnChange := OnLocalizaTextoChange;
        FEventosOk := True;
     end;
end;

{ Executa SQL }
procedure TListaNutriente.ExecSQL;
begin

with FListaALimento.DMAlimento do
begin
//   dsQNut.DataSet := quNut;
   quNut.Close;
   quNut.SQL.Clear;
   if FOrdenarPor = 0 then
      quNut.SQL.Add( SQLOrdemNome )
   else if FOrdenarPor = 1 then
      quNut.SQL.Add( SQLOrdemPadrao )
   else if FOrdenarPor = 2 then
      quNut.SQL.Add( SQLOrdemUsuario );
   quNut.Open;
end;


end;

