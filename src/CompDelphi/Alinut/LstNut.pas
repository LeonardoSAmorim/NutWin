procedure TListaNutriente.OnOrdenarNutrientePorClick(Sender: TObject);
begin
   FOrdenarPor := FOrdenarNutrientePor.ItemIndex;
   FListaAlimento.DMAlimento.dsUsuario.Dataset.Active := ( FOrdenarNutrientePor.ItemIndex = 2 );
   if ( FOrdenarNutrientePor.ItemIndex = 2 ) then
      FUserName := FListaAlimento.DMAlimento.taUsuario.FieldByName( 'USERNAME' ).AsString
   else
      FUserName := '';
   ExecSQL;
   if Assigned(FOnOrdenarNutrientePorClick) then
      FOnOrdenarNutrientePorClick(Sender);
end;

procedure TListaNutriente.OnTipoDeOrdemClick(Sender: TObject);
begin
   FOrdem := FTipoDeOrdem.ItemIndex;
   ExecSQL;
   if Assigned(FOnTipoDeOrdemClick) then
      FOnTipoDeOrdemClick(Sender);
end;

procedure TListaNutriente.OnAchaPalavraKeyPress(Sender: TObject; var Key: Char);
begin
   if Key = #13 then
      begin
         FPalavra := FAchaPalavra.Text;
         ExecSQL;
      end;
   if Assigned(FOnAchaPalavraKeyPress) then
      FOnAchaPalavraKeyPress(Sender, Key);
end;

procedure TListaNutriente.OnAchaPalavraExit(Sender: TObject);
begin
