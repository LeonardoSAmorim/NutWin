function TListaNutriente.SQLSelectBasico : String;
begin

 Result :=
   'SELECT ' +
   ' NUT.ABREV ,' +
   ' NUT.NOMENUT ,' +
   ' ALINUT.VALOR ,' +
   ' NUT.UNIDADE';
end;

function TListaNutriente.SQLOrdemNome : String;
begin

 Result := SQLSelectBasico +
   ' FROM ' +
   ' ALINUT , ' +
   ' NUT ' +

   ' WHERE ' +
   ' ( ALINUT.IDALI = :IDALI )' +
   ' AND ' +
   ' ( ALINUT.IDNUT = NUT.IDNUT ) ';

 if FPalavra <> '' then
 begin
    if FDoInicio then
       Result := Result + ' AND ( NOMENUT LIKE ''' + FPalavra + '%'' )'
    else
       Result := Result + ' AND ( NOMENUT LIKE ''%' + FPalavra + '%'' )'
 end;

 Result := Result + ' ORDER BY Nut.NOMENUT';

 if FOrdem = 1 then
    Result := Result + ' DESC'
 else
    Result := Result + ' ASC';

end;

function TListaNutriente.SQLOrdemPadrao : String;
begin

 Result := SQLSelectBasico +
   ', Nut.ORDPADRAO ' +

   ' FROM ' +
   ' ALINUT , ' +
   ' NUT ' +

   ' WHERE ' +
   ' ( ALINUT.IDALI = :IDALI )' +
   ' AND ' +
   ' ( ALINUT.IDNUT = NUT.IDNUT ) ';

 if FPalavra <> '' then
 begin
    if FDoInicio then
       Result := Result + ' AND ( NOMENUT LIKE ''' + FPalavra + '%'' )'
    else
       Result := Result + ' AND ( NOMENUT LIKE ''%' + FPalavra + '%'' )'
 end;

 Result := Result + ' ORDER BY NUT.ORDPADRAO';

 if FOrdem = 1 then
    Result := Result + ' DESC'
 else
    Result := Result + ' ASC';

end;

function TListaNutriente.SQLOrdemUsuario : String;
begin

 Result := SQLSelectBasico +
   ',NUTORD.USERNAME ,' +
   ' NUTORD.ORDUSER' +

   ' FROM ' +
   ' ALINUT , ' +
   ' NUT, ' +
   ' NUTORD' +

   ' WHERE ' +
   ' ( NUTORD.USERNAME = ''' + FUserName + ''' )' +
   ' AND ' +
   ' ( ALINUT.IDALI = :IDALI )' +
   ' AND' +
   ' ( ALINUT.IDNUT = NUT.IDNUT ) ';

 if FPalavra <> '' then
 begin
    if FDoInicio then
       Result := Result + ' AND ( NOMENUT LIKE ''' + FPalavra + '%'' )'
    else
       Result := Result + ' AND ( NOMENUT LIKE ''%' + FPalavra + '%'' )'
 end;

 Result := Result + ' ORDER BY NUTORD.ORDUSER';

 if FOrdem = 1 then
    Result := Result + ' DESC'
 else
    Result := Result + ' ASC';

end;

function TListaNutriente.Localizar( Nome : String; Options: TLocateOptions ) : Boolean;
begin
   Result := FListaAlimento.DMAlimento.quNut.Locate( 'NOMENUT', Nome, Options );
end;

