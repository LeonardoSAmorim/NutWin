{ Ativar dados }
procedure TListaAlimento.SetAtivar( Value : Boolean );
begin
   if (csLoading in ComponentState) then
      FAtivar := Value
   else if FAtivar = Value then
   else if not Value then
      begin
         FIDNutriente := '';
         FUserName := '';
         FPalavra := '';
         FDoInicio := False;
         FIDGrupoAlimentar := '';
         FIDOrigem := '';
         FOrdenarPor := 0;
         FOrdem := 0;
         FTextoLocalizar := '';
         if not ( FDMAlimento is TDMAlimento ) then
         if ( FDMAlimento = nil ) then
         with FDMAlimento do
         begin
            dsGruAli.DataSet.Active := False;
            dsOrigem.DataSet.Active := False;
            dsNut.Dataset.Active := False;
            dsUsuario.Dataset.Active := False;

            FListaDeAlimentos.DataSource := nil;
            FGrupoAlimentarAFiltrar.ListSource := nil;
            FNutrienteAOrdenarPorValor.ListSource := nil;
            FUsuario.ListSource := nil;
            OrigemAFiltrar.ListSource := nil;
         end;
         FAtivar := Value;
      end
   else if FUsuario = nil then
      ShowMessage( 'Usuario não definido' )
   else if FFiltrarPorGrupoAlimentar = nil then
      ShowMessage( 'FiltrarPorGrupoAlimentar não definido' )
   else if FGrupoAlimentarAFiltrar = nil then
      ShowMessage( 'GrupoAlimentarAFiltrar não definido' )
   else if FFiltrarPorOrigem = nil then
      ShowMessage( 'FiltrarPorOrigem não definido' )
   else if FOrigemAFiltrar = nil then
      ShowMessage( 'OrigemAFiltrar não definido' )
   else if FAchaPalavra = nil then
      ShowMessage( 'AchaPalavra não definido' )
   else if FAchaDoInicio = nil then
      ShowMessage( 'AchaDoInicio não definido' )
   else if FNutrienteAOrdenarPorValor = nil then
      ShowMessage( 'NutrienteAOrdenarPorValor não definido' )
   else if FOrdenarAlimentoPor = nil then
      ShowMessage( 'OrdenarAlimentoPor não definido' )
   else if FTipoDeOrdem = nil then
      ShowMessage( 'TipoDeOrdem não definido' )
   else if FListaDeAlimentos = nil then
      ShowMessage( 'ListaDeAlimentos não definido' )
   else if FLocalizaTexto = nil then
      ShowMessage( 'LocalizaTexto não definido' )
   else
      begin
         SetEventos;
         FIDNutriente := '';
         FUserName := '';
         FPalavra := FAchaPalavra.Text;
         FDoInicio := FAchaDoInicio.Checked;
         FIDGrupoAlimentar := '';
         FIDOrigem := '';
         FOrdenarPor := FOrdenarAlimentoPor.ItemIndex;
         FOrdem := FTipoDeOrdem.ItemIndex;
         FTextoLocalizar := FLocalizaTexto.Text;
         with FDMAlimento do
         begin
            dsGruAli.DataSet.Active := FFiltrarPorGrupoAlimentar.Checked;
            dsOrigem.DataSet.Active := FFiltrarPorOrigem.Checked;
            dsNut.Dataset.Active := ( FOrdenarAlimentoPor.ItemIndex = 1 );
            dsUsuario.Dataset.Active := ( FOrdenarAlimentoPor.ItemIndex = 3 );

            FListaDeAlimentos.DataSource := dsQAli;
            FGrupoAlimentarAFiltrar.KeyField := 'IDGRUALI';
            FGrupoAlimentarAFiltrar.ListField := 'NOMEGRU';
            FGrupoAlimentarAFiltrar.ListSource := dsGruAli;
            FNutrienteAOrdenarPorValor.KeyField := 'IDNUT';
            FNutrienteAOrdenarPorValor.ListField := 'NOMENUT';
            FNutrienteAOrdenarPorValor.ListSource := dsNut;
            FUsuario.KeyField := 'USERNAME';
            FUsuario.ListField := 'USERNAME';
            FUsuario.ListSource := dsUsuario;
            OrigemAFiltrar.KeyField := 'IDORIG';
            OrigemAFiltrar.ListField := 'DESCRICAO';
            OrigemAFiltrar.ListSource := dsOrigem;
         end;
         ExecSQL;
         Filtrar;
         FAtivar := Value;
      end;
end;

