procedure TListaAlimento.OnOrdenarAlimentoPorClick(Sender: TObject);
begin
   // Provisorio
   if FOrdenarAlimentoPor.ItemIndex = 2 then
      begin
         ShowMessage( 'Ordenar por preço não está disponível!' );
         FOrdenarAlimentoPor.ItemIndex := FOrdenarPor;
      end;

   FOrdenarPor := FOrdenarAlimentoPor.ItemIndex;
   FDMAlimento.dsNut.Dataset.Active := ( FOrdenarAlimentoPor.ItemIndex = 1 );
   FDMAlimento.dsUsuario.Dataset.Active := ( FOrdenarAlimentoPor.ItemIndex = 3 );
   if ( FOrdenarAlimentoPor.ItemIndex = 1 ) then
      FIDNutriente := FDMAlimento.taNut.FieldByName( 'IDNUT' ).AsString
   else
      FIDNutriente:= '';
   if ( FOrdenarAlimentoPor.ItemIndex = 3 ) then
      FUserName := FDMAlimento.taUsuario.FieldByName( 'USERNAME' ).AsString
   else
      FUserName := '';
   ExecSQL;
   if Assigned(FOnOrdenarAlimentoPorClick) then
      FOnOrdenarAlimentoPorClick(Sender);
end;

