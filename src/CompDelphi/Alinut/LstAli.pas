      FOnNutrienteAOrdenarPorValorClick := FNutrienteAOrdenarPorValor.OnCloseUp;
      FOnUsuarioClick := FUsuario.OnCloseUp;
      FOnOrdenarAlimentoPorClick := FOrdenarAlimentoPor.OnClick;
      FOnTipoDeOrdemClick := FTipoDeOrdem.OnClick;
      FOnOrigemAFiltrarClick := FOrigemAFiltrar.OnClick;
      FOnAchaPalavraKeyPress := FAchaPalavra.OnKeyPress;
      FOnAchaPalavraExit := FAchaPalavra.OnExit;
      FOnAchaDoInicioClick := FAchaDoInicio.OnClick;
      FOnFiltrarPorGrupoAlimentarClick := FFiltrarPorGrupoAlimentar.OnClick;
      FOnFiltrarPorOrigemClick := FFiltrarPorOrigem.OnClick;
      FOnLocalizaTextoChange := FLocalizaTexto.OnChange;

      FGrupoAlimentarAFiltrar.OnCloseUp := OnGrupoAlimentarAFiltrarClick;
      FNutrienteAOrdenarPorValor.OnCloseUp := OnNutrienteAOrdenarPorValorClick;
      FUsuario.OnCloseUp := OnUsuarioClick;
      FOrdenarAlimentoPor.OnClick := OnOrdenarAlimentoPorClick;
      FTipoDeOrdem.OnClick := OnTipoDeOrdemClick;
      FOrigemAFiltrar.OnClick := OnOrigemAFiltrarClick;
      FAchaPalavra.OnKeyPress := OnAchaPalavraKeyPress;
      FAchaPalavra.OnExit := OnAchaPalavraExit;
      FAchaDoInicio.OnClick := OnAchaDoInicioClick;
      FFiltrarPorGrupoAlimentar.OnClick := OnFiltrarPorGrupoAlimentarClick;
      FFiltrarPorOrigem.OnClick := OnFiltrarPorOrigemClick;
      FLocalizaTexto.OnChange := OnLocalizaTextoChange;
      FEventosOk := True;
   end;
end;

{ Executa SQL }
procedure TListaAlimento.ExecSQL;
begin

with FDMAlimento do
begin
   dsQAli.DataSet := quAli;
   quAli.Close;
   quAli.SQL.Clear;
   FListaDeAlimentos.Columns[0].Width := 165;
   FListaDeAlimentos.Columns[1].Width := 70;
   if FOrdenarPor = 0 then        // Nome
      begin
         quAli.SQL.Add( SQLNome );
         FListaDeAlimentos.Columns[0].Width := 235;
         FListaDeAlimentos.Columns[1].Width := 0;
      end
   else if FOrdenarPor = 1 then   // Nutrientes
      begin
         quAli.SQL.Add( SQLNutrientes );
         FListaDeAlimentos.Columns[1].Title.Caption := taNut.FieldByName( 'NOMENUT' ).AsString + ' (' +
                                                       taNut.FieldByName( 'UNIDADE' ).AsString + ')';
         FListaDeAlimentos.Columns[1].FieldName := 'VALOR';
      end
   else if FOrdenarPor = 2 then   // Preço
      begin
{         quAli.SQL.Add( SQLPreco );
         FListaDeAlimentos.Columns[1].Title.Caption := 'Preço R$';
         FListaDeAlimentos.Columns[1].FieldName := 'PRECO';   }
      end
   else if FOrdenarPor = 3 then   // Frequência de Uso
      begin
         quAli.SQL.Add( SQLFreqUso );
         FListaDeAlimentos.Columns[1].Title.Caption := 'Freq. de Uso';
         FListaDeAlimentos.Columns[1].FieldName := 'FREQUSO';
      end;
   quAli.Open;
end;


end;

{ Filtra lista conforme os atributos de filtro }
procedure TListaAlimento.Filtrar;
begin
with FDMAlimento do
begin
   dsQAli.DataSet := quAli;
   dsQAli.DataSet.Filtered := False;
   dsQAli.DataSet.Filter := StrFilter;
   dsQAli.DataSet.Filtered := True;
end;
end;

//==============================================================================

Function TListaAlimento.StrFilter : String;
var
   I : Integer;
   sTemp : array [1..2] of String;
begin
   if FIDGrupoAlimentar <> '' then
      sTemp[1] := 'IDGRUALI = ' + '''' + FIDGrupoAlimentar + ''''
   else
      sTemp[1] := '';

   if FIDOrigem <> '' then
      sTemp[2] := 'IDORIG = ' + '''' + FIDOrigem + ''''
   else
      sTemp[2] := '';

   Result := '';
   for I := 1  to 2 do
   begin
      if ( Result <> '' ) and ( sTemp[I] <> '' ) then
         Result := Result + ' and ' + sTemp[I]
      else
         Result := Result + sTemp[I];
   end;

end;

function TListaAlimento.SQLSelectBasico : String;
begin

{ Result :=
   'SELECT ' +
   ' ALIMENTO.IDALI ,' +
   ' ALIMENTO.NOME ,' +
   ' ALIMENTO.NOMESIMP ,' +
   ' ALIMENTO.IDORIG ,' +
   ' ALIMENTO.IDGRUALI ,' +

   ' ALIPRECO.PRECO ,' +
   ' ALIPRECO.DATA'; }

 Result :=
   'SELECT ' +
   ' ALIMENTO.IDALI ,' +
   ' ALIMENTO.NOME ,' +
   ' ALIMENTO.NOMESIMP ,' +
   ' ALIMENTO.IDORIG ,' +
   ' ALIMENTO.IDGRUALI';

end;

function TListaAlimento.SQLNome : String;
begin

{ Result := SQLSelectBasico +
   ' FROM ' +
   ' ALIMENTO,' +
   ' ALIPRECO' +

   ' WHERE ' +
   ' ( ALIMENTO.IDALI = ALIPRECO.IDALI )';  }

 Result := SQLSelectBasico +
   ' FROM ' +
   ' ALIMENTO';

 if FPalavra <> '' then
 begin
    if FDoInicio then
       Result := Result + ' WHERE ( NOME LIKE ''' + FPalavra + '%'' )'
    else
       Result := Result + ' WHERE ( NOME LIKE ''%' + FPalavra + '%'' )'
 end;

 Result := Result + ' ORDER BY ALIMENTO.NOME';

 if FOrdem = 1 then
    Result := Result + ' DESC'
 else
    Result := Result + ' ASC';

end;

