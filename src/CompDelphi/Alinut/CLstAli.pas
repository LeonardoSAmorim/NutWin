procedure TCustomListaAlimento.SetOrdenarAlimentoPor(const Value: TOrdemAlimento);
begin
   FOrdenarAlimentoPor := Value;
   if not Assigned( FIDNutriente ) and not Assigned( FIDUserName ) and ( csLoading in ComponentState ) then
      exit;
    // Provisorio
    if FOrdenarAlimentoPor = oaPreco then
       begin
          ShowMessage( 'Ordenar por preço não está disponível!' );
          exit;
       end;
    FDMListaAlimento.dsNut.Dataset.Active := ( FOrdenarAlimentoPor = oaNutrientes );
    FDMListaAlimento.dsUsuario.Dataset.Active := ( FOrdenarAlimentoPor = oaFrequenciaUso );
    if ( FOrdenarAlimentoPor = oaNutrientes ) then
       FDMListaAlimento.dsNut.DataSet.Active := True
    else
       FDMListaAlimento.dsNut.DataSet.Active := False;
    if ( FOrdenarAlimentoPor = oaFrequenciaUso ) then
       FDMListaAlimento.dsUsuario.DataSet.Active := True
    else
       FDMListaAlimento.dsUsuario.DataSet.Active := False;
    ExecSQL;
end;

