function TCustomListaAlimento.SQLFreqUso : String;
begin
   Result := SQLSelectBasico +
      ',ALIFREQ.UserName ,' +
      ' ALIFREQ.FREQUSO' +
      ' FROM ' +
      ' ALIMENTO ,' +
      ' ALIFREQ' +
      ' WHERE ' +
      ' ( ALIFREQ.UserName = ''' + FDMListaAlimento.dsUsuario.DataSet.FieldByName( 'UserName' ).AsString + ''' )'  +
      ' AND' +
      ' ( ALIMENTO.IDALI = ALIFREQ.IDALI )';
   if FFiltrarNomeAlimento <> '' then
   begin
      if FFiltrarDoInicio then
         Result := Result + ' AND ( UPPER(NOME) LIKE ''' + FFiltrarNomeAlimento + '%'' )'
      else
         Result := Result + ' AND ( UPPER(NOME) LIKE ''%' + FFiltrarNomeAlimento + '%'' )'
   end;
   Result := Result + ' ORDER BY ALIFREQ.FREQUSO';
   if FTipoDeOrdem = toDecrescente then
      Result := Result + ' DESC'
   else
      Result := Result + ' ASC';
end;

