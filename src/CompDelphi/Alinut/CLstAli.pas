procedure TCustomListaAlimento.DataChangeAli(Sender: TObject; Field: TField);
begin
   if Assigned( FAlimentoCorrente ) and (Field = nil) then
   begin
      FAlimentoCorrente.Peso := 100; // 100 gramas
      FAlimentoCorrente.IDAlimento := FDMListaAlimento.dsQAli.DataSet.FieldByName( 'IDALI' ).AsString;
   end;
end;

