procedure TCustomListaAlimento.Notification(AComponent : TComponent; Operation : TOperation);
begin
   inherited Notification(AComponent, Operation);
   if Operation <> opRemove then
      Exit;
   if AComponent = FListaDeAlimentos then
      FListaDeAlimentos := nil
   else if AComponent = FIDGrupoAlimentar then
      FIDGrupoAlimentar := nil
   else if AComponent = FIDOrigem then
      FIDOrigem := nil
   else if AComponent = FIDNutriente then
      FIDNutriente := nil
   else if AComponent = FIDUserName then
      FIDUserName := nil
   else if AComponent = FAlimentoCorrente then
      FAlimentoCorrente := nil
   else if AComponent = FDMListaAlimento then
      FDMListaAlimento := nil
   else if AComponent = FDelayedOpIndicator then
      FDelayedOpIndicator := nil;
end;

constructor TCustomListaAlimento.Create(AOwner: TComponent);
begin
   inherited Create(AOwner);
   Application.CreateForm(TDMListaAlimento,FDMListaAlimento);
   FDMListaAlimento.FreeNotification (self);
   FDMListaAlimento.dsQAli.OnDataChange := DataChangeAli;
end;

destructor TCustomListaAlimento.Destroy;
begin
   if Assigned(FDMListaAlimento) then
      FDMListaAlimento.Free;
   inherited Destroy;
end;

procedure TCustomListaAlimento.Loaded;
begin
    inherited Loaded;
    DM:= FDMListaAlimento;
    with FDMListaAlimento do
    begin
       dsGruAli.DataSet.Active := FFiltrarPorGrupoAlimentar;
       dsOrigem.DataSet.Active := FFiltrarPorOrigem;
       dsNut.Dataset.Active := ( FOrdenarAlimentoPor = oaNutrientes );
       dsUsuario.Dataset.Active := ( FOrdenarAlimentoPor = oaFrequenciaUso );
    end;
    ExecSQL;
    Filtrar;
end;

procedure TCustomListaAlimento.Refresh;
begin
   ExecSQL;
   Filtrar;
   inherited;
end;

{ Executa SQL }
procedure TCustomListaAlimento.ExecSQL;
begin
   with FDMListaAlimento do
   begin
      dsQAli.DataSet := quAli;
      quAli.Close;
      quAli.SQL.Clear;
      if FOrdenarAlimentoPor = oaNome then        // Nome
         begin
            quAli.SQL.Add( SQLNome );
         end
      else if FOrdenarAlimentoPor = oaNutrientes then   // Nutrientes
         begin
            quAli.SQL.Add( SQLNutrientes );
         end
      else if FOrdenarAlimentoPor = oaPreco then   // Preço
         begin
//           quAli.SQL.Add( SQLPreco );
         end
      else if FOrdenarAlimentoPor = oaFrequenciaUso then   // Frequência de Uso
         begin
            quAli.SQL.Add( SQLFreqUso );
         end;
      // indica operação demorada;
      if Assigned( FDelayedOpIndicator ) then
         FDelayedOpIndicator.Start;
      try
         quAli.Open;
      finally
         // finaliza indicação de operação demorada
         if Assigned( FDelayedOpIndicator ) then
            FDelayedOpIndicator.Finish;
      end;
   end;
end;

{ Filtra lista conforme os atributos de filtro }
procedure TCustomListaAlimento.Filtrar;
begin
   with FDMListaAlimento do
   begin
      dsQAli.DataSet := quAli;
      dsQAli.DataSet.Filtered := False;
      dsQAli.DataSet.Filter := StrFilter;
      // indica operação demorada;
      if Assigned( FDelayedOpIndicator ) then
         FDelayedOpIndicator.Start;
      try
         dsQAli.DataSet.Filtered := True;
      finally
         // finaliza indicação de operação demorada
         if Assigned( FDelayedOpIndicator ) then
            FDelayedOpIndicator.Finish;
      end;
   end;
end;

function TCustomListaAlimento.Localizar( Nome : String; Options: TLocateOptions ) : Boolean;
begin
   Result := FDMListaAlimento.quAli.Locate( 'NOME', Nome, Options );
end;

Function TCustomListaAlimento.StrFilter : String;
var
   I : Integer;
   sTemp : array [1..2] of String;
begin
   Result := '';
   if FFiltrarPorGrupoAlimentar then
      sTemp[1] := 'IDGRUALI = ' + '''' + FDMListaAlimento.dsGruAli.DataSet.FieldByName( 'IDGRUALI' ).AsString + ''''
   else
      sTemp[1] := '';
   if FFiltrarPorOrigem then
      sTemp[2] := 'IDORIG = ' + '''' + FDMListaAlimento.dsOrigem.DataSet.FieldByName( 'IDORIG' ).AsString + ''''
   else
      sTemp[2] := '';
   Result := '';
   for I := 1  to 2 do
   begin
      if ( Result <> '' ) and ( sTemp[I] <> '' ) then
         Result := Result + ' and ' + sTemp[I]
      else
         Result := Result + sTemp[I];
   end;
end;

function TCustomListaAlimento.SQLSelectBasico : String;
begin
   Result :=
      'SELECT ' +
      ' ALIMENTO.IDALI ,' +
      ' ALIMENTO.NOME ,' +
      ' ALIMENTO.NOMESIMP ,' +
      ' ALIMENTO.IDORIG ,' +
      ' ALIMENTO.IDGRUALI';
end;

function TCustomListaAlimento.SQLNome : String;
begin
   Result := SQLSelectBasico +
      ' FROM ' +
      ' ALIMENTO';
   if FFiltrarNomeAlimento <> '' then
   begin
       if FFiltrarDoInicio then
          Result := Result + ' WHERE ( UPPER(NOME) LIKE UPPER(''' + FFiltrarNomeAlimento + '%'' ))'
       else
          Result := Result + ' WHERE ( UPPER(NOME) LIKE UPPER(''%' + FFiltrarNomeAlimento + '%'' ))'
   end;
   Result := Result + ' ORDER BY ALIMENTO.NOME';
   if FTipoDeOrdem = toDecrescente then
      Result := Result + ' DESC'
   else
      Result := Result + ' ASC';
end;

function TCustomListaAlimento.SQLNutrientes : String;
begin
   Result := SQLSelectBasico +
      ',ALINUT.IDNUT ,' +
      ' ALINUT.VALOR' +
      ' FROM ' +
      ' ALIMENTO ,' +
      ' ALINUT' +
      ' WHERE ' +
      ' ( ALINUT.IDNUT = ''' + FDMListaAlimento.dsNut.DataSet.FieldByName( 'IDNUT' ).AsString + ''' )'  +
      ' AND' +
      ' ( ALINUT.IDALI = ALIMENTO.IDALI )';
   if FFiltrarNomeAlimento <> '' then
   begin
      if FFiltrarDoInicio then
         Result := Result + ' AND ( UPPER(NOME) LIKE ''' + FFiltrarNomeAlimento + '%'' )'
      else
         Result := Result + ' AND ( UPPER(NOME) LIKE ''%' + FFiltrarNomeAlimento + '%'' )'
   end;
   Result := Result + ' ORDER BY ALINUT.VALOR';
   if FTipoDeOrdem = toDecrescente then
      Result := Result + ' DESC'
   else
      Result := Result + ' ASC';
end;
