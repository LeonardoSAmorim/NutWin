procedure TCustomListaAlimento.DefineDefaults;
begin
   FFiltrarPorGrupoAlimentar := False;
   FFiltrarPorOrigem := False;
   FFiltrarDoInicio := True;
   FTipoDeOrdem := toCrescente;
   FOrdenarAlimentoPor := oaNome;
   FFiltrarNomeAlimento := '';
   FLocalizaNomeAlimento := '';
end;

procedure TCustomListaAlimento.SetDelayedOpIndicator(const Value: TDelayedOpIndicator);
begin
   if Assigned( Value ) then
      Value.FreeNotification(self);
   FDelayedOpIndicator := Value;
end;

//*
function TCustomListaAlimento.PegaSubEP(IDAli: String): String;
begin
    Result := '  ';
    if (IDAli = '') and FDMListaAlimento.quAli.Active then
        IDAli := FDMListaAlimento.quAli.FieldByName( 'IDALI' ).AsString;
    if FDMListaAlimento.taAliGCal.Locate( 'IDALI', IDAli, [] ) then
       Result := 'E'
    else
       Result := ' ';
    if FDMListaAlimento.taAliGProt.Locate( 'IDALI', IDAli, [] ) then
       Result := Result + 'P'
    else
       Result := Result + ' ';
end;

end.


