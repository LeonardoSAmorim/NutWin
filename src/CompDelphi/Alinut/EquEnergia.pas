procedure TEquivalenteEnergia.SetAtivar(const Value: Boolean);
begin
  if not Assigned( FAlimento ) then
     begin
        FAtivar := False;
        exit;
     end   
  else if FAtivar = Value then
  else if Value then
     begin
        FAtivar := Value;
        FAlimento.DMUmAlimento.dsGruEquEnergia.DataSet.Open;
        ExecSQL;
     end
  else
     begin
        FAtivar := Value;
        TQuery( FAlimento.DMUmAlimento.dsAliEquEnergia.Dataset ).Close;
        FAlimento.DMUmAlimento.dsGruEquEnergia.DataSet.Close;
     end;
end;

