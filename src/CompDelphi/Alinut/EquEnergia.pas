procedure TEquivalenteEnergia.ExecSQL;
begin
   if (not Assigned( FAlimento )) or (not FAtivar) then
      exit;
   if (not Assigned (FAlimento.DMUmAlimento)) or
      (not Assigned (FAlimento.DMUmAlimento.dsAliEquEnergia)) or
      (not Assigned (FAlimento.DMUmAlimento.dsAliEquEnergia.Dataset)) then
      exit;

{   if Assigned(FAlimento) then
   begin
      if FAlimento.DMUmAlimento.taAlimento.Locate( 'IDALI', FAlimento.IDAlimento,[] ) then
         FPeso := FAlimento.Peso
      else
         FPeso := 0;
   end; }

   with TQuery( FAlimento.DMUmAlimento.dsAliEquEnergia.Dataset ) do
   begin
      Close;
{      SQL.Clear;
      if OrdenarEquivalentePor = oeAlimento then
         SQL.Add( SQLOrdemNome )
      else if OrdenarEquivalentePor = oeMedida then
         SQL.Add( SQLOrdemMedida );
}      // indica operação demorada;
      if Assigned( FDelayedOpIndicator ) then
         FDelayedOpIndicator.Start;
      try
         Open;
      finally
         // finaliza indicação de operação demorada
         if Assigned( FDelayedOpIndicator ) then
            FDelayedOpIndicator.Finish;
      end;
   end;
end;

