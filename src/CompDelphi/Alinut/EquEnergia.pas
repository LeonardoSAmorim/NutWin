function TEquivalenteEnergia.SQLOrdemMedida: String;
begin
 Result := SQLSelectBasico +
   ' FROM ' +
   'MEDIDAS, ' +
   'ALIGCAL, ' +
   'ALIMENTO ' +

   ' WHERE (ALIGCAL.IDMEDCAS = MEDIDAS.IDMEDCAS) AND ' +
   ' (ALIGCAL.IDGRUCAL = :IDGRUCAL ) AND ' +
   ' (ALIGCAL.IDALI = ALIMENTO.IDALI ) ';

 if FFiltrarNomeAlimento <> '' then
 begin
    if FFiltrarDoInicio then
       Result := Result + ' AND ( UPPER(NOME) LIKE UPPER(''' + FFiltrarNomeAlimento + '%'' ))'
    else
       Result := Result + ' AND ( UPPER(NOME) LIKE UPPER(''%' + FFiltrarNomeAlimento + '%'' ))'
 end;

 Result := Result + ' ORDER BY ALIMENTO.NOME';

 if FTipoDeOrdem = toDecrescente then
    Result := Result + ' DESC'
 else
    Result := Result + ' ASC';

end;

