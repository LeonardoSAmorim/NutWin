function TListaMedida.SQLSelectBasico : String;
begin

 Result :=
   'SELECT ' +
   ' MEDIDACASEIRA.IDMEDCAS ,' +
   ' MEDIDAS.MEDIDA ,' +
   ' MEDIDACASEIRA.VALOR ';

   end;

function TListaMedida.SQLOrdemNome : String;
begin

 Result := SQLSelectBasico +
   ' FROM ' +
   ' MEDIDAS , ' +
   ' MEDIDACASEIRA ' +

   ' WHERE ' +
   ' ( MEDIDACASEIRA.IDALI = :IDALI )' +
   ' AND ' +
   ' ( MEDIDACASEIRA.IDMEDCAS = MEDIDAS.IDMEDCAS ) ';

 if FPalavra <> '' then
 begin
    if FDoInicio then
       Result := Result + ' AND ( MEDIDA LIKE ''' + FPalavra + '%'' )'
    else
       Result := Result + ' AND ( MEDIDA LIKE ''%' + FPalavra + '%'' )'
 end;

 Result := Result + ' ORDER BY Medidas.MEDIDA';

 if FOrdem = 1 then
    Result := Result + ' DESC'
 else
    Result := Result + ' ASC';

end;

function TListaMedida.SQLOrdemUsuario : String;
begin

 Result := SQLSelectBasico +
   ' FROM ' +
   ' MEDIDAS , ' +
   ' MEDIDACASEIRA ' +

   ' WHERE ' +
   ' ( MEDIDACASEIRA.IDALI = :IDALI )' +
   ' AND ' +
   ' ( MEDIDACASEIRA.IDMEDCAS = Medidas.IDMEDCAS ) ';

 if FPalavra <> '' then
 begin
    if FDoInicio then
       Result := Result + ' AND ( MEDIDA LIKE ''' + FPalavra + '%'' )'
    else
       Result := Result + ' AND ( MEDIDA LIKE ''%' + FPalavra + '%'' )'
 end;

end;

function TListaMedida.Localizar( Nome : String; Options: TLocateOptions ) : Boolean;
begin
   Result := FListaAlimento.DMAlimento.quMed.Locate( 'MEDIDA', Nome, Options );
end;

