end;

procedure TListaMedida.OnLocalizaTextoChange(Sender: TObject);
begin
   FTextoLocalizar := FLocalizaTexto.Text;
   Localizar( FTextoLocalizar, [loPartialKey] );
   if Assigned(FOnLocalizaTextoChange) then
      FOnLocalizaTextoChange(Sender);
end;

procedure TListaMedida.OnQuantidadeChange(Sender: TObject);
