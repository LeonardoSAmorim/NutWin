{ Ativar dados }
procedure TListaMedida.SetAtivar( Value : Boolean );
begin

   // Ativar e Desativar conforme lista de Alimentos
   if (csLoading in ComponentState) then
      FAtivar := Value
   else if Value = FAtivar then
   else if FListaAlimento = nil then
      ShowMessage( 'Lista de Alimentos não definida' )
   else if not Value then
      begin
         ListaAlimento.DMAlimento.dsQMed.DataSet.Close;
         FAtivar := Value;
      end
   else if FAchaPalavra = nil then
      ShowMessage( 'AchaPalavra não definido' )
   else if FAchaDoInicio = nil then
      ShowMessage( 'AchaDoInicio não definido' )
   else if FOrdenarMedidaPor = nil then
      ShowMessage( 'OrdenarMedidaPor não definido' )
   else if FTipoDeOrdem = nil then
      ShowMessage( 'TipoDeOrdem não definido' )
   else if FQuantidade = nil then
      ShowMessage( 'Quantidade não definido' )
   else if FPesoTotal = nil then
      ShowMessage( 'PesoTotal não definido' )
   else
      begin
         SetEventos;

         FUserName := FListaAlimento.Usuario.Text;
         FPalavra := FAchaPalavra.Text;
         FDoInicio := FAchaDoInicio.Checked;
         FOrdenarPor := FOrdenarMedidaPor.ItemIndex;
         FOrdem := FTipoDeOrdem.ItemIndex;
         FTextoLocalizar := FLocalizaTexto.Text;
         FListaAlimento.DMAlimento.QtdeMedida := FQuantidade;
         FPesoTotal.DataSource := FListaAlimento.DMAlimento.dsQMed;
         FPesoTotal.DataField := 'PESOTOTAL';
         FPeso := FPesoTotal.Text;

//         ListaAlimento.DMAlimento.dsQNut.DataSet := ListaAlimento.DMAlimento.quNut;
         FListaMedida.DataSource := FListaAlimento.DMAlimento.dsQMed;

         ExecSQL;
         FAtivar := Value;
      end;
end;

