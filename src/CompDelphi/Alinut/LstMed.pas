        FOnAchaPalavraKeyPress := FAchaPalavra.OnKeyPress;
        FAchaPalavra.OnKeyPress := OnAchaPalavraKeyPress;
        FOnAchaPalavraExit := FAchaPalavra.OnExit;
        FAchaPalavra.OnExit := OnAchaPalavraExit;
        FOnAchaDoInicioClick := FAchaDoInicio.OnClick;
        FAchaDoInicio.OnClick := OnAchaDoInicioClick;
        FOnLocalizaTextoChange := FLocalizaTexto.OnChange;
        FLocalizaTexto.OnChange := OnLocalizaTextoChange;
        FOnQuantidadeChange := FQuantidade.OnChange;
        FQuantidade.OnChange := OnQuantidadeChange;
        FEventosOk := True;
     end;
end;

{ Executa SQL }
procedure TListaMedida.ExecSQL;
begin

with FListaALimento.DMAlimento do
begin
//   dsQMed.DataSet := quMed;
   quMed.Close;
   quMed.SQL.Clear;
   if FOrdenarPor = 0 then
      quMed.SQL.Add( SQLOrdemNome )
   else if FOrdenarPor = 1 then
      quMed.SQL.Add( SQLOrdemUsuario );
   quMed.Open;
end;


end;

