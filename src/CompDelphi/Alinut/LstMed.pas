procedure TListaMedida.OnOrdenarMedidaPorClick(Sender: TObject);
begin
   FOrdenarPor := FOrdenarMedidaPor.ItemIndex;
   ExecSQL;
   if Assigned(FOnOrdenarMedidaPorClick) then
      FOnOrdenarMedidaPorClick(Sender);
end;

