      FOnTipoDeOrdemClick(Sender);
end;

procedure TListaMedida.OnAchaPalavraKeyPress(Sender: TObject; var Key: Char);
begin
   if Key = #13 then
      begin
         FPalavra := FAchaPalavra.Text;
         ExecSQL;
      end;
   if Assigned(FOnAchaPalavraKeyPress) then
      FOnAchaPalavraKeyPress(Sender, Key);
end;

procedure TListaMedida.OnAchaPalavraExit(Sender: TObject);
