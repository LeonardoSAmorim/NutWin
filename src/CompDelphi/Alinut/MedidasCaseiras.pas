function TMedidasCaseiras.TemMedidaCaseira: Boolean;
begin
   Result := not FAlimento.DMUmAlimento.quMed.IsEmpty;
end;

procedure TMedidasCaseiras.SetAtivar(const Value: Boolean);
begin
  if not Assigned( FAlimento ) then
     begin
        FAtivar := False;
        exit;
     end
  else if FAtivar = Value then
  else if Value then
     begin
        FAtivar := Value;
        ExecSQL;
     end
  else
     begin
        FAtivar := Value;
        FALimento.DMUmAlimento.dsQMed.DataSet.Close;
     end;
end;

procedure TMedidasCaseiras.SetOrigemQtdeMedidaPor(
  const Value: TOrigemQtdeMedida);
begin
  if not Assigned( FValorQtdeMedida ) then
//     FOrigemQtdeMedidaPor := qmNenhuma
  else
     with FValorQtdeMedida do
     begin
        if Value = qmNenhuma then
           begin
              Descricao := '';
              ValorNumerico := '0';
              Unidade := '';
           end
        else if Value = qmUsuario then
           begin
              Descricao := 'Quantidade';
              ValorNumerico := '1';
              Unidade := '';
           end
        else if Value = qmPesoAlimento then
           begin
              Descricao := 'Peso';
              ValorNumerico := '100';
              Unidade := 'g';
           end
        else if Value = qmNutriente then
           begin
              Descricao := 'Nutriente';
              ValorNumerico := '0';
              Unidade := 'Und';
           end;
        ExecSQL;
     end;
     FOrigemQtdeMedidaPor := Value;
     ExecSQL;
end;

