function TMedidasCaseiras.SQLSelectBasico : String;
begin

 Result :=
   'SELECT ' +
   ' MEDIDACASEIRA.IDMEDCAS, ' +
   ' MEDIDAS.MEDIDA, ' +
   ' MEDIDACASEIRA.VALOR, ' +
   ' MEDIDACASEIRA.ORDPADRAO ';

  if not Assigned( FValorQtdeMedida ) then
     exit;   
   with FValorQtdeMedida do
   begin
      if FOrigemQtdeMedidaPor = qmUsuario then
         begin
            Result := Result + ', ' + ValorNumerico + 'QTDEMEDIDA, ' +
                                      ValorNumerico + ' * MEDIDACASEIRA.VALOR PESOTOTAL';
         end
      else if FOrigemQtdeMedidaPor = qmPesoAlimento then
         begin
            Result := Result +  ', ' + ValorNumerico + ' / MEDIDACASEIRA.VALOR QTDEMEDIDA, ' +
                                       ValorNumerico + ' PESOTOTAL';
         end
      else if FOrigemQtdeMedidaPor = qmNutriente then
         begin
            Result := Result +  ', ' + ValorNumerico + 'QTDEMEDIDA, ' +
                                       ValorNumerico + ' * MEDIDACASEIRA.VALOR PESOTOTAL';
         end;
   end;

end;

function TMedidasCaseiras.SQLOrdemNome : String;
begin

 Result := SQLSelectBasico +
   ' FROM ' +
   ' MEDIDAS , ' +
   ' MEDIDACASEIRA ' +

   ' WHERE ' +
   ' ( MEDIDACASEIRA.IDALI = :IDALI )' + // ''' + FAlimento.IDAlimento + ''')' +
   ' AND ' +
   ' ( MEDIDACASEIRA.IDMEDCAS = MEDIDAS.IDMEDCAS ) ';

 if FFiltrarNomeMedida <> '' then
 begin
    if FFiltrarDoInicio then
       Result := Result + ' AND ( UPPER(MEDIDA) LIKE UPPER(''' + FFiltrarNomeMedida + '%'' ))'
    else
       Result := Result + ' AND ( UPPER(MEDIDA) LIKE UPPER(''%' + FFiltrarNomeMedida + '%'' ))'
 end;

 Result := Result + ' ORDER BY MEDIDAS.MEDIDA';

 if FTipoDeOrdem = toDecrescente then
    Result := Result + ' DESC'
 else
    Result := Result + ' ASC';

end;

function TMedidasCaseiras.SQLOrdemUsuario : String;
begin

 Result := SQLSelectBasico +
   ' FROM ' +
   ' MEDIDAS , ' +
   ' MEDIDACASEIRA ' +

   ' WHERE ' +
   ' ( MEDIDACASEIRA.IDALI = :IDALI )' + // ''' + FAlimento.IDAlimento + ''')' +
   ' AND ' +
   ' ( MEDIDACASEIRA.IDMEDCAS = MEDIDAS.IDMEDCAS ) ';

 if FFiltrarNomeMedida <> '' then
 begin
    if FFiltrarDoInicio then
       Result := Result + ' AND ( UPPER(MEDIDA) LIKE UPPER(''' + FFiltrarNomeMedida + '%'' ))'
    else
       Result := Result + ' AND ( UPPER(MEDIDA) LIKE UPPER(''%' + FFiltrarNomeMedida + '%'' ))'
 end;

 Result := Result + ' ORDER BY MEDIDACASEIRA.ORDPADRAO';

 if FTipoDeOrdem = toDecrescente then
    Result := Result + ' DESC'
 else
    Result := Result + ' ASC';

end;

