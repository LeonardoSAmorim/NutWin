{ Executa SQL }
procedure TMedidasCaseiras.ExecSQL;
begin
   if not Assigned( FAlimento ) or not FAtivar then
      exit;
   with FALimento.DMUmAlimento do
   begin
      dsQMed.DataSet := quMed;
      quMed.Close;
      quMed.SQL.Clear;
      if FOrdenarMedidaPor = omNome then
         quMed.SQL.Add( SQLOrdemNome )
      else if FOrdenarMedidaPor = omPreferenciaUser then
         quMed.SQL.Add( SQLOrdemUsuario );
      // indica operação demorada;
      if Assigned( FDelayedOpIndicator ) then
         FDelayedOpIndicator.Start;
      try
         quMed.Open;
      finally
         // finaliza indicação de operação demorada
         if Assigned( FDelayedOpIndicator ) then
            FDelayedOpIndicator.Finish;
      end;
   end;
end;

