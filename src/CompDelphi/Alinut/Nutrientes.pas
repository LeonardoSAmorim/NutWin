}

{ Executa SQL }
procedure TNutrientes.ExecSQL;
begin

if not Assigned( FAlimento ) or not FAtivar then
   exit;

with FAlimento.DMUmAlimento do
begin
   dsQNut.DataSet := quNut;
   quNut.Close;
   quNut.SQL.Clear;
   if FOrdenarNutrientePor = onNome then
      quNut.SQL.Add( SQLOrdemNome )
   else if FOrdenarNutrientePor = onPadrao then
      quNut.SQL.Add( SQLOrdemPadrao )
   else if FOrdenarNutrientePor = onPreferenciaUser then
      quNut.SQL.Add( SQLOrdemUsuario );
   // indica operação demorada;
   if Assigned( FDelayedOpIndicator ) then
      FDelayedOpIndicator.Start;
   try
      quNut.Open;
   finally
      // finaliza indicação de operação demorada
      if Assigned( FDelayedOpIndicator ) then
         FDelayedOpIndicator.Finish;
   end;
end;

end;

