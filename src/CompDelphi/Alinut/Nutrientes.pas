function TNutrientes.SQLSelectBasico : String;
begin

 Result :=
   'SELECT ' +
   ' NUT.ABREV ,' +
   ' NUT.NOMENUT ,' +
   ' ALINUT.VALOR ,' +
   ' NUT.UNIDADE';
end;

function TNutrientes.SQLOrdemNome : String;
begin

 Result := SQLSelectBasico +
   ' FROM ' +
   ' ALINUT , ' +
   ' NUT ' +

   ' WHERE ' +
   ' ( ALINUT.IDALI = :IDALI )' +
   ' AND ' +
   ' ( ALINUT.IDNUT = NUT.IDNUT ) ';

 // Mostra nutriente visivel se not FVerTudo
 Result := Result + SQLVerNutrientes;

 if FFiltrarNomeNutriente <> '' then
 begin
    if FFiltrarDoInicio then
       Result := Result + ' AND ( UPPER(NOMENUT) LIKE UPPER(''' + FFiltrarNomeNutriente + '%'' ))'
    else
       Result := Result + ' AND ( UPPER(NOMENUT) LIKE UPPER(''%' + FFiltrarNomeNutriente + '%'' ))'
 end;

 Result := Result + ' ORDER BY Nut.NOMENUT';

 if FTipoDeOrdem = toDecrescente then
    Result := Result + ' DESC'
 else
    Result := Result + ' ASC';

end;

function TNutrientes.SQLOrdemPadrao : String;
begin

 Result := SQLSelectBasico +
   ', Nut.ORDPADRAO ' +

   ' FROM ' +
   ' ALINUT , ' +
   ' NUT ' +

   ' WHERE ' +
   ' ( ALINUT.IDALI = :IDALI )' +
   ' AND ' +
   ' ( ALINUT.IDNUT = NUT.IDNUT ) ';

 // Mostra nutriente visivel se not FVerTudo
 Result := Result + SQLVerNutrientes;

 if FFiltrarNomeNutriente <> '' then
 begin
    if FFiltrarDoInicio then
       Result := Result + ' AND ( UPPER(NOMENUT) LIKE UPPER(''' + FFiltrarNomeNutriente + '%'' ))'
    else
       Result := Result + ' AND ( UPPER(NOMENUT) LIKE UPPER(''%' + FFiltrarNomeNutriente + '%'' ))'
 end;

 Result := Result + ' ORDER BY NUT.ORDPADRAO';

 if FTipoDeOrdem = toDecrescente then
    Result := Result + ' DESC'
 else
    Result := Result + ' ASC';

end;

function TNutrientes.SQLOrdemUsuario : String;
begin

 Result := SQLSelectBasico +
   ',NUTORD.USERNAME ,' +
   ' NUTORD.ORDUSER' +

   ' FROM ' +
   ' ALINUT , ' +
   ' NUT, ' +
   ' NUTORD' +

   ' WHERE ' +
   ' ( NUTORD.USERNAME = ''' + FIDUserName.DataSet.FieldByName( 'USERNAME' ).AsString + ''' )' +
   ' AND ' +
   ' ( ALINUT.IDALI = :IDALI )' +
   ' AND' +
   ' ( ALINUT.IDNUT = NUT.IDNUT ) ';

 // Mostra nutriente visivel se not FVerTudo
 Result := Result + SQLVerNutrientes;

 if FFiltrarNomeNutriente <> '' then
 begin
    if FFiltrarDoInicio then
       Result := Result + ' AND ( UPPER(NOMENUT) LIKE UPPER''' + FFiltrarNomeNutriente + '%'' ))'
    else
       Result := Result + ' AND ( UPPER(NOMENUT) LIKE UPPER(''%' + FFiltrarNomeNutriente + '%'' ))'
 end;

 Result := Result + ' ORDER BY NUTORD.ORDUSER';

 if FTipoDeOrdem = toDecrescente then
    Result := Result + ' DESC'
 else
    Result := Result + ' ASC';

end;

