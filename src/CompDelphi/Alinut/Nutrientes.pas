procedure TNutrientes.SetAtivar(const Value: Boolean);
begin
  if not Assigned( FAlimento ) then
     begin
        FAtivar := False;
        exit;
     end
  else if FAtivar = Value then
  else if Value then
     begin
        FAtivar := Value;
        ExecSQL;
     end
  else
     begin
        FAtivar := Value;
        FAlimento.DMUmAlimento.dsQNut.DataSet.Close;
     end;
end;

