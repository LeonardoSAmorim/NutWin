package Persistencia;

{$R *.RES}
{$R '..\persistencia\PersistentCollection.dcr'}
{$R '..\persistencia\ObjectNavigator.dcr'}
{$R '..\persistencia\PersComp.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $00400000}
{$IMPLICITBUILD OFF}

requires
  VCL40,
  VCLX40,
  VCLDB40,
  VCLSMP40,
  BASICOS,
  Conectores,
  dcldb40,
  VCLMID40;

contains
  MapFieldReg in '..\persistencia\MapFieldReg.pas' {Form1},
  PersistentCollectionReg in '..\persistencia\PersistentCollectionReg.pas',
  PersistentCollection in '..\persistencia\PersistentCollection.pas',
  ObjectNavigator in '..\persistencia\ObjectNavigator.pas',
  MapPersistent in '..\persistencia\MapPersistent.pas',
  DDLControl in '..\DDLControl\DDLControl.pas',
  CompFactExcept in '..\persistencia\CompFactExcept.pas',
  EditUpdQrys in '..\persistencia\EditUpdQrys.pas' {UpObjForm},
  PersComp in '..\persistencia\PersComp.pas',
  SQLGeneration in '..\Generations\SQLGeneration\SQLGeneration.pas',
  MapBinding in '..\PERSISTENCIA\MapBinding.pas',
  ItemLists in '..\PERSISTENCIA\ItemLists.pas',
  AssociacaoAgregacao in '..\PERSISTENCIA\AssociacaoAgregacao.pas',
  Edx02 in '..\PERSISTENCIA\Edx02.pas' {FrmMapDialog02},
  DefDDL02 in '..\PERSISTENCIA\DefDDL02.pas' {FrmDefDDL02},
  DefFields02 in '..\PERSISTENCIA\DefFields02.pas' {FrmDefFields02};

end.
