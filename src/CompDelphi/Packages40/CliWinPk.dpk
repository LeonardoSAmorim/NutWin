package CliWinPk;

{$R *.RES}
{$R '..\..\componentes\delphi\calendar97\DtReg97.dcr'}
{$R '..\..\Componentes\Delphi\DiskInfo\DiskInfo.dcr'}
{$R '..\..\Componentes\Delphi\Backup\backup.dcr'}
{$ALIGN ON}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $00400000}
{$DESCRIPTION 'Componentes do CliWin'}
{$IMPLICITBUILD OFF}

requires
  vcl40,
  VCLX40,
  VCLDB40;

contains
  DtReg97 in '..\..\Componentes\Delphi\Calendar97\DtReg97.pas',
  DiskInfo in '..\..\Componentes\Delphi\DiskInfo\DiskInfo.pas',
  LZRW1KH in '..\..\Componentes\Delphi\Backup\Lzrw1kh.pas',
  backup in '..\..\Componentes\Delphi\Backup\backup.pas';

end.
