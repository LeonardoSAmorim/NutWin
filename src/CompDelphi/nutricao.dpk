{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Package dos Componentes de Nutricao'}
{$IMPLICITBUILD ON}

requires
  FREEWARE,
  Dic,
  BASICOS,
  VCLX50,
  VCLJPG50,
