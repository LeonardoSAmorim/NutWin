procedure TCNSFuncionario.CarregaFuncionario;
var
   e : EFuncionario;
begin
   with DataSource.Dataset as TQuery do
   begin
      close;
      sql.clear;
      sql.add('select * from funcionario where pis = :pis');
      ParamByName('pis').AsString := pis;
      Open;
      if Eof then
         begin
         // não achou
         e := EFuncionario.CreateFmt('A1011 - Não foi encontrado funcionário com este pis - %s'
                                      ,[pis]);
         e.CodErro := 1011;
         CanUpdate := false;
         raise e;
         end
      else
         begin
         // achouuu !
         nome := Fieldbyname('nomefunc').asString;
         //verifica se esta hilitado e seta a property
         if Fieldbyname('habilitado').asString = 'S' then
            habilitado := True
         else
            habilitado := False;
         pis := FieldByName('Pis').asString;
         DatCad :=FieldByName('Dt_Cad').AsDateTime;
         CanUpdate := True;
         end;
   end;
   NotifyLinks(self, lRefreshViewer);
end;

procedure TCNSFuncionario.Carregar(P1, P2, P3, P4 : String);
var
   e : EFuncionario;
begin
   with DataSource.Dataset as TQuery do
   begin
      close;
      sql.clear;
      sql.add('select * from funcionario where pis = :pis');
      ParamByName('pis').AsString := P1;
      Open;
      if Eof then
         begin
            // não achou
            e := EFuncionario.CreateFmt('A1011 - Não foi encontrado funcionário com este pis - %s'
                                         ,[pis]);
            e.CodErro := 1011;
            CanUpdate := False;
            Nome := '';
            Habilitado := True;
            Pis := '';
            DatCad := now;
            raise e;
         end
      else
         begin
           // achouuu !
            Nome := Fieldbyname('nomefunc').asString;
            if Fieldbyname('habilitado').asString = 'S' then
               habilitado := True
            else
               habilitado := False;
            Pis := FieldByName('Pis').asString;
            DatCad :=FieldByName('Dt_Cad').AsDateTime;
            CanUpdate := True;
         end;
   end;
   NotifyLinks(self, lRefreshViewer);
end;

function TCNSFuncionario.Excluir : shortint;
var
   e : EFuncionario;
begin
   with DataSource.Dataset as TQuery do
   begin
      close;
      sql.clear;
      sql.add('DELETE funcionario ');
      sql.add(' WHERE pis = :pis');
      ParamByName('pis').AsString := Pis;
      try
         ExecSQL;
         if assigned(Log) then
            Log.InsereLog('DLFU');
      except
         on h2 : EDBEngineError do
            begin
            e := EFuncionario.CreateFmt('E0024 - Erro ao excluir funcionário - %s '+ h2.message,[pis]);
            e.CodErro := 24;
            raise e;
            end;
         on h1 : EDatabaseError do
            begin
            e := EFuncionario.CreateFmt('E0024 - Erro ao excluir funcionário - %s '+ h1.message,[pis]);
            e.CodErro := 24;
            raise e;
            end;
      end;
   end;
end;


function TCNSFuncionario.Inserir : shortint;
var
   e : EFuncionario;
begin
   with DataSource.Dataset as TQuery do
   begin
      close;
      sql.clear;
      sql.add('insert into funcionario (pis,habilitado,Dt_Cad,NomeFunc) ');
      sql.add('values(:pis,''S'',:DT_Cad,:NomeFunc)');
      ParamByName('Dt_Cad').AsDateTime := now;
      ParamByName('pis').AsString := Pis;
      ParamByName('NomeFunc').AsString := Nome;
      try
         ExecSQL;
         Log.InsereLog('INFU');
      except
         on h2 : EDBEngineError do
            begin
            e := EFuncionario.CreateFmt('E0023 - Erro ao inserir funcionário - %s '+ h2.message,[pis]);
            e.CodErro := 23;
            raise e;
            end;
         on h1 : EDatabaseError do
            begin
            e := EFuncionario.CreateFmt('E0023 - Erro ao inserir funcionário - %s '+ h1.message,[pis]);
            e.CodErro := 23;
            raise e;
            end;
      end;
   end;
end;

procedure TCNSFuncionario.Atualizar;
var
   e : EFuncionario;
begin
   if assigned(DataSource) and assigned(DataSource.Dataset) then
   begin
      with DataSource.Dataset as TQuery do
      begin
         close;
         sql.clear;
         if not CanUpdate then
         begin
            Sql.add('insert into funcionario ( pis, habilitado,  Dt_Cad,  NomeFunc) ');
            Sql.add('values                  (:pis,:habilitado, :DT_Cad, :NomeFunc)');
            CanUpdate := True;
         end else
         begin
            sql.add(' UPDATE  funcionario   SET Habilitado = :Habilitado, DT_Cad = :DT_Cad, NomeFunc = :NomeFunc');
            sql.add(' where pis = :pis');
            CanUpdate := True;
         end;
         //Dispara a notificacao para pedir as prop
         NotifyLinks(self, lUpDate);
         ParamByName('Dt_Cad').AsDateTime := DatCad;
         ParamByName('pis').AsString := Pis;
         ParamByName('NomeFunc').AsString := Nome;
         if Habilitado then
            ParamByName('Habilitado').AsString := 'S'
         else
            ParamByName('Habilitado').AsString := 'N';
         try
            ExecSQL;
            Log.InsereLog('INFU');
         except
            on h2 : EDBEngineError do
               begin
               e := EFuncionario.CreateFmt('E0023 - Erro ao inserir funcionário - %s '+ h2.message,[pis]);
               e.CodErro := 23;
               raise e;
               end;
            on h1 : EDatabaseError do
               begin
               e := EFuncionario.CreateFmt('E0023 - Erro ao inserir funcionário - %s '+ h1.message,[pis]);
               e.CodErro := 23;
               raise e;
               end;
         end;
      end;
   end;
end;

