procedure TCNSFuncionario.ListaFuncionarios(Lista : TStrings);
var
   e : EFuncionario;
   i : integer;
begin
   if assigned(DataSource) and assigned(DataSource.Dataset) then
   begin
      with (DataSource.DataSet)  as TQuery do
      begin
         Lista.Clear;
         close;
         sql.clear;
         sql.add('select * from Funcionario order by NomeFunc');
         try
            Open;
            first;
            while not Eof do
            begin
               Lista.Add(FieldByName('NomeFunc').AsString);
               next;
            end;
         except
            on h1 : EDatabaseError do
               begin
                  e := EFuncionario.Create('E0022 - Erro ao ler dados do Funcionario -  '+ h1.message);
                  e.CodErro := 9;
                  raise e;
               end;
            on h2 : EDBEngineError do
               begin
                  e := EFuncionario.Create('E0022 - Erro ao ler dados do Funcioanrio - %s '+ h2.message);
                  e.CodErro := 9;
                  raise e;
               end;
         end;
      end;
   end;
end;


