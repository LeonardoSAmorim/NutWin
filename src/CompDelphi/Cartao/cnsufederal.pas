{ Recupera descricao a partir do codigo }
procedure TCNSUF.Carregar(P1, P2, P3, P4 : String);
var
   i : integer;
begin
   if CarregarPor = pSiglaUF then
   begin
      i := 1;
      while (P1 <> string(ArraySigla[i])) and (i < 28) do inc(i);
   end else
   begin
      i := 1;
      while (P1 <> string(ArrayCodUF[i])) and (i < 28) do inc(i);
   end;
   {
      O array tem uma posicao a mais para indicar que nao achou o
      estado. Pelo fato de ter que comparar em duas variaves nao
      nao coloquei a inicializacao da variaveis no inicio, porque
      senao eu teria de colocar um if a mais no final do loop.
   }
   FCodUF := string(ArrayCodUf[i]);
   FDescricao := string(ArrayDescricao[i]);
   FSigla := string(ArraySigla[i]);
   NotifyLinks(Self, LLoad);
end;

{ Verifica se codigo e valido }
function TCNSUF.Validar : Boolean;
begin
     if CarregarPor = pSiglaUF then
     begin
        Carregar(sigla,'','','');
     end else
     begin
        Carregar(codUF,'','','');
     end;
     if descricao <> '' then
          result := true
     else
          result := false;
end;

