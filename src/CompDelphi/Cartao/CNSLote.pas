function TCNSLote.ObterTotalLinhas : integer;
begin
   Result := 0;
   if assigned(DataSource) and assigned(DataSource.Dataset) then
   begin
      with DataSource.Dataset as TQuery do
      begin
         close;
         sql.clear;
         sql.add('select count(Num_Lote) TotalLinhas  from Usuario where Num_Lote = :xNum_lote');
         ParamByName('xNum_lote').AsInteger := FLote;
         Open;
         Result :=  FieldByName('TotalLinhas').AsInteger;
         close;
      end;
   end;
end;

