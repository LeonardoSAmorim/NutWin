procedure TCNSLote.AbrirLote(Value : String);

begin
   FLote := StrtoInt(Value);
   CarregarLote(FLote);
end;

procedure TCNSLote.CarregarLote(NumLote : integer);
begin
   if assigned(DataSource) and assigned(DataSource.Dataset) then
   begin
      with DataSource.Dataset as TQuery do
      begin
         close;
         sql.clear;
         sql.add('select * from Lote where Num_Lote = :xNumLote');
         ParamByName('xNumLote').AsFloat := NumLote;
         Open;
         if not eof then
         begin
             FLote := FieldByName('Num_Lote').AsInteger;
             FDataAbertura := FieldByName('Dt_Abertura').AsDateTime;
             FStatus := FieldByName('st_Lote').AsString;
             FDataEnvioDatasus := FieldByName('DT_Envio_DATASUS').AsDateTime;
             FDataGeracao := FieldByName('DT_Geracao').AsDateTime;
             FDataRecebimentoPIS := FieldByName('DT_RecebCom').AsDateTime;
             FDataEmissao := FieldByName('DT_Emissao').AsDateTime;
             FTotalLinhas := FieldByName('Tot_Linhas').AsInteger;
             FTotalDocs := FieldByName('Tot_Docs').AsInteger;
             FPisDigitador := FieldByName('PIS_Criador').AsString;
//             FPisReDigitador := FieldByName('PIS_ReDigitador').AsString;
             FCanUpdate := True;
            if (FStatus <> 'ABERTO') AND (FStatus <> 'FECERRO') then
               // if (FStatus = 'FECHADO') OR (FStatus = 'EMITIDO') then
               ShowMessage('LOTE NAO PODE SER ALTERADO QUANDO JA FOI ' +  FStatus);
         end else
             begin
                FLote := 0;
                FDataAbertura := (now);
                FTotalLinhas := 0;
                FTotalDocs := 0;
                FStatus := 'ABERTO ';
                if assigned(FUserLogado) then
                   FPisDigitador := FUserLogado.PIS
                else
                   begin
                    FErroLote := ELote.Create('Associe na propriedade do lote o username');
                    raise FErroLote;
                    FErroLote.free;
                   end;
                FPisReDigitador := '          ';
                FCanUpdate := False;
             end;
         if (not FCanUpdate) or (FStatus = 'FECERRO') then
            // esta reabrindo um lote fechado com erro para ser corrigido
            FStatus := 'ABERTO ';
      end;
   end;
end;

