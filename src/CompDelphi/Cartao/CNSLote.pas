function TCNSLote.ListaLotesGeral : TStrings;
var
   i : integer;
begin
    Result := TStringList.Create;
    for i := 0 to CHKListaLotes.items.count - 1 do
        if CHKListaLotes.checked[i] then
           Result.Add(string(copy(CHKListaLotes.items[i],1 ,5)));
end;

function TCNSLote.ListaLotesPeriodo(xDataInicial, xDataFinal : TDate; xStatus : string): TStrings;
begin
   Result := TStringList.Create;
   if assigned(DataSource) and assigned(DataSource.Dataset) then
   begin
      with DataSource.Dataset as TQuery do
      begin
         close;
         sql.clear;

         if xStatus = 'FechadoEnviado' then
         begin
            sql.add('select Num_Lote From Lote where (St_lote = ''FECHADO'' or ST_Lote = ''ENVIADO'') ');
            sql.add('and DT_Fechamento >= :DataInicial and DT_Fechamento <= :DataFinal');
         end else
         begin
            sql.add('select Num_Lote From Lote where St_lote = :Status  ');
            sql.add('and DT_Fechamento >= :DataInicial and DT_Fechamento <= :DataFinal');
            ParamByName('Status').AsString := xStatus;
         end;
         ParamByName('DataInicial').AsDate := xDataInicial;
         ParamByName('DataFinal').AsDate := xDataFinal;
         // tratar status
         Open;
         Result.Clear;
         while not eof do
         begin
            Result.add(fieldbyname('Num_lote').asstring);
            next;
         end;
      end;
   end;
end;

function TCNSLote.ListaLotesStatus(xStatus : string) : TStrings;
begin
   Result := TStringList.Create;
   if assigned(DataSource) and assigned(DataSource.Dataset) then
   begin
      with DataSource.Dataset as TQuery do
      begin
         close;
         sql.clear;
         sql.add('select Num_Lote From Lote where St_lote = :Status');
         ParamByName('Status').AsString := xStatus;
         Open;
         Result.Clear;
         while not eof do
         begin
             Result.add(fieldbyname('Num_lote').asstring);
             next;
         end;
      end;
   end;
end;
