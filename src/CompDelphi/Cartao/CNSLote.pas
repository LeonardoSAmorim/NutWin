procedure TCNSLote.Atualizar;
begin
      with DataSource.Dataset as TQuery do
      begin
         if ((not CanUpdate) or ((CanUpdate) and (FTotalDocs >= ObterTotalDocs))) then
         begin
            close;
            sql.clear;
           { if (FStatus <> 'ABERTO') OR (FStatus <> 'FECERRO') then
            begin
               ShowMessage('LOTE NAO PODE SER ALTERADO QUANDO JA FOI ' +  FStatus);
            end else}
            begin
               if not FCanUpdate then
                 begin
                  sql.add('INSERT INTO Lote (Num_Lote,   Dt_Abertura,   st_Lote,   Dt_Envio_DATASUS,   Dt_Geracao,   DT_RecebCom,      Dt_Emissao,   Tot_Linhas,   Tot_Docs,   PIS_Criador)');
                  sql.add('VALUES           (:xNum_Lote, :xDt_Abertura, :xst_Lote, :xDt_Envio_DATASUS, :xDt_Geracao, :xDT_RecebComPIS, :xDt_Emissao, :xTot_Linhas, :xTot_Docs, :xPIS_Criador)');
                  FCanUpdate := True;
                 end
               else
                 begin
                  sql.add(' UPDATE  Lote   SET Dt_Abertura = :xDt_Abertura, st_Lote = :xst_Lote,');
                  sql.add(' Dt_Envio_DATASUS = :xDt_Envio_DATASUS, Dt_Geracao = :xDt_Geracao, DT_RecebCom = :xDT_RecebComPIS,  Dt_Emissao = :xDt_Emissao, Tot_Linhas = :xTot_Linhas, Tot_Docs = :xTot_Docs, PIS_Criador = :xPIS_Criador');
                  sql.add(' where Num_Lote = :xNum_Lote');
                  FCanUpdate := True;
                end;
               NotifyLinks(self, lRefreshControl);
               ParamByName('xNum_Lote').AsFloat := FLote;
               ParamByName('xDt_Abertura').AsDate := FDataAbertura;
               ParamByName('xst_Lote').AsString := FStatus;
               ParamByName('xDT_Envio_DATASUS').AsDate := FDataEnvioDatasus;
               ParamByName('xDT_Geracao').AsDate := FDataGeracao;
               ParamByName('xDT_RecebComPIS').AsDate := FDataRecebimentoPIS;
               ParamByName('xDT_Emissao').AsDate := FDataEmissao;
               ParamByName('xTot_Linhas').AsInteger := FTotalLinhas;
               ParamByName('xTot_Docs').AsInteger := FTotalDocs;
               ParamByName('xPis_Criador').AsString := FPisDigitador;
//             ParamByName('xPIS_ReDigitador').AsString := FPisReDigitador;
               try
                  CNSDataBase.StartTransaction;
                  ExecSql;
                  CNSDataBase.Commit;
               except
                  on h2 : EDBEngineError do
                     begin
                     ShowMessage('E0021 - Erro ao Atualizar Lote - ' + IntToStr(lote));
                     CNSDataBase.RollBack;
                     end;
                  on h1 : EDatabaseError do
                     begin
                     ShowMessage('E0021 - Erro ao Atualizar Lote - ' + IntToStr(lote));
                     CNSDatabase.RollBack;
                     end;
               end;
            end;
         end;
      end;
end;

procedure TCNSLote.FecharLote;
// Fecha lote indicando quando estiver com erro na digitacao ou redigitacao
begin
   if (ErroDigitacao) then
      FStatus := 'FECERRO'
   else
      if FTotalDocs = ObterTotalDocs then
         FStatus := 'FECHADO'
      else
         FStatus := 'FECERRO';

   FTotalLinhas := ObterTotalLinhas;

   with DataSource.Dataset as TQuery do
      begin
        close;
        sql.clear;
        sql.add(' UPDATE  Lote   SET  st_Lote = :xst_Lote');
        sql.add(' where Num_Lote = :xNum_Lote');
        ParamByName('xNum_Lote').AsFloat := FLote;
        ParamByName('xst_Lote').AsString := FStatus;
        try
           CNSDataBase.StartTransaction;
           ExecSql;
           CNSDataBase.Commit;
        except
           on h2 : EDBEngineError do
              begin
              ShowMessage('E0021 - Erro ao Fechar Lote - ' + IntToStr(lote));
              CNSDataBase.RollBack;
              end;
           on h1 : EDatabaseError do
              begin
              ShowMessage('E0021 - Erro ao Fechar Lote - ' + IntToStr(lote));
              CNSDatabase.RollBack;
              end;
        end;
     end;
//
//    Zerar propriedade NUMERO DO LOTE do componente99
//
   FLote := 0;

   //Atualizar;
end;

procedure TCNSLote.ST_Atualizar(xStLote: string; xlista: tstrings);
var
//  queryant : TStrings;
  i : integer;
begin
   with DataSource.Dataset as TQuery do
   begin
      sql.clear;
      sql.add(' UPDATE Lote SET st_Lote = '+ ''''+xStLote+'''' );
      sql.add(' where num_lote in ( ' + xlista[0]);
      if xlista.count > 1 then
            for i:=1 to xlista.count-1 do
                      sql.add( ',' + xlista[i]);
      sql.add(  ' )' );

      try
        CNSDataBase.StartTransaction;
        ExecSql;
        CNSDataBase.Commit;
      except
           on h2 : EDBEngineError do
                   begin
                        ShowMessage('E0021 - Erro ao Atualizar Lote - ' + IntToStr(lote));
                        CNSDataBase.RollBack;
                      end;
           on h1 : EDatabaseError do
                   begin
                      ShowMessage('E0021 - Erro ao Atualizar Lote - ' + IntToStr(lote));
                      CNSDatabase.RollBack;
                   end;
           //end;
      end;
   end;
end;
