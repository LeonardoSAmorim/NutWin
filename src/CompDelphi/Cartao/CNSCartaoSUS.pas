         NotifyLinks(Self, LUpdate);
         close;
         sql.clear;
         sql.add('delete cartao ');
         sql.add('where Num_Controle = :Num_Controle');

         ParamByName('Num_Controle').asString := Usuario.Num_Controle;

         ExecSql;

         NotifyLinks(Self, LUpdate);
      end;
   end;
end;

