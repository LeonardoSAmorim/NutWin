procedure TCNSUsuario.Excluir;
var
   e : EUsuario;
begin
     if assigned(DataSource) and assigned(DataSource.Dataset) then
        begin
           CNSDatabase.StartTransaction;
           try
              Cartao.Excluir;
           except
             on h2 : EDBEngineError do
                begin
                CNSDatabase.RollBack;
                e := EUsuario.Create('EXXXX - Erro ao Excluir cartao - ');
                e.coderro := 1;   // não achou
                raise e;
                end;
             on h1 : EDatabaseError do
                begin
                CNSDatabase.RollBack;
                e := EUsuario.Create('EXXXX - Erro ao Excluir cartao - ');
                e.coderro := 1;   // não achou
                raise e;
                end;
           end;

           with (DataSource.DataSet) as TQuery do
           begin
              NotifyLinks(Self, LUpdate);
              close;
              sql.clear;
              sql.add('delete usuario ');
              sql.add('where NOME_LONGO = :Nome and ');
              sql.add('Num_Lote = :Num_Lote and Num_Ficha = :Num_Ficha');

              ParamByName('Nome').asString       := Nome_Longo;
              ParamByName('Num_Lote').asInteger  := Num_Lote;
              ParamByName('Num_Ficha').asInteger := Num_Ficha;

              NotifyLinks(Self, LUpdate);

              try
                 ExecSQL;
              except
                 on h2 : EDBEngineError do
                    begin
                    CNSDatabase.RollBack;
                    e := EUsuario.Create('EXXXX - Erro ao Excluir usuario - ');
                    e.coderro := 1;   // não achou
                    raise e;
                    end;
                 on h1 : EDatabaseError do
                    begin
                    CNSDatabase.RollBack;
                    e := EUsuario.Create('EXXXX - Erro ao Excluir usuario - ');
                    e.coderro := 1;   // não achou
                    raise e;
                    end;
              end;
           end;
           CNSDatabase.Commit;
        end;
end;


