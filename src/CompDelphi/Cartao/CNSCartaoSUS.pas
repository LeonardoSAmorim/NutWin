procedure TCNSCartaoSUS.Alterar;
var
   e : ECartaoSUS;
begin
   if assigned(DataSource) and assigned(DataSource.Dataset) then
   begin
      with (DataSource.DataSet) as TQuery do
      begin
         NotifyLinks(Self, LUpdate);
         close;
         sql.clear;
         sql.add('update cartao set ');
         sql.add('nome_logradouro = :nome_logradouro,');
         sql.add('num_logradouro = :num_logradouro,');
         sql.add('compl_logradouro = :compl_logradouro,');
         sql.add('bairro = :bairro,');
         sql.add('CEP = :CEP,');
         sql.add('cod_IBGE = :codmun,');
         sql.add('SIGLA_UF = :uf');
         sql.add('where Num_Controle = :Num_Controle');

         ParamByName('nome_logradouro').AsString := NomeLogradouro;
         ParamByname('num_logradouro').asString := NumeroLogradouro;
         ParamByname('compl_logradouro').asString := CompLogradouro;
         ParamByname('bairro').asString := BairroLogradouro;
         ParamByname('cep').asString := CEP;

         if assigned(Municipio) then
            begin
               ParamByname('codmun').asString := Municipio.CodIBGE;
               if assigned(Municipio.UF) then
                  ParamByname('uf').asString := Municipio.UF.Sigla
               else
                  MessageDlg('E necessario setar UF.', mtError, [mbOK],0);
            end
         else
            MessageDlg('E necessario setar Municipio.', mtError, [mbOK],0);

         ParamByName('Num_Controle').asString := Usuario.Num_Controle;

         NotifyLinks(Self, LUpdate);

         try
            CNSDatabase.StartTransaction;
            ExecSQL;
            CNSDatabase.Commit;
         except
            on h2 : EDBEngineError do
               begin
               CNSDatabase.RollBack;
               e := ECartaoSUS.Create('EXXXX - Erro ao Alterar cartão - ');
               e.coderro := 1;   // não achou
               raise e;
               end;
            on h1 : EDatabaseError do
               begin
               CNSDatabase.RollBack;
               e := ECartaoSUS.Create('EXXXX - Erro ao Alterar cartão - ');
               e.coderro := 1;   // não achou
               raise e;
               end;
         end;
      end;
   end;
end;


procedure ImprimeCartao(nomemun,uf,codmun, nome, pis : string; nasc : TDateTime;
  fundo : boolean);
begin
   if fundo then
      formbechara.QRImage1.Enabled := true
   else
      formbechara.QRImage1.Enabled := false;

   begin
         formbechara.QRLNomeMun.Caption := nomemun+'-'+uf;
         formbechara.QRLNome.Caption := nome;
         formbechara.QRLData.Caption := datetostr(nasc);
         formbechara.QRLNum.Caption := pis;
         formbechara.QRLMun.Caption := codmun;

         formbechara.QRBarcodigo.Text := '010789436390000790'+pis+'00'+codmun;
         formbechara.qrcartao.Print;
//         formbechara.qrcartao.Preview;
   end;

end;


procedure TCNSCartaoSUS.Imprimir(fundo : boolean);
begin

   begin
      if Municipio <> nil then
         ImprimeCartao(Municipio.Descricao,
                      municipio.UF.Sigla,
                     municipio.CodIBGE, usuario.Nome_Longo, pis,
                     usuario.Dt_Nascimento,
                     fundo);

   end;

end;

