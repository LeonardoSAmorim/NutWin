procedure TCNSCartaoSUS.Carregar(P1, P2, P3, P4 : String);
     { Internal declarations for method }
     { type }
     { . . . }
var
   e : ECartaoSUS;
begin
   PIS:=P1;
   with (DataSource.DataSet)  as TQuery do
   begin
      close;
      sql.clear;
      sql.add('select * from cartao where pis = :pis');
      ParamByName('pis').AsString := PIS;
      Open;
      if Eof then
      begin  // nao achou
         e := ECartaoSUS.CreateFMT('1011 - Nao foi encontrado cartao com este pis - %s',[PIS]);
         e.coderro := 1;   // não achou
         raise e;
      end else
      begin //achou!
         Usuario.Pis := PIS;
         Num_Controle := Fieldbyname('Num_Controle').asString;
         NomeLogradouro := Fieldbyname('nome_logradouro').asString;
         NumeroLogradouro := Fieldbyname('num_logradouro').asString;
         CompLogradouro := Fieldbyname('compl_logradouro').asString;
         BairroLogradouro := Fieldbyname('bairro').asString;
         // carrega municipio
         CEP               := Fieldbyname('cep').asString;
         // carrega uf
         if assigned(Municipio) then
         begin
            Municipio.CodIBGE := Fieldbyname('cod_ibge').asString;
            if assigned(Municipio.UF) then
               Municipio.Uf.Sigla := Fieldbyname('sigla_uf').asString
            else
               MessageDlg('E necessario setar UF.', mtError, [mbOK],0);
         end else
            MessageDlg('E necessario setar Municipio.', mtError, [mbOK],0);

         DDD               := Fieldbyname('ddd').asString;
         Telefone          := Fieldbyname('telefone').asString;
         DataAviso         := Fieldbyname('dt_aviso_datasus').AsDateTime;
         NumeroVia         := Fieldbyname('num_via').AsInteger;
         DataEmissao       := Fieldbyname('dt_emissao').AsDateTime;
         Situacao          := Fieldbyname('status_cartao').AsString;
         NotifyLinks(Self, LLoad);

{nao carrega usuario
         if assigned(Usuario) then
            Usuario.Carregar(PIS, '', '', '')
         else
            MessageDlg('E necessario setar Usuario.', mtError, [mbOK],0);
}
         if assigned(Municipio) then
            Municipio.Carregar(Municipio.CodIBGE,'','','')
         else
            MessageDlg('E necessario setar Municipio.', mtError, [mbOK],0);
      end;
   end;
end;

procedure TCNSCartaoSUS.Novo;
begin
   Num_Controle              := '';
   NomeLogradouro            := '';
   NumeroLogradouro          := '';
   CompLogradouro            := '';
   BairroLogradouro          := '';
   CEP                       := '';
   if assigned(FUsuario) then
      Usuario.Novo
   else
      MessageDlg('E necessario setar Usuario.', mtError, [mbOK],0);


   if assigned(Municipio) then
      Municipio.CodIBGE := ''
   else
      MessageDlg('E necessario setar Municipio.', mtError, [mbOK],0);
   DDD                       := '';
   Telefone                  := '';
   DataAviso                 := date;
   NumeroVia                 := 0;
   DataEmissao               := date;
   Situacao                  := '';
   NotifyLinks(Self, lRefreshViewer);
   if assigned(Municipio) then
      Municipio.Carregar(Municipio.CodIBGE,'','','');
   CanUpdate := False;
end;


procedure TCNSCartaoSUS.Atualizar;
var
   e : ECartaoSUS;
begin
   if assigned(DataSource) and assigned(DataSource.Dataset) then
   begin
      with DataSource.Dataset as TQuery do
      begin
         pis := usuario.pis;
         num_controle := usuario.num_controle;
         close;
         sql.clear;
         sql.add('insert into cartao (num_controle,pis,nome_logradouro,num_logradouro,compl_logradouro,bairro,cod_IBGE,CEP,sigla_UF,DDD,telefone,dt_aviso_datasus,num_via,dt_emissao,status_cartao ) ');
         sql.add('values(:num_controle,:pis,:nome,:numero,:comp,:bairro,:codmun,:cep,:uf,:ddd,:telefone,:dt_aviso,:num_via,:dt_emissao,:status)');
         NotifyLinks(Self, LUpdate);
         ParamByName('num_controle').AsString := Num_Controle;
         ParamByName('pis').AsString := Pis;
         ParamByName('nome').AsString := NomeLogradouro;
         ParamByname('numero').asString := NumeroLogradouro;
         ParamByname('comp').asString := CompLogradouro;
         ParamByname('bairro').asString := BairroLogradouro;
         ParamByname('cep').asString := CEP;
         if assigned(Municipio) then
            begin
               ParamByname('codmun').asString := Municipio.CodIBGE;
               if assigned(Municipio.UF) then
                  ParamByname('uf').asString := Municipio.UF.Sigla
               else
                  MessageDlg('E necessario setar UF.', mtError, [mbOK],0);
            end
         else
            MessageDlg('E necessario setar Municipio.', mtError, [mbOK],0);

         ParamByname('ddd').asString := DDD;
         ParamByname('telefone').asString := Telefone ;
         ParamByname('dt_aviso').AsDateTime := DataAviso;
         ParamByname('num_via').AsInteger := NumeroVia;
         ParamByname('dt_emissao').AsDateTime := DataEmissao;
         ParamByname('status').AsString := Situacao;
         try
//            CNSDatabase.StartTransaction;
            ExecSQL;
//            CNSDatabase.Commit;
         except
            on h2 : EDBEngineError do
               begin
               ShowMessage('E0021 - Erro ao Atualizar cartao - '+pis+' '+ h2.message);
//               CNSDatabase.RollBack;
               end;
            on h1 : EDatabaseError do
               begin
               ShowMessage('E0021 - Erro ao Atualizar cartao - '+pis+' '+ h1.message);
//               CNSDatabase.RollBack;
               end;
         end;
      end;
   end;
end;

