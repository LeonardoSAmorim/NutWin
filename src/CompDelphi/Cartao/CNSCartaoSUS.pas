procedure TCNSUsuario.Carregar(P1, P2, P3, P4: String);
var
   e : EUsuario;
begin
   if assigned(DataSource) and assigned(DataSource.Dataset) then
   begin
      PIS:=P1;
      with (DataSource.DataSet)  as TQuery do
      begin
         close;
         sql.clear;
         if P1 <> '' then
            begin
               sql.add('select * from usuario where pis = :pis');
               ParamByName('pis').AsString := PIS;
            end
         else
            begin
               sql.add('select * from usuario ');
               sql.add('where Nome_longo = :Nome ');
               sql.add('and Num_Lote = :Lote and Num_Ficha = :Ficha');
               ParamByName('Nome').AsString := P2;
               ParamByName('Lote').AsString := P3;
               ParamByName('Ficha').AsString := P4;
            end;
         Open;
         if Eof then
         begin  // nao achou
            e := EUsuario.CreateFMT('1011 - Nao foi encontrado usuario com este pis - %s',[PIS]);
            e.coderro := 1;   // não achou
            CanUpdate := False;
            raise e;
         end else
         begin //achou!
           // carrega usuario
            CanUpdate := True;
            PIS             := Fieldbyname('Pis').asString;
            Num_Controle    := Fieldbyname('Num_Controle').asString;
            PISouRIC        := Fieldbyname('RICouPIS').asString;
            Dt_censo        := Fieldbyname('Dt_censo').asDateTime;
            Pis_Ag_Censo    := Fieldbyname('Pis_Agente_Censo').asString;
            Num_Lote        := Fieldbyname('Num_Lote').asInteger;
            Num_Ficha       := Fieldbyname('Num_Ficha').asInteger;
            Marca_Excluido  := Fieldbyname('Marca_Excluido').asString;
            Nome_Fonet      := Fieldbyname('Nome_Fonet').asString;
            Nome_Longo      := Fieldbyname('Nome_Longo').asString;
            Nome_Mae        := Fieldbyname('Nome_Mae').asString;
            Dt_Nascimento   := Fieldbyname('Dt_Nascimento').asDateTime;
            Sexo            := Fieldbyname('Sexo').asString;

          if assigned(Cartao) then
          begin
              Cartao.Pis := pis;
              Cartao.Num_COntrole  := Num_Controle;
          end
            else
               MessageDlg('E necessario setar cartao.', mtError, [mbOK],0);



            if assigned(Municipio) then
               begin
                  Municipio.CodIBGE := Fieldbyname('Cod_IBGE_Nascimento').asString;
                  if assigned(Municipio.UF) then
                     Municipio.UF.Sigla := Fieldbyname('UF_Nascimento').AsString
                  else
                     MessageDlg('E necessario setar UF.', mtError, [mbOK],0);
               end
            else
               MessageDlg('E necessario setar Municipio.', mtError, [mbOK],0);
            Dt_Cad          := Fieldbyname('Dt_Cadastramento').asDateTime;
            Dt_Alt          := Fieldbyname('Dt_Alteracao').asDateTime;
            Pis_FuncAlt     := Fieldbyname('Pis_FuncionarioAlterou').asString;
            if ( Fieldbyname('Tipo_Certidao').asString <> '' ) then
               Tipo_Certidao   := Fieldbyname('Tipo_Certidao').asString
            else
               Tipo_Certidao   := '';
            Nome_Cart       := Fieldbyname('Nome_Cartorio').asString;
            Livro_Cert      := Fieldbyname('Livro_Certidao').asString;
            Folha_Cert      := Fieldbyname('Folha_Certidao').asString;
            Termo_Cert      := Fieldbyname('Termo_Certidao').asString;
            Dt_Emissao_Cert := Fieldbyname('Dt_Emissao_Certidao').asDateTime;

            Tipo_Identidade:= Fieldbyname('Tipo_Identidade').asString;
            Num_Ident         := Fieldbyname('Num_Identidade').asString;
            Sigla_Uf_Emissora := Fieldbyname('Sigla_Uf_Emissora_Ident').asString;
            Dt_Emissao_Ident  := Fieldbyname('Dt_Emissao_Ident').asDateTime;
            Dt_Chegada        := Fieldbyname('Dt_Chegada').asDateTime;
            Nacionalidade     := Fieldbyname('Nacionalidade').asString;
            NotifyLinks(Self, LLoad);

           if assigned(Cartao) then
              Cartao.Carregar(PIS, '', '', '')
            else
               MessageDlg('E necessario setar cartao.', mtError, [mbOK],0);


            if assigned(Municipio) then
               Municipio.Carregar(Municipio.CodIBGE,'','','')
            else
               MessageDlg('E necessario setar Municipio.', mtError, [mbOK],0);
         end;
      end;
   end;
end;

procedure TCNSUsuario.Atualizar;
var
   e : EUsuario;
begin
   if assigned(DataSource) and assigned(DataSource.Dataset) then
   begin
      with (DataSource.DataSet)  as TQuery do
      begin
         NotifyLinks(Self, LUpdate);
         close;
         sql.clear;
         sql.add('insert into usuario (pis, Num_Controle, RICouPIS, Dt_censo,');
         sql.add('Pis_Agente_Censo, Num_Lote, Num_Ficha, Marca_Excluido,');
         sql.add('Nome_Fonet, Nome_Longo, Nome_Mae, Dt_Nascimento,');
         sql.add('Cod_IBGE_Nascimento, UF_Nascimento, Sexo,');

         sql.add('Dt_Cadastramento, Dt_Alteracao, Pis_FuncionarioAlterou,');
         sql.add('Tipo_Certidao, Nome_Cartorio,');
         sql.add('Livro_Certidao, Folha_Certidao, Termo_Certidao, Dt_Emissao_Certidao,');
         sql.add('Tipo_Identidade, Num_Identidade, Sigla_Uf_Emissora_Ident,');
         sql.add('Dt_Emissao_Ident, Dt_Chegada, Nacionalidade)');

         sql.add('values(:pis,:Num_Controle,:PISouRIC,:Dt_censo,:Pis_Ag_Censo,');
         sql.add(':Num_Lote,:Num_Ficha,:Marca_Excluido,:Nome_Fonet,:Nome_Longo,');
         sql.add(':Nome_Mae,:Dt_Nascimento,:Cod_IBGE_Nascimento,:Uf_Nascimento,');
         sql.add(':Sexo,:Dt_Cad,:Dt_Alt,:Pis_FuncAlt,:Tipo_Certidao,:Nome_Cart,');
         sql.add(':Livro_Cert,:Folha_Cert,:Termo_Cert,:Dt_Emissao_Cert,');
         sql.add(':Tipo_Identidade,:Num_Ident,:Sigla_Uf_Emissora,');
         sql.add(':Dt_Emissao_Ident,:Dt_Chegada,:Nacionalidade)');

         ParamByName('pis').AsString               := Pis;
         ParamByName('Num_Controle').asString      := Num_Controle;
         ParamByName('PISouRIC').asString          := PISouRIC;
         ParamByName('Dt_censo').asDateTime        := Dt_censo;
         ParamByName('Pis_Ag_Censo').asString      := Pis_Ag_Censo;
         ParamByName('Num_Lote').asInteger         := Num_Lote;
         ParamByName('Num_Ficha').asInteger        := Num_Ficha;
         ParamByName('Marca_Excluido').asString    := Marca_Excluido;
         ParamByName('Nome_Fonet').asString        := Nome_Fonet;
         ParamByName('Nome_Longo').asString        := Nome_Longo;
         ParamByName('Nome_Mae').asString          := Nome_Mae;
         ParamByName('Dt_Nascimento').asDateTime   := Dt_Nascimento;
         if assigned(Municipio) then
            begin
               ParamByName('Cod_IBGE_Nascimento').asString := Municipio.CodIBGE;
               if assigned(Municipio.UF) then
                  ParamByName('Uf_Nascimento').asString := Municipio.UF.Sigla
               else
                  MessageDlg('E necessario setar UF.', mtError, [mbOK],0);
            end
         else
            MessageDlg('E necessario setar Municipio.', mtError, [mbOK],0);

         ParamByName('Sexo').asString              := Sexo;
         ParamByName('Dt_Cad').asDateTime          := Dt_Cad;
         ParamByName('Dt_Alt').asDateTime          := Dt_Alt;
         ParamByName('Pis_FuncAlt').asString       := Pis_FuncAlt;

         ParamByName('Tipo_Certidao').asString     := Tipo_Certidao;

         ParamByName('Nome_Cart').asString         := Nome_Cart;
         ParamByName('Livro_Cert').asString        := Livro_Cert;
         ParamByName('Folha_Cert').asString        := Folha_Cert;
         ParamByName('Termo_Cert').asString        := Termo_Cert;
         ParamByName('Dt_Emissao_Cert').asDateTime := Dt_Emissao_Cert;

         ParamByName('Tipo_Identidade').asString   := Tipo_Identidade;
         ParamByName('Num_Ident').asString         := Num_Ident;
         ParamByName('Sigla_Uf_Emissora').asString := Sigla_Uf_Emissora;
         ParamByName('Dt_Emissao_Ident').asDateTime:= Dt_Emissao_Ident;
         ParamByName('Dt_Chegada').asDateTime      := Dt_Chegada;
         ParamByName('Nacionalidade').asString     := Nacionalidade;
         NotifyLinks(Self, LUpdate);
         try
            CNSDatabase.StartTransaction;
            ExecSQL;
            cartao.Atualizar;
            CNSDatabase.Commit;
         except
            on h2 : EDBEngineError do
               begin
               CNSDatabase.RollBack;
               e := EUsuario.Create('E0021 - Erro ao Atualizar usuario - ');
               e.coderro := 1;   // não achou
               raise e;
               end;
            on h1 : EDatabaseError do
               begin
               CNSDatabase.RollBack;
               e := EUsuario.Create('E0021 - Erro ao Atualizar usuario - ');
               e.coderro := 1;   // não achou
               raise e;
               end;
         end;
      end;
   end;
end;
