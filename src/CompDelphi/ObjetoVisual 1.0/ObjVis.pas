procedure TCorpo.SelecionaPontosCalculo( ListaParametros: TStringList);
var
   i : integer;
begin
   // Limpa lista de areas de click
   PontosCalculo.Clear;
   for i := 0 to ListaParametros.Count - 1 do
       if PontosSensiveisDoCorpo.IndexOf (ListaParametros.Strings[i]) > -1 then
          PontosCalculo.Add( ListaParametros.Strings[i] );
end;

procedure TCorpo.ListaPontosSensiveis(var Pontos: TStringList);
begin
   Pontos.Clear;
   // Com a lista de parametros das formulas escolhidas, preenche lista de areas
   // do corpo humano
   with FDMOV.taMedCorpo do
   begin
      Filtered := False;
      Filter := 'CORPO = ' + '''' + FNomeObjetoVisual + '''' ;
      Filtered := True;
      First;
      while not EOF do
      begin
         Pontos.Add(FieldByName ('PSENSIVEL').AsString);
         Next;
      end;
   end;
end;

