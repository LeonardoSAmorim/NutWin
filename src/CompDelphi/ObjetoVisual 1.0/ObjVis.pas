constructor TCorpo.Create(AOwner: TComponent);
begin
   inherited Create(AOwner);
   { Cria DataModule para persistencia dos objetos }
   Application.CreateForm(TDMOV, FDMOV);
   if FDMOV = nil then ShowMessage( 'Nao criou DataModule');
      FActive := False;
   FPontosSensiveisPorFace := TStringList.Create;
   FPontosSensiveisDoCorpo := TStringList.Create;
   FPontosCalculo:= TStringList.Create;
end;

destructor TCorpo.Destroy;
begin
   { Libera memoria de todos os objetos criados }
   FActive := False;
//   FDMOV.Free;
   FPontosSensiveisPorFace.Free;
   FPontosSensiveisDoCorpo.Free;
   FPontosCalculo.Free;
   inherited Destroy;
end;

procedure TCorpo.GetVista(var NovaVista: TImage);
begin
   with FDMOV.taVista do
   begin
      Filter := 'OBJETO = ' + '''' + FNomeObjetoVisual + '''' +
                ' AND OVORDEM = ' + IntToStr( FVistaCorrente );
      Filtered := True;
      if not EOF then
         NovaVista.Picture.Assign(FieldByName( 'OVPICTURE' ));
   end;
end;

procedure TCorpo.Loaded;
begin
   inherited Loaded;
   DM := FDMOV;
end;

procedure TCorpo.SetActive(Value: Boolean);
begin
   { Conecta banco de dados e abre tabelas }
   if (csLoading in ComponentState) then
      begin
         FActive := Value;
         exit;
      end;
   if not Assigned (FDMOV) then
      exit;
   if FActive <> Value then
   begin
      FActive:=Value;
      if Value then
         begin
//            if FDMOV.dbOV.AliasName = '' then
//               FDMOV.dbOV.AliasName := FDataSourceName;
            FDMOV.Active:=True;
            with FDMOV.taObjVis do
            begin
               if Locate( 'OBJETO', FNomeObjetoVisual, [loCaseInsensitive] ) then
               begin
                  FVistaInicial := FieldByName( 'VISTAINICIAL' ).AsInteger;
                  FVistaCorrente := FieldByName( 'VISTAINICIAL' ).AsInteger;
                  FTotalVistas := FieldByName( 'TOTALVISTAS' ).AsInteger;
               end
               else
               begin
                  ShowMessage('Nome de Objeto Visual inválido.');
               end;
            end;
            ListaPontosSensiveis (FPontosSensiveisDoCorpo);
         end
         else
         begin
            FDMOV.Active := False;
            FActive := False;
         end;
   end;
end;

procedure TCorpo.SetDataSourceName(Value: String);
begin
    FDataSourceName := Value;
//    if FDMOV.dbOV = nil then exit;
    SetActive( False );
end;

procedure TCorpo.SetNomeObjetoVisual(Value: String);
