   FTime := TTimer.Create(self);
   FTime.Enabled := False;
   FTime.Interval := 0;
   FTime.OnTimer := OnTime;
   { Cria image para as vistas }
   FVista := TImage.Create(self);
   FVista.Align := alClient;
