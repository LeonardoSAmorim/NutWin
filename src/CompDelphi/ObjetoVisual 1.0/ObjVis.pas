{
function TCorpoHumano.GetFaixaEtaria: TFasesDoCorpo;
var
   Idade : TIdade;
begin
   FFaixaEtaria := Inerte;
   if Assigned (FEssencia) then
   begin
      FEssencia.Refresh;
      Idade:=FEssencia.IdadeAsIdade;
      if not Idade.Empty then
      begin
         if FFaixaIdoso.Has(Idade) then
            FFaixaEtaria := Idoso;
         if FFaixaAdulto.Has(Idade) then
            FFaixaEtaria := Adulto;
         if FFaixaPuberdade.Has(Idade) then
            FFaixaEtaria := Puber;
         if FFaixaSegundaInfancia.Has(Idade) then
            FFaixaEtaria := SegInfancia;
         if FFaixaPrimeiraInfancia.Has(Idade) then
            FFaixaEtaria := PrimInfancia;
         if FFaixaRecemNascido.Has(Idade) then
            FFaixaEtaria := RNasc;
      end;
   end;
   Result := FFaixaEtaria;
end;
}
