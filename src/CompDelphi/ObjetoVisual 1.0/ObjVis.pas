procedure TObjetoVisual.AtualizaAreaClick;
var
   nI : Integer;
begin
   Corpo.PontosSensiveisPorFace.Clear;
   with Corpo.FDMOV.taAreaVista do      //using "friend" FDMOV
   begin
      Filter := 'OBJETO = ' + '''' + Corpo.NomeObjetoVisual + '''' +
                ' AND OVORDEM = ' + IntToStr( Corpo.VistaCorrente );
      Filtered := True;
      //O parent dos labels e' o ObjetoVisual, quando ele e' destruido
      //os labels sao liberados
      //Mais aqui queremos reutilizar os labels, por isso precisa dar free
      for nI := 0 to FAreaClick.Count - 1 do
          TLabel( FAreaClick.Items[nI] ).Free;
      FAreaClick.Free;
      FAreaClick := TList.Create;
      nI := 0;
      First;
      while not EOF do
      begin
         if Corpo.FDMOV.taAreaClick.Locate( 'OVAREA', FieldByName( 'OVAREA' ).AsString, [] ) and
            ( Corpo.PontosCalculo.IndexOf( FieldByName( 'OVAREA' ).AsString ) > -1 ) then
            begin
               FAreaClick.Add( TLabel.Create(self) );
               TLabel( FAreaClick.Items[nI] ).SetBounds( FieldByName( 'OVLEFT' ).AsInteger,
                                                         FieldByName( 'OVTOP' ).AsInteger,
                                                         FieldByName( 'OVWIDTH' ).AsInteger,
                                                         FieldByName( 'OVHEIGHT' ).AsInteger );
               TLabel( FAreaClick.Items[nI] ).Caption := FieldByName( 'OVCAPTION' ).AsString ;
               TLabel( FAreaClick.Items[nI] ).Hint := Corpo.FDMOV.taAreaClick.FieldByName( 'DESCRICAO' ).AsString;
               TLabel( FAreaClick.Items[nI] ).Font.Color := clRed;
               TLabel( FAreaClick.Items[nI] ).ShowHint := True;
               TLabel( FAreaClick.Items[nI] ).Transparent := True;
               TLabel( FAreaClick.Items[nI] ).Tag := Corpo.PontosSensiveisDoCorpo.IndexOf( Corpo.FDMOV.taAreaClick.FieldByName( 'OVAREA' ).AsString ); //FDMOV.taAreaClick.FieldByName( 'IDAREA' ).AsInteger;
               if Corpo.FDMOV.taCursores.Locate( 'OVCURSOR', Corpo.FDMOV.taAreaClick.FieldByName( 'OVCURSOR' ).AsString, [] ) then
                  TLabel( FAreaClick.Items[nI] ).Cursor := Corpo.FDMOV.taCursores.FieldByName( 'NCURSOR' ).Value;
               if Corpo.PontosCalculo.IndexOf( FieldByName( 'OVAREA' ).AsString) > -1 then
                  Corpo.PontosSensiveisPorFace.AddObject( FieldByName( 'OVAREA' ).AsString, FAreaClick.Items[nI] );
               Inc(nI);
            end;
            Next;
      end;
   end;
end;

