procedure TObjetoVisual.AvancaVista;
begin
if not Assigned(FCorpo) then exit;
   FCorpo.VistaCorrente := FCorpo.VistaCorrente + 1;
   if FCorpo.VistaCorrente > FCorpo.TotalVistas then
      FCorpo.VistaCorrente := 1;
   AtualizaVista;
end;

procedure TObjetoVisual.RetrocedeVista;
begin
   if not Assigned(FCorpo) then exit;
      FCorpo.VistaCorrente := FCorpo.VistaCorrente - 1;
   if FCorpo.VistaCorrente < 1 then
      FCorpo.VistaCorrente := FCorpo.TotalVistas;
   AtualizaVista;
end;

procedure TObjetoVisual.PrimeiraVista;
begin
   if not Assigned(FCorpo) then exit;
      FCorpo.VistaCorrente := 1;
   AtualizaVista;
end;

procedure TObjetoVisual.UltimaVista;
begin
   if not Assigned(FCorpo) then exit;
      FCorpo.VistaCorrente := FCorpo.TotalVistas;
   AtualizaVista;
end;

function TObjetoVisual.VaiParaVista( Ordem : Integer ) : Boolean;
begin
   if not Assigned (FCorpo) then
      begin
         Result := False;
         exit;
      end;
   if ( Ordem > FCorpo.TotalVistas ) or ( Ordem < 1 ) then
      Result := False
   else
      begin
         FCorpo.VistaCorrente := Ordem;
         AtualizaVista;
         Result := True;
      end;
end;

procedure TObjetoVisual.AtualizaVista;
var
   i : integer;
begin
  if not Assigned(FCorpo) then
     exit;
  FCorpo.GetVista(FVista);
  self.Width := FVista.Picture.Width;
  self.Height := FVista.Picture.Height;
  FVista.Stretch := True;
  FVista.Refresh;
  AtualizaAreaClick;
  for i := 0 to AreaClick.Count - 1 do
      begin
         TLabel( AreaClick.Items[I] ).OnClick := LabelClick;
         TLabel( AreaClick.Items[I] ).Parent := self;
         TLabel( AreaClick.Items[I] ).Cursor := crHandPoint;
      end;
end;

procedure TObjetoVisual.MostraVistas( Espera : Integer );
begin
   FTime.Interval := Espera;
   FTime.Enabled := True;
end;

procedure TObjetoVisual.ParaMostraVistas;
begin
   FTime.Enabled := False;
   FTime.Interval := 0;
end;

procedure TObjetoVisual.PausaMostraVistas;
begin
   if FTime.Enabled then
      FTime.Enabled := False
   else if FTime.Interval > 0 then
      FTime.Enabled := True;
end;

