function TTabela.Execute : Boolean;
var
   dsTab : TDataSource;
   qrTab : TQuery;
   sSQL : string;
   I : integer;
   Lista : TStringList;
begin
   Result := True;
   // Criando objetos de acesso a tabela
   dsTab := TDataSource.Create(self);
   qrTab := TQuery.Create(self);
   // configurando a Query
   with qrTab do
   begin
      Close;
      DatabaseName := FDataBaseName;
      DataSource := dsTab;
      SQL.Clear;
      if FModoPesquisa = mpNewRanges then
         begin
            sSQL := 'SELECT * FROM ' + FNomeTabela;
            if FCondicao <> '' then
               sSQL := sSQL + ' WHERE ' + FCondicao;
         end
      else
         begin
            sSQL := 'SELECT ' + FCampoResult + ' FROM ' + FNomeTabela;
            if FCondicao <> '' then
               sSQL := sSQL + ' WHERE ' + FCondicao;
         end;
      SQL.Add( sSQL );
      Result := True;
      Try
         for I := 0 to ParamCount - 1 do
           begin
            if Params[I].Name = 'A' then
            begin
               Result := SetaParam( qrTab, I, FA );
            end
            else if Params[I].Name = 'B' then
            begin
               Result := SetaParam( qrTab, I, FB );
            end
            else if Params[I].Name = 'C' then
            begin
               Result := SetaParam( qrTab, I, FC );
            end
            else if Params[I].Name = 'D' then
            begin
               Result := SetaParam( qrTab, I, FD );
            end
            else if Params[I].Name = 'E' then
            begin
               Result := SetaParam( qrTab, I, FE );
            end
           end;
      except
        on E:exception do
        begin
           Close;
           FResultado.Valid := False;
           Result:=False;
           raise exception.CreateFmt(e.message,[]);
        end;
      end;

      if not Result then
         begin
            Close;
            FResultado.ValorNumerico := '*** indeterminado ***';
            FResultado.Valid := False;
            exit;
         end;

      // indica operação demorada;
      if Assigned( FDelayedOpIndicator ) then
         FDelayedOpIndicator.Start;
      try
         Open;
      finally
         // finaliza indicação de operação demorada
         if Assigned( FDelayedOpIndicator ) then
            FDelayedOpIndicator.Finish;
      end;
      if qrTab.IsEmpty then
         begin
            Close;
            FResultado.ValorNumerico := '*** indeterminado ***';
            FResultado.Valid := False;
            // Quebra galho. Deveria ter uma tabela de erros
            if UpperCase(FNomeTabela) = 'T29' then
               FResultado.InvalidDescr := 'não disponível para essa idade gestacional (a partir da 10a. semana)'
            else
               FResultado.InvalidDescr := 'não adequado para essa faixa etária';
            Result:= False;
            exit;
         end;
      case FModoPesquisa of
           mpFirstRecord : begin
                              qrTab.First;
                              FResultado.ValorNumerico := FieldByName(FCampoResult).AsString;
                              FResultado.Valid := (FResultado.ValorNumerico <> '');
                           end;
           mpLastRecord : begin
                              qrTab.Last;
                              FResultado.ValorNumerico := FieldByName(FCampoResult).AsString;
                              FResultado.Valid := (FResultado.ValorNumerico <> '');
                           end;
           mpRanges :      begin
                              CarregaFaixas(qrTab, PegaCampo( FCampoResult, 1 ), PegaCampo( FCampoResult, 2 ), FA.Unidade);
                              Lista := TStringList.Create;
                              FaixasValidas(Lista, FA);
                              FResultado.ValorNumerico := SemAspas( Lista.CommaText );
                              FResultado.Valid := (FResultado.ValorNumerico <> '');
                              Lista.Free;
                           end;
           mpNewRanges :   begin
                              CarregaFaixas( qrTab, FCampoResult );
                              FResultado.ValorNumerico := Caption(FA);
                              FResultado.Valid := (FResultado.ValorNumerico <> '');
                           end;
      end;
      Close;
   end;
end;

function TTabela.SetaParam( Qry : TQuery; I : integer; Param : TMedida ) : Boolean;
begin
   Result := False;
   if ( Param.Empty ) then
      raise EMeasurementError.CreateFmt( '%s é uma medida vazia', [Param.Name])
   //So o Param tem o conhecimento do tipo de variavel (Float ou String)
   else if Param is TMedidaOrdinal then
        Qry.Params[I].AsString := Param.ValorNumerico
   else //TMedida e' o default (numerico)
        Qry.Params[I].AsFloat := Param.AsFloat;
   if Param.Valid or FAceitaParametrosInvalidos then
      Result := True;
end;

