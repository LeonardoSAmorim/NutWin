end;

procedure TTabela.CarregaFaixas(DataSet: TDataSet; CampoValor,
  CampoDescricao: String; UnidadeFaixas : String);
begin
   with DataSet do begin
      FFaixas.Ranges.Clear;
      if IsEmpty then
         Exit;
      First;
      with FFaixas.Ranges.Add do begin
         with BeginPoint do begin
            Opened := True;
            Excluded := False;
            with Point do begin
               Descricao := '';
               Unidade := '';
            end;
         end;
         with EndPoint do begin
            Opened := False;
            Excluded := True;
            with Point do begin
               Descricao := FieldByName( CampoDescricao ).AsString;
               AsFloat := FieldByName( CampoValor ).AsFloat;
               Unidade := UnidadeFaixas;
            end;
         end;
         Caption := 'menor que ' + EndPoint.Point.Descricao ;
      end;
      while not EOF do begin
      with FFaixas.Ranges.Add do begin
         with BeginPoint do begin
            Opened := False;
            Excluded := False;
            with Point do begin
               Descricao := FieldByName( CampoDescricao ).AsString;;
               AsFloat := FieldByName( CampoValor ).AsFloat;
               Unidade := UnidadeFaixas;
            end;
         end;
         with EndPoint do begin
            Opened := False;
            Excluded := False;
            with Point do begin
               Descricao := FieldByName( CampoDescricao ).AsString;;
               AsFloat := FieldByName( CampoValor ).AsFloat;
               Unidade := UnidadeFaixas;
            end;
         end;
         Caption := BeginPoint.Point.Descricao;
      end;
         with FFaixas.Ranges.Add do begin
            with BeginPoint do begin
               Opened := False;
               Excluded := True;
               with Point do begin
                  Descricao := FieldByName( CampoDescricao ).AsString;;
                  AsFloat := FieldByName( CampoValor ).AsFloat;
                  Unidade := UnidadeFaixas;
               end;
            end;
            next;
            with EndPoint do begin
               Opened := False;
               Excluded := True;
               with Point do begin
                  Descricao := FieldByName( CampoDescricao ).AsString;;
                  AsFloat := FieldByName( CampoValor ).AsFloat;
                  Unidade := UnidadeFaixas;
               end;
            end;
            Caption := BeginPoint.Point.Descricao + ' e ' + EndPoint.Point.Descricao;
         end;
      end;
      with FFaixas.Ranges.Add do begin
         with BeginPoint do begin
            Opened := False;
            Excluded := True;
            with Point do begin
               Descricao := FieldByName( CampoDescricao ).AsString;;
               AsFloat := FieldByName( CampoValor ).AsFloat;
               Unidade := UnidadeFaixas;
            end;
         end;
         with EndPoint do begin
            Opened := True;
            Excluded := False;
            with Point do begin
               Descricao := '';
               Unidade := '';
            end;
         end;
         Caption := 'maior que ' + BeginPoint.Point.Descricao;
      end;
   end;
end;

procedure TTabela.FaixasValidas(var ListaFaixas: TStringList; Medida : TMedida);
var
   I : Integer;
begin
   ListaFaixas.Clear;
   for I := 0 to FFaixas.Ranges.Count - 1 do
   begin
      if FFaixas.Ranges.Items[I].Has( Medida ) then
      begin
         if FFaixas.Ranges.Items[I].BeginPoint.Point.ValorNumerico =
            FFaixas.Ranges.Items[I].EndPoint.Point.ValorNumerico then
            ListaFaixas.Add( FFaixas.Ranges.Items[I].Caption + ' ( ' +
                              FFaixas.Ranges.Items[I].BeginPoint.Point.ValorNumerico + ' ' +
                              FFaixas.Ranges.Items[I].EndPoint.Point.Unidade + ' )' )
      else
         ListaFaixas.Add( FFaixas.Ranges.Items[I].Caption + ' ( ' +
                          FFaixas.Ranges.Items[I].BeginPoint.Point.ValorNumerico + ' ... ' +
                          FFaixas.Ranges.Items[I].EndPoint.Point.ValorNumerico + ' ' +
                          FFaixas.Ranges.Items[I].EndPoint.Point.Unidade + ' )' );
      end;
   end;
end;

function TTabela.PegaCampo(ListaCampos: String; Pos: Integer): String;
var
   S : TStringList;
begin
   S := TStringList.Create;
   S.CommaText := ListaCampos;
   if S.Count >= Pos then
      Result := S.Strings[Pos-1]
   else
      Result := '';
   S.Free;
end;

function TTabela.SemAspas(Str: String): String;
begin
   { Convert " to ' ' }
   while Pos('"', Str) > 0 do
      Str[Pos('"', Str)] := ' ';
   Result := Trim( Str );
end;

