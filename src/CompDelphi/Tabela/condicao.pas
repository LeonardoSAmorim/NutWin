function TCondicao.Execute : Boolean;
var
   dsTab : TDataSource;
   qrTab : TQuery;
   taTab : TTable;
   sSQL : string;
   I : integer;

begin
   // Criando objetos de acesso a Condicao
   dsTab := TDataSource.Create(self);
   qrTab := TQuery.Create(self);
   taTab := TTable.Create(self);
   with taTab do
   begin
      Close;
      DatabaseName := FDataBaseName;
      TableName := FNomeCondicao;
      Open;
      Edit;
      if FA <> nil then
         FieldByName( 'A' ).AsString := FA.ValorNumerico;
      if FB <> nil then
         FieldByName( 'B' ).AsString := FB.ValorNumerico;
      if FC <> nil then
         FieldByName( 'C' ).AsString := FC.ValorNumerico;
      if FD <> nil then
         FieldByName( 'D' ).AsString := FD.ValorNumerico;
      if FE <> nil then
         FieldByName( 'E' ).AsString := FE.ValorNumerico;
      Post;
      Close;
   end;
   // configurando a Query
   with qrTab do
   begin
      Close;
      DatabaseName := FDataBaseName;
      DataSource := dsTab;
      SQL.Clear;
      sSQL := 'SELECT * FROM ' + FNomeCondicao + ' WHERE ' + FCondicao;
      SQL.Add( sSQL );
      for I := 0 to ParamCount - 1 do
        begin
         if Params[I].Name = 'A' then
            SetaParam( qrTab, I, FA.ValorNumerico )
         else if Params[I].Name = 'B' then
            SetaParam( qrTab, I, FB.ValorNumerico )
         else if Params[I].Name = 'C' then
            SetaParam( qrTab, I, FC.ValorNumerico )
         else if Params[I].Name = 'D' then
            SetaParam( qrTab, I, FD.ValorNumerico )
         else if Params[I].Name = 'E' then
            SetaParam( qrTab, I, FE.ValorNumerico )
        end;
{      for I := 0 to ParamCount - 1 do
        begin
         if Params[I].Name = 'A' then
            Params[I].AsString := FA.ValorNumerico
         else if Params[I].Name = 'B' then
            Params[I].AsFloat  := StrToFloat( FB.ValorNumerico )
         else if Params[I].Name = 'C' then
            Params[I].AsFloat  := StrToFloat( FC.ValorNumerico )
         else if Params[I].Name = 'D' then
            Params[I].AsString := FD.ValorNumerico
         else if Params[I].Name = 'E' then
            Params[I].AsString := FE.ValorNumerico;
        end; }
      Open;
      qrTab.First;
      if qrTab.EOF then
         FResultado := FFalso
      else
         FResultado := FVerdadeiro;
{
      try
         FResultado.ValorNumerico := FloatToStr( FieldByName(FCampoResult).AsFloat );
      except
         on EConvertError do FResultado.ValorNumerico := FieldByName(FCampoResult).AsString;
      end;
}
      Close;
   end;

   { Return True if the operation was successful, False otherwise }
   Result := True;
end;

