procedure TRDA.SetMemoria(const Value: TMemoria);
begin
  FMemoria := Value;
  if Value <> nil then
     Value.FreeNotification(Self);
end;

procedure TRDA.SetDelayedOpIndicator(const Value: TDelayedOpIndicator);
begin
  FDelayedOpIndicator := Value;
  if Value <> nil then
     Value.FreeNotification(Self);
end;

