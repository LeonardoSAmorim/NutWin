{ Atualiza os PainelMedidas do componente Onwer }
procedure TVisorCalculo.Refresh;
     { Internal declarations for method }
     { type }
     { . . . }
     { var }
     { . . . }
var
   i : Integer;
   Obj : TObject;
begin
   if not(FCalculo = nil) and not( FContainer = nil ) then
   begin
      FSetting := True; // Para o usuário deste componente desligar os eventos dos visores medidas se necessário
      for i := 0 to FContainer.ComponentCount - 1 do
          if ( FContainer.Components[i] is TPainelMedida ) then
           begin
             if FCalculo.Memoria.Acha( TPainelMedida( FContainer.Components[i] ).NomeMedida , Obj ) then
                TPainelMedida( FContainer.Components[i] ).Medida := TMedida( Obj );
           end
          else if ( FContainer.Components[i] is TGBoxMedida ) then
           begin
             if FCalculo.Memoria.Acha( TGBoxMedida( FContainer.Components[i] ).NomeMedida , Obj ) then
                TGBoxMedida( FContainer.Components[i] ).Medida := TMedida( Obj );
           end
          else if ( FContainer.Components[i] is TVisorMedida ) then
           begin
             if FCalculo.Memoria.Acha( TVisorMedida( FContainer.Components[i] ).NomeMedida, Obj ) then
                TVisorMedida( FContainer.Components[i] ).Medida := TMedida( Obj );
         end
          else if ( FContainer.Components[i] is TPainelNascimento ) then
           begin
             if FCalculo.Memoria.Acha( TPainelNascimento( FContainer.Components[i] ).NomeMedidaIdade , Obj ) then
                TPainelNascimento( FContainer.Components[i] ).mdIdade := TIdade( Obj );
             if FCalculo.Memoria.Acha( TPainelNascimento( FContainer.Components[i] ).NomeMedidaNascimento , Obj ) then
                TPainelNascimento( FContainer.Components[i] ).mdNascimento := TMedida( Obj );
             if FCalculo.Memoria.Acha( TPainelNascimento( FContainer.Components[i] ).NomeMedidaReferencia , Obj ) then
                TPainelNascimento( FContainer.Components[i] ).mdReferencia := TMedida( Obj );
           end
          else if ( FContainer.Components[i] is TMmListBox ) then
           begin
             if FCalculo.Memoria.Acha( TMmListBox( FContainer.Components[i] ).NomeLista , Obj ) then
                TMmListBox( FContainer.Components[i] ).ListaDeItens := TStringList( Obj );
           end;
      FSetting := False;
   end;
   AfterRefresh( Self );
end;

procedure TVisorCalculo.AfterRefresh;
begin
// Has the application assigned a method to the event, whether via the Object
// Inspector or a run-time assignment?  If so,execute that method.
     if Assigned(FOnAfterRefresh) then
        FOnAfterRefresh(Self)
end;

end.
