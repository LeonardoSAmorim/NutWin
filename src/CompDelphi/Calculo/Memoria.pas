procedure TMemoria.Notification(AComponent: TComponent; Operation: TOperation);
begin
   inherited Notification(AComponent, Operation);
   if Operation <> opRemove then
      Exit;
   if AComponent = FViewer then
      FViewer := nil;
end;

function TMemoria.PegaObjeto(IDObjeto: String): TObject;
var
   I : Integer;
begin
   if Acha(IDObjeto, Result) then
      exit;
   if FListaStrings.Find(IDObjeto, I) then
      Result := FListaStrings.Objects[I]
   else
     Result := nil;
end;

function TMemoria.Salvar : Boolean;
var
   Temp : TStringList;
   Str : String;
   AsXML : Boolean;
begin
   // Determina o formato da gravação pela extensão
   if UpperCase(ExtractFileExt(FNomeArquivo)) = '.XML' then
      AsXML := True
   else
      AsXML := False;
   // Recebe o conteúdo da memória
   Result := StoreMemory( Str, AsXML );
   if Result then
   begin
      Temp := TStringList.Create;
      try
         Temp.Text := Str;
         // Salva no arquivo
         Temp.SaveToFile(FNomeArquivo);
      finally
         Temp.Free;
      end;
   end;
end;

