// Carrega os componentes dentro da caixa
// precisa que Saida exista e contenha serialização dos componentes e FFormatoXML definido
function TCaixa.LoadCaixa : Boolean;
begin
   Result := False;
   // não carrega nada se FSaida estiver vazia
   if Assigned(FSaida) and ( FSaida.Count > 0 ) then
   begin
      if FFormatoXML then
      begin
         // É um arquivo texto .XML
         XMLStringToComponent(FSaida.Text, self);
         Result := True;
      end
      else
      begin
         // É um arquivo texto .NUT
         StringToComponent(FSaida.Text, self);
         Result := True;
      end;
   end;
end;

// Carrega caixa com os componentes serializados em Str
// FFormatXML precisa ser definido antes de chamar este método
function TMemoria.LoadMemory(Str: String; FmtXML : Boolean): Boolean;
begin
   // Carrega se Str não for vazio
   if Str = '' then
      Result := False
   // Cria um StringList para a FSaida se não existir
   else if Saida = nil then
      begin
         Saida := TStringList.Create;
         try
            Saida.Text := Str;
            FFormatoXML := FmtXML;
            Result := LoadCaixa; // é a carga propriamente dita
            if Result then
               FEmpty := False;
         finally
            Saida.Free;
            Saida := nil;
         end;
      end
   else // já existe um TStringList criado em FSaida
      begin
         Saida.Text := Str;
         FFormatoXML := FmtXML;
         Result := LoadCaixa; // carrega o arquivo para a caixa já fazendo o parser
         if Result then
            FEmpty := False;
      end;
end;

