procedure TCaixa.ReadState(Reader: Classes.TReader);
var
  I:integer;
  OldRoot : TComponent;
  AReader : TMyReader;
  OldParent,
  OldOwner: TComponent;
begin
  OldRoot := Reader.Root;
  AReader := TMyReader(Reader);
  with AReader do
  begin
    Root := self;
    OldParent := Parent;
    OldOwner := Owner;
    Owner := self;
    while not EndOfList do ReadProperty(self);
    ReadListEnd;
    try
      for I := 0 to ComponentCount - 1 do
        if not EndOfList then
        begin
          Parent := TMyComponent(Components[I]).GetChildParent;
          ReadComponent(Components[I]);
        end;
      while not EndOfList do
          ReadComponent(nil);
      ReadListEnd;
    finally
      Parent := OldParent;
      Owner := OldOwner;
      Root := OldRoot;
    end;
  end;
end;

