procedure TMemoria.UpdateViewer;
var
   I, J : Integer;
   ListaConteudo : TStringList;
begin
   if Assigned( FViewer ) then
      begin
         FViewer.Items.Clear;
         ListaConteudo := TStringList.Create;
         self.ListaConteudo(ListaConteudo);
         for I := 0 to ListaConteudo.Count - 1 do
         begin
            if ListaConteudo.Objects[I] is TCaixa then
               FViewer.Items.Add( ListaConteudo.Strings[I] )
            else if ListaConteudo.Objects[I] is TMedida then
               FViewer.Items.Add( '  ' + TMedida( ListaConteudo.Objects[I] ).Name + ' = ' +
                                         TMedida( ListaConteudo.Objects[I] ).ValorNumerico + ' ' +
                                         TMedida( ListaConteudo.Objects[I] ).Unidade + ' (' +
                                         TMedida( ListaConteudo.Objects[I] ).ClassName + ')')
            else if ListaConteudo.Objects[I] is TItemAlimentar then
               FViewer.Items.Add( '  ' + TItemAlimentar( ListaConteudo.Objects[I] ).IDAlimento + ', ' +
                                         TItemAlimentar( ListaConteudo.Objects[I] ).IDRefeicao + ', ' +
                                         TItemAlimentar( ListaConteudo.Objects[I] ).IDMedida + ', ' +
                                         TItemAlimentar( ListaConteudo.Objects[I] ).Quantidade + ', ' +
                                         FloatToStr( TItemAlimentar( ListaConteudo.Objects[I] ).PesoEmGramas ) + ', ' +
                                         IntToStr( TItemAlimentar( ListaConteudo.Objects[I] ).FrequenciaDia ) )
            else if ListaConteudo.Objects[i] is TProcedimento then
               FViewer.Items.Add( '  ' + TProcedimento( ListaConteudo.Objects[I] ).Name + ' = ' +
                                         TProcedimento( ListaConteudo.Objects[I] ).Descricao );
         end;
         for I := 0 to FListaStrings.Count - 1 do
            if ( FListaStrings.Objects[I] is TStringList ) then
               begin
                  FViewer.Items.Add( '(' + FListaStrings.Strings[I] + ')' );
                  for J := 0 to TStringList( FListaStrings.Objects[I] ).Count - 1 do
                      FViewer.Items.Add( IntToStr( J )+ ' = ' +
                                         TStringList( FListaStrings.Objects[I] ).Strings[J] );
                end;
         ListaConteudo.Free;
      end;
end;

function TMemoria.StoreMemory(var Str: String; FmtXML: Boolean): Boolean;
begin
   // Cria um StringList para a Saida se não existir
   if Saida = nil then
      begin
         Saida := TStringList.Create;
         try
            FFormatoXML := FmtXML;
            Result := StoreCaixa;
            if Result then
               Str := FSaida.Text
            else
               Str := '';
         finally
            Saida.Free;
            Saida := nil;
         end;
      end
   else // já existe um TStringList criado em Saida
      begin
         FFormatoXML := FmtXML;
         Result := StoreCaixa;
         if Result then
            Str := FSaida.Text
         else
            Str := '';   
      end;
end;

