function TCaixa.Acha(Nome: String; var Obj: TObject): Boolean;
var
   I : Integer;
   TempComp : TComponent;
begin
   Obj := FindComponent(Nome);
   if Obj<>nil then
      begin
         Result := True;
         exit;
      end
   else
      for I := 0 to ComponentCount-1 do
          begin
             TempComp := Components[I];
             if TempComp is TCaixa then
                if (TempComp as TCaixa).Acha(Nome,Obj) then
                   begin
                      Result := True;
                      exit;
                   end;
          end;
   Result := False;
end;

procedure TCaixa.AssignTo(Dest: TPersistent);
var
   I : Integer;
   Caixa : TCaixa;
begin
   if Dest is TCaixa then
      begin
         Caixa := Dest as TCaixa;
         //Copia propriedade da caixa
         Caixa.Saida := Saida;
         //Copia componentes
         for I := 0 to ComponentCount - 1 do
             if Components[i] is TMedida then
                TMedidaClass((Components[I]).ClassType).Create(Caixa,TMedida(Components[I]))
             else if Components[i] is TCaixa then
                begin
                   with TCaixa.Create(Caixa) do
                   begin
                      Name := self.Components[I].Name;
                      Descricao := TCaixa(self.Components[I]).Descricao;
                      Assign(self.Components[I]);
                   end;
                end
             else
                begin
                  //Qualquer outro tipo de componente
                  //Tem que escrever o Assign do componente
                  with TComponentClass(Components[i].ClassType).Create(Caixa) do
                       Assign(self.Components[I]);
                end;

      end
   else
      inherited AssignTo(Dest);
end;

function TCaixa.ComponentToString(Component: TComponent): string;
var
   BinStream : TMemoryStream;
   StrStream : TStringStream;
   S : string;
begin
   BinStream := TMemoryStream.Create;
   try
     StrStream := TStringStream.Create(S);
     try
       BinStream.WriteComponent(Component);
       BinStream.Seek(0, soFromBeginning);
       ObjectBinaryToText(BinStream, StrStream);
       StrStream.Seek(0, soFromBeginning);
       Result := StrStream.DataString;
     finally
       StrStream.Free;
     end;
   finally
     BinStream.Free
   end;
end;

