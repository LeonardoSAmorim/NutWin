function TCaixa.StoreCaixa : Boolean;
begin
   Result := False;
   // precisa ter algo na memória e uma saida
   if Assigned(FSaida) and ( ComponentCount > 0 ) then
   begin
      if FFormatoXML then
      begin
         // É um arquivo texto .XML
         FSaida.Text := XMLComponentToString(self,
                                             '<!DOCTYPE TMemoria SYSTEM "nutwin.dtd">',
                                             '<?xml:stylesheet type="text/xsl" href="nut.xsl"?>'); // somente para teste XML
         Result := True;
      end
      else
      begin
         // É um arquivo texto .NUT
         FSaida.Text := ComponentToString(self);
         Result := True;
      end;
   end;
end;

function TCaixa.StringToComponent(Value: string; Componente: TComponent): TComponent;
var
   StrStream : TStringStream;
   BinStream : TMemoryStream;
begin
  if Value = '' then
     begin
        Result := nil;
       exit;
     end;
  StrStream := TStringStream.Create(Value);
  try
    BinStream := TMemoryStream.Create;
    try
      ObjectTextToBinary(StrStream, BinStream);
      BinStream.Seek(0, soFromBeginning);
      Result := BinStream.ReadComponent(Componente);
    finally
      BinStream.Free;
    end;
  finally
    StrStream.Free;
  end;
end;

function TCaixa.TiraFora(Obj, NewOwner: TComponent): TComponent;
var
   Temp : TComponent;
begin
   Temp := Obj;
   RemoveComponent(Temp);
   NewOwner.InsertComponent(Temp);
   Result := nil;
end;

{ TMemoria }

function TMemoria.Abrir: Boolean;
var
   Temp : TStringList;
   Str : String;
   IsXML : Boolean;
begin
   // verifica se arquivo existe
   if not FileExists(FNomeArquivo) then
   begin
      Result := False;
      exit;
   end;
   // Verifica se o arquivo é um XML ou não
   if UpperCase(ExtractFileExt(FNomeArquivo)) = '.XML' then
      IsXML := True
   else
      IsXML := False;
   // Carrega arquivo
   Temp := TStringList.Create;
   try
      Temp.LoadFromFile( FNomeArquivo );
      Str := Temp.Text;
   finally
      Temp.Free;
   end;
   // Carrega memoria
   Result := LoadMemory( Str, IsXML );
end;

function TMemoria.Acha(Nome: String; var Obj: TObject): Boolean;
var
   I:Integer;
begin
   Result := inherited Acha(Nome, Obj);
   if not Result then
      begin
         Result := FListaStrings.Find(Nome, I);
         if Result then
            Obj := FListaStrings.Objects[I]
         else
            Obj := nil;
      end;
end;

procedure TMemoria.AddModified;
begin
   Modified := 1;
   ModifiedValue(self);
   if FViewer <> nil then
      UpdateViewer;
end;

function TMemoria.Adiciona(Nome: String; Obj: TObject; Categoria: string): Boolean;
var
   O : TObject;
   AuxList : TStringList;
   AuxCx : TCaixa;
   TempObj: TObject;
begin
   Result := False;
   if not Acha( Nome, O ) then
   begin
    if ( Obj is TMedida ) or ( Obj is TItemAlimentar ) then
      begin
         //Categoria : representa a subdivisao da memoria na qual vou jogar a medida nova.
         //As novas medidas sao criadas por polimorfismo para criar o tipo correto
         if Categoria = '' then
            TempObj := TComponentClass(Obj.ClassType).Create(Self)
         else
            begin
               if not Acha(Categoria,TObject(AuxCx)) then
                  begin
                     AuxCx := TCaixa.Create(self);
                     AuxCx.Name := Categoria;
                  end;
                  TempObj := TComponentClass(Obj.ClassType).Create(AuxCx);
            end;
         TComponent(TempObj).Assign(TPersistent(Obj));
         Result := True;
         FEmpty := False;
      end
    else if ( Obj is TStringList ) then
      begin
         AuxList := TStringList.Create;
         AuxList.Assign(TStringList(Obj));
         FListaStrings.AddObject(Nome, AuxList);
         Result := True;
         FEmpty := False;
      end
    else
      Result := False;
   end;
end;

procedure TMemoria.AssignTo(Dest: TPersistent);
var
   I : Integer;
   Memoria : TMemoria;
begin
   if Dest is TMemoria then
      begin
         Memoria := (Dest as TMemoria);
         Memoria.Limpar;
         //Copia os atributos de uma caixa (e os componentes)
         inherited;
         //Copia Strings
         for I := 0 to FListaStrings.Count - 1 do
             Memoria.Adiciona( FListaStrings.Strings[I], FListaStrings.Objects[I] );
         //Copia outros atributos
         Memoria.NomeArquivo := FNomeArquivo;
         Memoria.OnModified := FOnModified;
         Memoria.Viewer := FViewer;
         Memoria.Modified := Modified;
         Memoria.SetEmpty( FEmpty );
      end
   else
      inherited;
end;

procedure TMemoria.CopiaPara(Memoria: TMemoria);
begin
   AssignTo(Memoria);
end;

constructor TMemoria.Create(AOwner: TComponent);
begin
   inherited Create(AOwner);
   FListaStrings := TStringListOfStrings.Create;
   FListaStrings.Sorted := True;
   FListaStrings.Duplicates := dupIgnore;
   Modified := 0;
   FEmpty := True;
end;

destructor TMemoria.Destroy;
var
   I : Integer;
begin
   For I := 0 To FListaStrings.Count - 1 do
       FListaStrings.Objects[I].Free;
   FListaStrings.Free;
   inherited Destroy;
end;

procedure TMemoria.Limpar;
var
   I : Integer;
begin
   //Limpa a caixa
   inherited;
   //Limpa os strings
   for I := FListaStrings.Count - 1 downto 0 do
      begin
         FListaStrings.Objects[I].Free;
         FListaStrings.Delete(I);
      end;
   // libera os componentes
   for I := ComponentCount - 1 downto 0 do
       Components[I].Free;
   //Copia outros atributos
   FNomeArquivo := '';
   FOnModified := nil;
   Modified := 0;
   FEmpty := True;
end;

