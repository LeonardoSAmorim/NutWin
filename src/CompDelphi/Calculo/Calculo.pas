function TCalculo.SetEstadoProc(const Memoria: TMemoria; const Caixa,
  Procedimento: String; const EstadoProc: TProcState): Boolean;
var
   AuxCx,
   AuxPr : TComponent;
begin
  Result := False;
  AuxCx := nil;
  if Assigned (Memoria) then
     AuxCx := Memoria.FindComponent( Caixa );
  if Assigned( AuxCx ) then
    if ( AuxCx is TCaixa ) then
     with (AuxCx as TCaixa ) do
     begin
       AuxPr := FindComponent( Procedimento );
       if Assigned( AuxPr ) then
         if ( AuxPr is TProcedimento ) then
           with (AuxPr as TProcedimento ) do
           begin
              Estado := EstadoProc;
              Result := True;
           end;
     end;
end;

