function TCalculo.SetNomeProc(Value: wideString): Boolean;
var
   Code,
   Description : WideString;
begin
   // Tipo de Lista de Procedimentos for de Descricoes
   if FTipoListaProc = tpDescription then
      begin
         Description := Value;
         if FDicionario.FindCodeByDescription( Code, Description ) = 1 then
            begin
               FNomeProc := Code;
               Result := True;
            end
         else
            Result := False;
      end
   else
      begin
         FNomeProc := Value;
         Result := True;
      end;
end;

