procedure TCalculo.TratErroFmla(fla: TFormula; E: Exception);
begin
   if ((E.ClassType = EInvalidArgument) or
      (E.ClassType =  EExpressionHasBlanks) or
      (E.ClassType =  EParserInternalError)) then
      begin
         ShowMessage ('Erro na execução da formula : ' + fla.Descricao + #13#10 +
                      'Alguma das medidas do indivíduo está fora dos' + #13#10 +
                      'valores aceitos por este programa para efetuar calculos.' + #13#10 +
                      'Você já deve ter sido advertido anteriormente desta situação.' + #13#10 +
                      'A mensagem enviada pelo parser foi : ' + E.Message + #13#10);
         exit;
      end;
end;

procedure TCalculo.TratErroTbla(Tbla: TTabela; E: Exception);
begin
   if ((E.ClassType = EInvalidArgument) or
       (E.ClassType = ETabelaVazia)) then
      begin
         ShowMessage ('Erro na execução da tabela : ' + Tbla.NomeTabela  + #13#10 +
                      'Alguma das medidas do indivíduo está fora dos' + #13#10 +
                      'valores aceitos por este programa para efetuar calculos.' + #13#10 +
                      'Você já deve ter sido advertido anteriormente desta situação.' + #13#10 +
                      E.Message + #13#10);
         exit;
      end;
end;

procedure TCalculo.ValidaCalculo(Calculo, Caixa: String);
var
   AuxCx,
   AuxPr : TComponent;
   mdMed : TMedida;
   I, J : Integer;
   Temp, Temp2 : TStringList;
begin
   Procedimentos.Clear;
   Temp := TStringList.Create;
   Temp2 := TStringList.Create;
   Dicionario.CollectListInstances( Calculo, Temp, ltCode);
   Procedimentos.Assign(Temp);
   CriaMedidas;
   Execute;
   AuxCx := FMemoria.FindComponent( Caixa );
   if Assigned( AuxCx ) then
    if ( AuxCx is TCaixa ) then
     with (AuxCx as TCaixa ) do
     begin
        For I := 0 to AuxCx.ComponentCount - 1 do
        begin
           AuxPr := AuxCx.Components[I];
           if ( AuxPr is TProcedimento ) then
           with (AuxPr as TProcedimento ) do
           begin
              if ( Estado = psInvisible ) or ( Estado = psHidden ) then
                 // nao precisa validar aqui
              else if FMemoria.Acha( NomeMedidaValidacao, TObject( mdMed ) ) then
                 begin
                    if mdMed.AsFloat <> 0 then
                       Estado := psNone
                    else
                       Estado := psDisabled;
                    // Pega descrição das fórmulas ou tabelas de validação onde está o escopo
                    Temp2.Clear;
                    Escopo := '';
                    Dicionario.CollectListInstances( 'vl' + AuxPr.Name, Temp2, ltCode);
                    For J := Temp2.Count - 1 downto 0 do
                    with  FDMCalc do
                      begin
                       if quFmla.Locate( 'NAME',Temp2.Strings[J], [] ) then
                          Escopo := quFmla.FieldByName( 'DESCRICAO' ).AsString + '. ' + Escopo
                       else if quTab.Locate( 'NAME', Temp2.Strings[J], [] ) then
                          Escopo := quTab.FieldByName( 'DESCRICAO' ).AsString + '. ' + Escopo;
                      end;
                 end
              else
                 Estado := psInvisible;
           end;
        end;
     end;
   // Limpando da memoria os calculos de validacao
   For I := 0 to Temp.Count - 1 do
      begin
         AuxCx := FMemoria.FindComponent( 'cx' + Temp.Strings[I] );
         if ( AuxCx <> nil ) and ( AuxCx is TCaixa ) then
            AuxCx.Free;
      end;
   Temp.Free;
   Temp2.Free;
end;

end.

