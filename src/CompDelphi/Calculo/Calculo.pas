{ Faz calculo do procedimento corrente (FNomeProv) }
function TCalculo.CalcProc: Boolean;
var
   I,
   iParamIndex : integer;
   bExecutar : byte;
   mdMed : TMedida;
begin
   FListaMedida.Clear;
   FDicionario.ClearDeepList;
   FListaCalculo.Clear;
   FDMCalc.flFormula.LimparParametros ;
   FDMCalc.tbTabela.LimparParametros;
   if not Fdicionario.ListAll( FNomeProc, FListaCalculo ) then
      begin
         Result := False;
         exit;
      end;
   bExecutar := 0;
   iParamIndex := 0;
   with  FDMCalc do
   begin
     { Perform the component operation }
     for I := 0 to FListaCalculo.Count - 1 do
     begin
        if quFmla.Locate( 'NAME', FListaCalculo[I], [] ) then
           begin
              // Executa Formula ou Tabela
              Result:=ExecFuncaoPendente (bExecutar);
              if not Result then
                 exit;
              flFormula.Formula := quFmla.FieldByName( 'Expressao' ).AsString;
              flFormula.AceitaParametrosInvalidos := ( quFmla.FieldByName( 'ACEITAPARAMINVALIDO' ).AsString = 'T' );
              bExecutar := 1;
              iParamIndex := 0;
           end
        else if quTab.Locate( 'NAME', FListaCalculo[I], [] ) then
           begin
              // Executa Formula ou Tabela
              Result:=ExecFuncaoPendente (bExecutar);
              if not Result then
                 exit;
              tbTabela.Condicao := quTab.FieldByName( 'Expressao' ).AsString;
              if quTab.FieldByName( 'DataBaseName' ).AsString = '' then
                 tbTabela.DataBaseName := self.Database.DatabaseName;
              tbTabela.NomeTabela := quTab.FieldByName( 'NomeTabela' ).AsString;
              tbTabela.CampoResult := quTab.FieldByName( 'CampoResult' ).AsString;
              tbTabela.AceitaParametrosInvalidos := (quFmla.FieldByName( 'ACEITAPARAMINVALIDO' ).AsString = 'T');
              tbTabela.ModoPesquisa := TModoPesquisa( GetEnumValue( TypeInfo( TModoPesquisa ), quTab.FieldByName( 'MODOPESQUISA' ).AsString ) );
              bExecutar := 2;
              iParamIndex := 0;
           end
        else if taMed.Locate( 'NAME', FListaCalculo[I], [] ) then
           begin
             if FMemoria.Acha(FListaCalculo[I], TObject( mdMed )) then
             begin
              if bExecutar = 1 then
                 Case iParamIndex of
                      0 : flFormula.Resultado := mdMed;
                      1 : flFormula.A := mdMed;
                      2 : flFormula.B := mdMed;
                      3 : flFormula.C := mdMed;
                      4 : flFormula.D := mdMed;
                      5 : flFormula.E := mdMed;
                      6 : flFormula.t := mdMed;
                      7 : flFormula.X := mdMed;
                      8 : flFormula.Y := mdMed;
                 end
              else
                 Case iParamIndex of
                      0 : tbTabela.Resultado := mdMed;
                      1 : tbTabela.A := mdMed;
                      2 : tbTabela.B := mdMed;
                      3 : tbTabela.C := mdMed;
                      4 : tbTabela.D := mdMed;
                      5 : tbTabela.E := mdMed;
                 end;
              Inc( iParamIndex );
             end;
           end;
     end;
     // Executa ultima Formula ou Tabela
     Result := ExecFuncaoPendente (bExecutar);
     if not Result then
        exit;
   end;
end;

{ Conecta o dicionario e as tabelas }
function TCalculo.ConnectCalculo(User, Password: String): Boolean;
begin
   Result := True;
   // Se ha' dicionario e Active mudou valor
   if Assigned (FDicionario) and not(FDicionario.Connected) then
      // Conecta dicionario e abre tabelas contendo os atributos das
      // instancias que o dicionario referencia
      if FDicionario.ConnectDictionary(User, Password) then
         with FDMCalc do
         begin
            taMed.Open;
            taDescritor.Open;
            quFmla.Open;
            quTab.Open;
            TMedida.SetListaCnst(TStringList(FConstantes));
            Result := (taMed.Active and quFmla.Active and quTab.Active and taDescritor.Active);
         end
      else
         Result := False;
end;

constructor TCalculo.Create(AOwner: TComponent);
begin
   inherited Create(AOwner);
   { Cria DataModule das Tabelas }
   FDMCalc := TDMCalc( Application.FindComponent( 'DMCalc' ) );
   if ( FDMCalc = nil ) then
      begin
         FDMCalc := TDMCalc.Create( Application );
         FDMCalc.FreeNotification(self);
      end;
   //Set default values
   FTipoListaProc := tpCode;
   // Cria Listas
   FProcedimentos := TStringList.Create;
   FListaCalculo := TStringList.Create;
   FListaMedida := TStringList.Create;
   FListaParametro := TStringList.Create;
   FConstantes := TStringList.Create;
   FLog := TStringList.Create;
end;

function TCalculo.CriaListaProc(const Memoria: TMemoria; const NomeCaixa,
  NomeCalculo: String; const EstadoProcDefault: TProcState): Boolean;
var
   ListaDescrProc : TStringList;
   AuxCx : TCaixa;
   prProc : TProcedimento;
   I : Integer;
   Code : WideString;
begin
   Result := False;
   // Conecta dicionario (ROM)
   if Assigned (FDicionario) and ConnectCalculo(FDicionario.IDUsuario, FDicionario.SenhaUsuario) then
   begin
      // Cria Procedimentos
      AuxCx := TCaixa.Create( Memoria );
      AuxCx.Name := NomeCaixa;
      AuxCx.Descricao := 'Lista de Procedimentos';
      ListaDescrProc := TStringList.Create;
      if (Assigned (FDicionario) and (FDicionario.CollectListInstances( NomeCalculo, ListaDescrProc ))) then
      begin
         For I := 0 to ListaDescrProc.Count - 1 do
         begin
             prProc := TProcedimento.Create(AuxCx);
             with prProc do
             begin
                FDicionario.FindCodeByDescription(Code,ListaDescrProc.Strings[I]);
                Name := Code;
                Descricao := ListaDescrProc.Strings[I];
                Estado := EstadoProcDefault;
             end;
         end;
         Result := True;
      end;
      ListaDescrProc.Free;
   end;
end;

{ Cria medidas do procedimento corrente (FNomeProc) }
function TCalculo.CriaMed(Categoria: string): Boolean;
var
   I : integer;
   mdMed : TMedida;
   ClasseMedida : string;
begin
   FListaMedida.Clear;
   FDicionario.ClearDeepList;
   if not FDicionario.CollectAllInstances( FNomeProc, FListaMedida ) then
      begin
         Result := False;
         ShowMessage( 'Erro na coleta das medidas! (TCalculo: 344)' );
         exit;
      end
   else
      begin
         Result := True;
      end;
   For I := 0 to FListaMedida.Count - 1 do
   begin
     if not FMemoria.Acha( FListaMedida.Strings[I], TObject( mdMed ) ) then
     begin
        TAttributedDic(FDicionario).GetAttributeByCode(FListaMedida.Strings[I], 'CLASSE', ClasseMedida);
        //Default : TMedida
        if ClasseMedida = '' then
           ClasseMedida := TMedida.ClassName;
        try
           mdMed := TMedidaClass(GetClass(ClasseMedida)).Create(nil);
        except
           on E : Exception do ShowMessage(E.Message);
        end;
        mdMed.Name := FListaMedida.Strings[I];
        //So pra depuracao
        ClasseMedida := mdMed.ClassName;
        with FDMCalc do
        begin
           if taMed.Locate( 'NAME', FListaMedida[I], [] ) then
              begin
                 mdMed.Descricao := taMed.FieldByName( 'DESCRICAO').AsString;
                 mdMed.ValorNumerico := taMed.FieldByName( 'VALORDEFAULT').AsString;
                 mdMed.Unidade := taMed.FieldByName( 'UNIDADEDEFAULT').AsString;
                 mdMed.Precisao := taMed.FieldByName( 'PRECISAO').AsInteger;
                 mdMed.Valid := (taMed.FieldByName( 'VALID' ).AsString = 'T');
              end
           else
              begin
                 mdMed.Unidade := '';
              end;
        end;
        // Seta a propriedade do descritor se a medida for criada ou já existir
        mdMed.Descritor := GetDescritor( mdMed.Name );
        // Atenção!!! quando adiciono, faz-se uma cópia de mdMed para a memoria
        // mdMed pode ser destruida.
        FMemoria.Adiciona( mdMed.Name, TObject( mdMed ), 'cx' + Categoria );
        if mdMed <> nil then
           mdMed.Free;
     end;
   end;
   for I := 0 to FListaMedida.Count - 1 do
       if FMemoria.Acha( FListaMedida.Strings[I], TObject( mdMed ) ) then
          begin
             if FListaParametro.IndexOf (FListaMedida.Strings[I]) = -1 then
                FListaParametro.AddObject( FListaMedida.Strings[I], TObject( mdMed ) );
          end
       else
          ShowMessage( 'Erro, medida nao foi criada! (TCalculo: 379)' );
end;

function TCalculo.ListaMedidasProcedimentos( var LstMedProc: TStringList): Integer;
var
   I : Integer;
begin
   LstMedProc.Clear;
   if not Assigned( LstMedProc ) then
   begin
      Result := -1;
      exit;
   end;
   if not ( FDicionario.Connected ) or ( FMemoria = nil ) then
      begin
         Result := -2;
         exit;
      end;
   for I := 0 To FProcedimentos.Count - 1 do
   begin
      if SetNomeProc( FProcedimentos[I] ) then
      begin
         FDicionario.ClearDeepList;
         if not FDicionario.CollectAllInstances( FNomeProc, LstMedProc ) then
         begin
            Result := -3;
            LstMedProc.Clear;
            exit;
         end;
      end;
   end;
   Result := FProcedimentos.Count;
end;

{ Cria os TMedidas necessarios para executar a lista de Procedimentos,
  se nao conseguir retorna da mesma forma que Execute }
function TCalculo.CriaMedidas: Integer;
var
   I : Integer;
   AuxCx : TCaixa;
   Code, Description : WideString;
begin
   FListaParametro.Clear;
   if not ( FDicionario.Connected ) or ( FMemoria = nil ) then
      begin
         Result := -1;
         exit;
      end;
   for I := 0 To FProcedimentos.Count - 1 do
   begin
      if SetNomeProc( FProcedimentos[I] ) then
         begin
            if not CriaMed(FNomeProc) then
               begin
                  Result := I;
                  exit;
               end;
            // Provavelmente, CriaMed criou a caixa do calculo. Então eu coloco a descricao
            Code := FNomeProc;
            if FDicionario.FindDescriptionByCode( Code, Description ) then
               if FMemoria.Acha('cx' + FNomeProc,TObject(AuxCx)) and ( AuxCx.Descricao = '' ) then
                  AuxCx.Descricao := Description;
         end;
   end;
   Result := FProcedimentos.Count;
end;

