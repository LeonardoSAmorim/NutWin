end;

{ desconecta o dicionario e as tabelas }
procedure TCalculo.DisconnectCalculo;
begin
   // Se ha' dicionario e Active mudou valor
   if Assigned (FDicionario) and (FDicionario.Connected) then
      begin
         // Desconecta dicionario e abre tabelas contendo os atributos das
         // instancias que o dicionario referencia
         FDicionario.DisconnectDictionary;
         with FDMCalc do
         begin
            taMed.Close;
            taDescritor.Close;
            quFmla.Close;
            quTab.Close;
         end;
      end;
end;

function TCalculo.EncheListas(Caixa: String; Procedimentos, Medidas, Resultados: TStringList): Boolean;
var
   AuxCx,
   AuxPr : TComponent;
   I : Integer;
   Temp : TStringList;
   TipoMed : String;
   mdMedTemp : TMedida;
   DescrProcAtual : String;
begin
   Procedimentos.Clear;
   Medidas.Clear;
   Medidas.Sorted := True;
   Medidas.Duplicates := dupIgnore	;
   Resultados.Clear;
   Resultados.Sorted := True;
   Resultados.Duplicates := dupIgnore	;
   Temp := TStringList.Create;
   Result := False;
   AuxCx := nil;
   if Assigned(FMemoria) then
      AuxCx := FMemoria.FindComponent( Caixa );
   if Assigned( AuxCx ) then
    if ( AuxCx is TCaixa ) then
     with (AuxCx as TCaixa ) do
     begin
        For I := 0 to AuxCx.ComponentCount - 1 do
        begin
           AuxPr := AuxCx.Components[I];
           if ( AuxPr is TProcedimento ) then
           with (AuxPr as TProcedimento ) do
           begin
              if Estado = psChecked then
                begin
                 Procedimentos.AddObject( Descricao, AuxPr );
                 Temp.AddObject( Descricao, AuxPr );
                 if Assigned (FDicionario) then
                    TCacheDic( FDicionario ).CollectAllInstances( Name, Temp );
                end;
              Result := True;
           end;
        end;
     end;
     For I := 0 to Temp.Count - 1 do
     begin
        if Temp.Objects[I] is TProcedimento then
          begin
             DescrProcAtual := Temp.Strings[I];
          end
        else if Assigned (FDicionario) and TAttributedDic( FDicionario ).GetAttributeByCode (Temp.Strings[I], 'TIPO', TipoMed) then
          begin
           if Assigned (FMemoria) and FMemoria.Acha( Temp.Strings[I], TObject( mdMedTemp ) ) then
             begin
              if TipoMed = 'MEDIDA' then
                 Medidas.AddObject( mdMedTemp.Descricao, mdMedTemp )
              else if TipoMed = 'RESULTADO' then
                 Resultados.AddObject( mdMedTemp.Descricao, mdMedTemp )
              else if TipoMed = 'PARAMETRO' then
                 mdMedTemp.Printable := False;
             end;
          end;
     end;
     Temp.Free;
end;

function TCalculo.ExecFuncaoPendente(bExecutar: byte): Boolean;
begin
  Result := True;
  with FDMCalc do
  begin
   if bExecutar = 1 then
      begin
         try
            AddLog( flFormula );
            flFormula.Execute
         except
            on E: Exception do
               begin
                  TratErroFmla(FDMCalc.flFormula, E);
                  Result := False;
                  flFormula.LimparParametros;
                  exit;
               end;
         end;
         flFormula.LimparParametros;
      end
   else if bExecutar = 2 then
      begin
         try
            AddLog( tbTabela );
            tbTabela.Execute;
         except
            on E: Exception do
               begin
                  TratErroTbla(FDMCalc.tbTabela, E);
                  Result := False;
                  tbTabela.LimparParametros;
                  exit;
               end;
         end;
         tbTabela.LimparParametros;
      end;
   end;
end;

{ Executa a Lista de Procedimentos encontrada em Procedimentos,
  retornando: o tamanho da lista se todos os procedimentos foram
  calculados com sucesso ou o número de procedimentos clculados. }
// &&& A pedido do Meide não abortar cálculos se um der errado, em 12/04/2001
function TCalculo.Execute(CaixaProc: TCaixa): Integer;
var
   I : Integer;
   ProcComErro : TProcedimento;
begin
   Result := 0;
   if not (FDicionario.Connected) or (FMemoria = nil) then
      begin
         Result := -1;
         exit;
      end;
   for I := 0 To CaixaProc.ComponentCount - 1 do
   begin
      FNomeProc:= CaixaProc.Components[I].Name;
      if CalcProc then
         Inc( Result )
      else
         begin
            if Assigned(FMemoria) then
               begin
                  if FMemoria.Acha(FNomeProc,TObject(ProcComErro)) then
                     FLog.Add( 'Erro no procedimento :' + ProcComErro.Descricao)
                  else
                     FLog.Add( 'Erro em procedimento indeterminado') ;
                  end;
         end;
   end;
   // Limpa "registradores" para o proximo calculo não dar problema
   Fprocedimentos.Clear;
end;

function TCalculo.Execute: Integer;
var
   I : Integer;
   ProcComErro : TProcedimento;
begin
   Result := 0;
   if not ( FDicionario.Connected ) or ( FMemoria = nil ) then
      begin
         Result := -1;
         exit;
      end;
   for I := 0 To FProcedimentos.Count - 1 do
     begin
       if SetNomeProc( FProcedimentos[I] ) then
       begin
          if CalcProc then
             Inc( Result )
          else
            begin
               if Assigned(FMemoria) then
                  begin
                     if FMemoria.Acha(FProcedimentos[I], TObject(ProcComErro)) then
                        FLog.Add( 'Erro no procedimento :' + ProcComErro.Descricao)
                     else
                        FLog.Add( 'Erro em procedimento indeterminado') ;
                  end;
            end;
       end;
     end;
   // Limpa "registradores" para o proximo calculo não dar problema
   Fprocedimentos.Clear;
end;

procedure TCalculo.FiltraCalculo(const MemoriaCfg: TMemoria; const NomeCaixa: String);
var
   AuxCxMem,
   AuxPrMem,
   AuxCxCfg,
   AuxPrCfg : TComponent;
   I : Integer;
begin
   AuxCxMem := FMemoria.FindComponent( NomeCaixa );
   AuxCxCfg := MemoriaCfg.FindComponent( NomeCaixa );
   if Assigned( AuxCxMem ) and Assigned( AuxCxCfg ) then
     if ( AuxCxMem is TCaixa ) and ( AuxCxCfg is TCaixa )then
        For I := 0 to AuxCxMem.ComponentCount - 1 do
        begin
           AuxPrMem := AuxCxMem.Components[I];
           if Assigned( AuxPrMem ) then
              if ( AuxPrMem is TProcedimento ) then
              begin
                 AuxPrCfg := AuxCxCfg.FindComponent( TProcedimento( AuxPrMem ).Name );
                 if Assigned( AuxPrCfg ) then
                    if ( AuxPrCfg is TProcedimento ) then
                        if ( TProcedimento( AuxPrCfg ).Estado = psInvisible ) and
                           ( TProcedimento( AuxPrMem ).Estado <> psChecked ) then
                           TProcedimento( AuxPrMem ).Estado := psInvisible;
              end;
        end;
end;

function TCalculo.GetDescritor(const MedidaName: String): TDescritorQuantitativo;
var
   dqDescritor : TDescritorQuantitativo;
   cxDescritores : TCaixa;
begin
   Result := nil;
   with FDMCalc do
   if taMed.Locate( 'NAME', MedidaName, [] ) then
     begin
       // Aqui eu transformo o nome do descritor pelo ponteiro
       if taDescritor.Locate( 'NAME', taMed.FieldByName( 'DESCRIPTORNAME' ).AsString, [] ) then
          begin
             if not FMemoria.Acha( taMed.FieldByName( 'DESCRIPTORNAME' ).AsString, TObject(dqDescritor) ) then
                begin
                   if not FMemoria.Acha( 'cxDescritores', TObject( cxDescritores ) ) then
                     begin
                         cxDescritores := TCaixa.Create( FMemoria );
                         cxDescritores.Name := 'cxDescritores';
                         cxDescritores.Descricao := 'Descritores das Medidas';
                      end;
                   dqDescritor := TDescritorQuantitativo.Create(cxDescritores);
                   dqDescritor.Name := taDescritor.FieldByName( 'NAME' ).AsString;
                   dqDescritor.ProcedimentoDeValidacao := taDescritor.FieldByName( 'NOMEPROCEDIMENTO' ).AsString;
                   dqDescritor.MedidaDeValidacao := taDescritor.FieldByName( 'MEDIDAVALNAME' ).AsString;
                   dqDescritor.NewValidate := NewValidate;
                end;
             // Caso tenha perdido na persistencia
             if not Assigned( dqDescritor.NewValidate ) then
                dqDescritor.NewValidate := NewValidate;
             Result := dqDescritor;
          end;
     end;
end;

function TCalculo.GetDicionario: TNewDic;
begin
   Result := TNewDic(FDicionario);
end;

procedure TCalculo.Loaded;
begin
   inherited Loaded;
   // Atualiza o DM do pai
   DM := FDMCalc;
end;

procedure TCalculo.NewValidate(Sender: TObject; var Valid: Boolean);
var
   AuxProc : TStringList;
   mdValid : TMedida;
begin
   // Considera que a medida é valida
   Valid := True;
    // Backup dos procedimentos atuais
   AuxProc := TStringList.Create;
   AuxProc.Assign( FProcedimentos );
   FProcedimentos.Clear;
   // Executa validação
   FProcedimentos.Add( TDescritorQuantitativo( Sender ).ProcedimentoDeValidacao );
   CriaMedidas;
   Execute;
   // Restore do procedimentos atuais
   FProcedimentos.Assign( AuxProc );
   AuxProc.Free;
   // Pega rsultado da validação
   if FMemoria.Acha( TDescritorQuantitativo( Sender ).MedidaDeValidacao, TObject( mdValid ) ) then
      begin
          Valid := ( mdValid.AsFloat <> 0 );
          if not Valid then
             ShowMessage( 'Medida inválida' );
      end;    
end;

procedure TCalculo.Notification(AComponent: TComponent; Operation: TOperation);
begin
   inherited Notification(AComponent, Operation);
   if Operation <> opRemove then
      Exit;
   if AComponent = FDicionario then
      FDicionario := nil
   else if AComponent = FMemoria then
      FMemoria := nil
   else if AComponent = FConfiguracao then
      FConfiguracao := nil
   else if AComponent = FDMCalc then
      FDMCalc := nil
   else if AComponent = FDelayedOpIndicator then
      FDelayedOpIndicator := nil
   else if AComponent = FBackup then
      FBackup := nil;
end;

procedure TCalculo.RestoreMemoria;
begin
   if FTemBackup then
   begin
      FBackup.CopiaPara( FMemoria );
      if Assigned(FMemoria.OnModified) then
         FMemoria.OnModified(FMemoria);
      FTemBackup := False;
   end;
end;

