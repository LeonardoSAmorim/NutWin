{ Adiciona Descricao e GUID }
function TMmListBox.AddDescricaoGUID( Descricao, GUID : String; Estado : TGUIDItemState = gsNone ) : Integer;
var
   AuxGUID : TGUIDItem;
begin
   AuxGUID := TGUIDItem.Create( Owner );
   AuxGUID.Guid := GUID;
   AuxGUID.State := Estado;
   Result := Self.items.AddObject( Descricao, AuxGUID);
end;

function TMmListBox.GetGUID(Index: Integer): string;
begin
   if ( self.items.Objects[Index] is TGUIDItem ) then
      Result := TGUIDItem( self.items.Objects[Index] ).GUID
   else
      Result := '';
end;

procedure TMmListBox.PutGUID(Index: Integer; const S: string);
begin
   if ( self.items.Objects[Index] is TGUIDItem ) then
      TGUIDItem( self.Items.Objects[Index] ).GUID := S;
end;

function TMmListBox.GetDescricao(Index: Integer): string;
begin
   Result := self.Items.Strings[Index];
end;

procedure TMmListBox.PutDescricao(Index: Integer; const S: string);
