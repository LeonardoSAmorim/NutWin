procedure TMmListBox.Refresh;
var
   I : Integer;
begin
   if not assigned (FListaDeItens) then exit;

   Items.Clear;
   for I := 0 To FListaDeItens.Count - 1 do
       Items.Add( FListaDeItens.Strings[I] );

end;

procedure TMmListBox.SetListaDeItens (Value : TStringList);
     { Internal declarations for method }
begin
  if Value <> nil then
   begin
      FListaDeItens :=Value;
      Refresh;
   end
  else
    FListaDeItens :=Value;
end;

procedure TMmListBox.AtualizaMemoria;
var
   I : Integer;
begin

   if (not assigned (FListaDeItens)) then exit;

   FListaDeItens.Clear;
   for I := 0 To Items.Count - 1 do
       FListaDeItens.Add( Items[I] );

end;

procedure TMmListBox.MouseUp(Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
var
I : Integer;
begin
  inherited;
  // FFirstIndex e FLastIndex servem pra saber que item é o primeiro selecionado e o último
  // para indicar o sentido de seleção que tem que ser inverso ao for que deseleciona
  // para que funcione bem
  FFirstIndex := FLastIndex;
  FLastIndex := ItemIndex;
  if FFirstIndex >= FLastIndex then
  begin
    for I:=0 to Items.Count-1 do
      if ( Assigned( Items.Objects[I] ) and ( Items.Objects[I] is TGUIDItem ) and
           Selected[I] and (TGUIDItem( Items.Objects[I] ).State = gsDisabled) ) or
         ( Assigned( Items.Objects[I] ) and ( Items.Objects[I] is TComponent ) and
           Selected[I] and (TComponent( Items.Objects[I] ).Tag < 0) ) then
         Selected[I]:= False;
  end
  else
  begin
     for I:= Items.Count-1 downto 0  do
      if ( Assigned( Items.Objects[I] ) and ( Items.Objects[I] is TGUIDItem ) and
           Selected[I] and (TGUIDItem( Items.Objects[I] ).State = gsDisabled) ) or
         ( Assigned( Items.Objects[I] ) and ( Items.Objects[I] is TComponent ) and
           Selected[I] and (TComponent( Items.Objects[I] ).Tag < 0) ) then
          Selected[I]:= False;
  end;
end;

procedure TMmListBox.DrawItem(Index: Integer; Rect: TRect; State: TOwnerDrawState);
var
  Flags: Longint;
begin
  if Assigned(OnDrawItem) then OnDrawItem(Self, Index, Rect, State) else
  begin
    Canvas.FillRect(Rect);
    if Index < Items.Count then
    begin
      Flags := DrawTextBiDiModeFlags(DT_SINGLELINE or DT_VCENTER);
      if not UseRightToLeftAlignment then
        Inc(Rect.Left, 2)
      else
        Dec(Rect.Right, 2);

      if ( Assigned( Items.Objects[Index] ) and ( Items.Objects[Index] is TGUIDItem ) and
           ( TGUIDItem( items.Objects[Index] ).State = gsDisabled ) ) or
          ( Assigned( Items.Objects[Index] ) and ( Items.Objects[Index] is TComponent ) and
           ( TComponent( items.Objects[Index] ).Tag < 0 ) ) then
         Canvas.Font.Color := clGray;

      DrawText(Canvas.Handle, PChar(Items[Index]), Length(Items[Index]), Rect,
        Flags);
    end;
  end;
end;


