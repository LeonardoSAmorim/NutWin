function TMontaLista.EncheListas: Boolean;
var
   AuxCx,
   AuxPr : TComponent;
   I : Integer;
begin
   FEntrada.Clear;
   FSaida.Clear;
   Result := False;
   AuxCx := FMemoria.FindComponent( FNomeCaixa );
   if Assigned( AuxCx ) then
    if ( AuxCx is TCaixa ) then
     with (AuxCx as TCaixa ) do
     begin
        For I := 0 to AuxCx.ComponentCount - 1 do
        begin
           AuxPr := AuxCx.Components[I];
           if ( AuxPr is TProcedimento ) then
           with (AuxPr as TProcedimento ) do
           begin
              if Estado = psChecked then
                 FSaida.Items.AddObject( Descricao, AuxPr )
              else if ( Estado <> psInvisible ) and ( Estado <> psHidden ) then
                 FEntrada.Items.AddObject( Descricao, AuxPr );
              Result := True;
           end;
        end;
     end;
end;

function TMontaLista.PodeMoverPara(Destino: TDestino; Index : Integer): Boolean;
begin
   Result := True;
   if ( FEntrada is TcxListBox ) and ( FSaida is TcxListBox ) then
   begin
     if Destino = dsSaida then
       begin
        if TProcedimento( FEntrada.Items.Objects[Index] ).Estado = psDisabled then
           begin
              ErroAoMover( FEntrada.Items.Strings[Index], Destino );
              Result := False;
           end
        else
           TProcedimento( FEntrada.Items.Objects[Index] ).Estado := psChecked;
       end
     else if Destino = dsEntrada then
        TProcedimento( Saida.Items.Objects[Index] ).Estado := psNone;
   end
   else if FAutoExclusive then
   begin
      // Não deixa passar itens de tipos diferentes
      if ( Destino = dsEntrada ) and
              ( Index < FSaida.Items.Count ) and
              ( Assigned( FSaida.Items.Objects[Index] ) ) and
              ( FSaida.Items.Objects[Index] is TGUIDItem ) and
              ( FEntrada.Items.Count > 0 ) and
              ( TGUIDItem( FEntrada.Items.Objects[0] ).Exclusive <>
                TGUIDItem( FSaida.Items.Objects[Index] ).exclusive ) then
              begin
                 ErroAoMover( FSaida.Items.Strings[Index], Destino );
                 Result := False;
              end
      // não deixa passar items tipo TComponente da Saida para a Entrada
      else if ( FEntrada is TMmListBox ) and
              ( FSaida is TMmListBox ) and
              ( Index < FSaida.Items.Count ) and
              Assigned( FSaida.Items.Objects[Index] ) and
              ( FSaida.Items.Objects[Index] is TComponent )then
              begin
                 if Destino = dsEntrada then
                 begin
                    if TComponent( FSaida.Items.Objects[Index] ).Tag < 0 then
                    begin
                       ErroAoMover( FSaida.Items.Strings[Index], Destino );
                       Result := False;
                    end;
                 end;
              end
      // gerencia a regra, pois as excessões já fora tratadas acima
      else if ( FEntrada is TMmListBox ) and
              ( FSaida is TMmListBox ) and
              ( Index < FEntrada.Items.Count ) and
              Assigned( FEntrada.Items.Objects[Index] ) and
              ( FEntrada.Items.Objects[Index] is TGUIDItem )then
              begin
                 if Destino = dsSaida then
                 begin
                    if TGUIDItem( FEntrada.Items.Objects[Index] ).State = gsDisabled then
                    begin
                       ErroAoMover( FEntrada.Items.Strings[Index], Destino );
                       Result := False;
                    end
                    else
                       TGUIDItem( FEntrada.Items.Objects[Index] ).State := gsChecked;
                 end
                 else if Destino = dsEntrada then
                    TGUIDItem( Saida.Items.Objects[Index] ).State := gsNone;
              end;
   end;
end;

