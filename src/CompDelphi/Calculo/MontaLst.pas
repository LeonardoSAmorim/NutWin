{ Move o(s) item(ns)  elecionado(s) da saida para a de entrada }
procedure TMontaLista.MoveParaEntrada;
     { Internal declarations for method }
     { type }
     { . . . }
     { var }
     { . . . }
var
   I, J : Integer;
   Item : string;
   Objeto : TObject;
   Moveu : Boolean;
begin
   Moveu := False;
   AntesDeMover;
   J := FEntrada.Items.Count;
   for I := FSaida.Items.Count - 1 DownTo 0 do
     if FSaida.Selected[I] and PodeMoverPara( dsEntrada, I ) then
     begin
        Item:=FSaida.Items.Strings[I];
        Objeto:= FSaida.Items.Objects[I];
        Moveu := True;

        AntesDeMoverItem( Item, dsEntrada );
        FEntrada.Items.InsertObject(J, Item, Objeto );
        FSaida.Items.Delete( I );
        DepoisDeMoverItem( Item, dsEntrada );
     end;
   if Moveu then
      DepoisDeMover;
end;

procedure TMontaLista.MoveParaEntrada(const Value: Integer);
var
   J : Integer;
   Item : string;
   Objeto : TObject;
   Moveu : Boolean;
begin
   Moveu := False;
   AntesDeMover;
   J := FEntrada.Items.Count;
   if ( Value <= ( FSaida.Items.Count - 1 ) ) and ( Value >= 0 ) and PodeMoverPara( dsEntrada, Value ) then
   begin
        Item:=FSaida.Items.Strings[Value];
        Objeto:= FSaida.Items.Objects[Value];
        Moveu := True;

        AntesDeMoverItem( Item, dsEntrada );
        FEntrada.Items.InsertObject(J, Item, Objeto );
        FSaida.Items.Delete( Value );
        DepoisDeMoverItem( Item, dsEntrada );
   end;
   if Moveu then
      DepoisDeMover;
end;

