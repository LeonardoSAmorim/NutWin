procedure TCxListBox.MouseUp(Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
var
I : Integer;
begin
  inherited;
  // FFirstIndex e FLastIndex servem pra saber que item é o primeiro selecionado e o último
  // para indicar o sentido de seleção que tem que ser inverso ao for que deseleciona
  // para que funcione bem
  FFirstIndex := FLastIndex;
  FLastIndex := ItemIndex;
  if FFirstIndex >= FLastIndex then
  begin
     for I:=0 to Items.Count-1 do
       if Selected[I] and (TProcedimento( Items.Objects[I] ).Estado = psDisabled) then
          Selected[I]:= False;
  end
  else
  begin
     for I:= Items.Count-1 downto 0  do
       if Selected[I] and (TProcedimento( Items.Objects[I] ).Estado = psDisabled) then
          Selected[I]:= False;
  end;
end;

procedure TCxListBox.DrawItem(Index: Integer; Rect: TRect; State: TOwnerDrawState);
var
  Flags: Longint;
begin
  if Assigned(OnDrawItem) then OnDrawItem(Self, Index, Rect, State) else
  begin
    Canvas.FillRect(Rect);
    if Index < Items.Count then
    begin
      Flags := DrawTextBiDiModeFlags(DT_SINGLELINE or DT_VCENTER);
      if not UseRightToLeftAlignment then
        Inc(Rect.Left, 2)
      else
        Dec(Rect.Right, 2);

      if TProcedimento( items.Objects[Index] ).Estado = psDisabled then
         Canvas.Font.Color := clGray;

      DrawText(Canvas.Handle, PChar(Items[Index]), Length(Items[Index]), Rect,
        Flags);
    end;
  end;


end;

