procedure DigitaValor (Display : TControl; Valor : string);
var
   QGambe : TMyCustEdit;
   XGambe : TMyControl;
   MyClp : TClipboard;
begin
   MyClp:=Clipboard;
   if Display <> nil then
   begin
      if (Display is TCustomEdit) then
      begin
         QGambe := TMyCustEdit(Display);
         if QGambe.ReadOnly then
            QGambe.Text:= Valor
         else
         begin
            MyClp.AsText := Valor;
            QGambe.SelStart := 0;
            QGambe.SelLength := Length(QGambe.Text);
            QGambe.PasteFromClipboard;
         end;
      end
      else
      begin
         XGambe := TMyControl (Display);
         XGambe.Text := Valor;
      end;
   end;
end;

end.
