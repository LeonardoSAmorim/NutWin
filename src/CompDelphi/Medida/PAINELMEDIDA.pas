procedure TPainelMedida.Update;
var
   NewValue,NewUnit: string;
begin
   inherited Update;
   if (not assigned(FMedida)) or (not assigned(FEntradaNumerica)) or
      (not Modified) or (not assigned (FEntradaDeUnidade)) then exit;
