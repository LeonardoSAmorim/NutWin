procedure TPainelMedida.SetMedida (Value : TMedida);
begin
   if Value <> nil then
   begin
      Value.FreeNotification(Self);
      FMedida := Value;
      Refresh;
   end
   else
      FMedida := Value;
end;

procedure TPainelMedida.Refresh;
begin
   if not assigned (FMedida) then
      exit;
   if (assigned(FSaidaDescricao)) then
   begin
      //Prepare Valores Numericos - TMaskEdit
      if (FSaidaDescricao is TLabel) then
      begin
         (FSaidaDescricao as TLabel).Caption := FMedida.Descricao;
      end
      else if (FSaidaDescricao is TQRLabel) then
      begin
         (FSaidaDescricao as TQRLabel).Caption := FMedida.Descricao;
      end;
   end;
   if (assigned(FEntradaNumerica)) then
   begin
      //Prepare Valores Numericos - TMaskEdit
      if (FEntradaNumerica is TMaskEdit) then
      begin
         (FEntradaNumerica as TMaskEdit).EditMask := FMedida.MascaraNumeros;
         (FEntradaNumerica as TMaskEdit).Text := FMedida.ValorNumerico; // Apresentacao;
      end;
      //Prepare Valores Numericos - O resto
      PrepareValores (FEntradaNumerica, FMedida.ListaValores, FMedida.ValorNumerico, FMedida.ValorApresentacao,FMedida.IdxVDefault );
   end;
   if (assigned(FEntradaDeUnidade)) then
      //Prepare Unidades (nao usam mascara)
      if ( FEntradaNumerica is TLabel ) then // a unidade tem que ser de apresentação
         PrepareValores(FEntradaDeUnidade, FMedida.ListaUnidades, FMedida.Unidade, FMedida.UnidadeApresentacao,FMedida.IdxUDefault )
      else // a unidade não é de apresentação, pois senão daria unidade em branco (mais uma gamby)
         PrepareValores(FEntradaDeUnidade, FMedida.ListaUnidades, FMedida.Unidade, FMedida.Unidade,FMedida.IdxUDefault );

   Mode := Convert;
end;

// PrepareValores: Atualiza os controls segundo o seu tipo
procedure TPainelMedida.PrepareValores (DisplayValor: TControl; ListaValores: TStrings; Valor, ValorApresentacao: string;IdxDefault:Integer) ;
var
   YGambe : TMyCustComboBox;
   ZGambe : TMyCustListBox;
   WGambe : TMyCustEdit;
begin
   if (DisplayValor is TCustomListBox) then
   begin
      ZGambe := TMyCustListBox(DisplayValor);
      ZGambe.Items.BeginUpdate;
      try
         ZGambe.Items.Assign (ListaValores);
         if Valor <> '' then
            ZGambe.ItemIndex := ZGambe.Items.IndexOf(Valor)
         else
            ZGambe.ItemIndex := IdxDefault;
      finally
         ZGambe.Items.EndUpdate;
      end;
   end
   else if (DisplayValor is TCustomComboBox) then
      begin
         YGambe := TMyCustComboBox(DisplayValor);
         YGambe.Items.BeginUpdate;
         try
            if YGambe.Items.Count = 0 then
               YGambe.Items.Assign (ListaValores);
            YGambe.Style := csDropDownList;
            if Valor <> '' then
               YGambe.ItemIndex := YGambe.Items.IndexOf(Valor)
            else
               YGambe.ItemIndex := IdxDefault;
         finally
            YGambe.Items.EndUpdate;
         end;
      end
   else if (DisplayValor is TQRLabel) then
      (DisplayValor as TQRLabel).Caption := ValorApresentacao
   else if (DisplayValor is TFnpNumericEdit) then
      begin
         if (DisplayValor is TFnpNEditBlank) then
            try
               if  Valor <> '' then
               begin
                  (DisplayValor as TFnpNEditBlank).AsFloat := StrToFloat(Valor);
               end;
            except
               on EConvertError do ShowMessage('Valor inválido : ' + Valor);
            end
         else
            try
               (DisplayValor as TFnpNumericEdit).AsFloat := StrToFloat (Valor);
            except
               on EConvertError do ShowMessage ('Valor não numérico : '+Valor);
            end;
      end
   else
      begin
         WGambe := TMyCustEdit(DisplayValor);
         if ( DisplayValor is TLabel ) then
            WGambe.Text := ValorApresentacao
         else
            WGambe.Text := Valor;
      end;
end;

