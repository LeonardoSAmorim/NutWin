{ TMeasurementRanges }

procedure TMeasurementRanges.AdjustPointNames;
var
   I : Integer;
   MedidaIndx : Integer;
begin
   MedidaIndx := 0;
   for I := 0 to ComponentCount-1 do
      if (Components[I] is TMedida) then
         begin
            if ((MedidaIndx mod 2)=0) then
               Components[MedidaIndx].name := Name + '_' + FRanges.Items[MedidaIndx div 2].GetDisplayName + '_Begin'
            else
               Components[MedidaIndx].name := Name + '_' + FRanges.Items[MedidaIndx div 2].GetDisplayName + '_End';
            Inc(MedidaIndx);
         end;
end;

