   FReadOnly := Sou.FReadOnly;
   FValorNumerico := Sou.FValorNumerico;
   FPrintable := Sou.FPrintable;
   InternalStgUnit := Sou.InternalStgUnit;
   InternalStgValue := Sou.InternalStgValue;
