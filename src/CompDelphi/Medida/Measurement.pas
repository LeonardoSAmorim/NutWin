function TMedida.AsFloatUnit(NewUnit: string): Double;
begin
   with TMedida.Create(nil) do
     try
        Assign(self);
        ConvertToUnit(NewUnit);
        Result := AsFloat;
     finally
        Free;
     end;
end;

