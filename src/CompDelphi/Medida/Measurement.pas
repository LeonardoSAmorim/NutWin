procedure TMedida.AssignTo(Dest: TPersistent);
begin
   if Dest is TMedida then
      begin
         TMedida(Dest).FListaUnidades.Assign(FListaUnidades);
         TMedida(Dest).FListaValores.Assign(FListaValores);
         TMedida(Dest).FDescritor := FDescritor;
         TMedida(Dest).FEstimated := FEstimated;
         TMedida(Dest).FCodigoMedida := FCodigoMedida;
         TMedida(Dest).FDescricao := FDescricao;
         TMedida(Dest).FEmpty := FEmpty;
         TMedida(Dest).FIdxUDefault := FIdxUDefault;
         TMedida(Dest).FIdxVDefault := FIdxVDefault;
         TMedida(Dest).FMascaraNumeros := FMascaraNumeros;
         TMedida(Dest).FPrecisao := FPrecisao;
         TMedida(Dest).FUnidade := FUnidade;
         TMedida(Dest).FValid := FValid;
         TMedida(Dest).FInvalidDescr := FInvalidDescr;
         TMedida(Dest).FReadOnly := FReadOnly;
         TMedida(Dest).FValorNumerico := FValorNumerico;
         TMedida(Dest).FPrintable := FPrintable;
         TMedida(Dest).InternalStgUnit := InternalStgUnit;
         TMedida(Dest).InternalStgValue := InternalStgValue;
         if TMedida(Dest).Name = '' then
            TMedida(Dest).Name := Name;
     end
  else
     inherited AssignTo(Dest);
end;

