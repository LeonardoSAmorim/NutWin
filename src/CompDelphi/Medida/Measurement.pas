constructor TMedida.Create(AOwner: TComponent);
begin
   inherited Create(AOwner);
   FListaUnidades := TStringList.Create;
   FListaValores := TStringList.Create;
   FEmpty := True; // não tirar esta linha,  pois ela arruma o default False (por causa da persistencia)
   FValid := False; // não tirar esta linha, pois ela arruma o default True (por causa da persistencia)
   FReadOnly := False;
   Estimated := False;
   FCodigoMedida := '';
   FDescricao := '';
   FDescritor := nil;
   FIdxUDefault := 0;
   FIdxVDefault := 0;
   FMascaraNumeros := '';
   FPrecisao := 0;
   FUnidade := '';
   FValorNumerico := '';
   InternalStgUnit := '';
   InternalStgValue := '';
   FPrintable := True;
end;

constructor TMedida.Create(AOwner: TComponent; AMedida: TMedida);
begin
   Create(AOwner);
   if AMedida <> nil then
      Assign(AMedida);
end;

procedure TMedida.DefineProperties(Filer: TFiler);
begin
   inherited DefineProperties(Filer);
   Filer.DefineProperty('InternalValue', ReadValue, WriteValue, (InternalStgValue<>''));
   Filer.DefineProperty('InternalUnit', ReadUnit, WriteUnit, (InternalStgUnit<>''));
end;

function TMedida.DefineStorage: Boolean;
begin
   Result := True;
end;

destructor TMedida.Destroy;
begin
   FListaUnidades.Free;
   FListaValores.Free;
   inherited Destroy;
end;

function TMedida.GetAsFloat: Double;
begin
   if not Empty then
      Result := StrToFloat(ValorNumerico)
   else
      raise EInvalidArgument.CreateFmt('Medida vazia, a medida cod:%s descricao:%s não foi preenchida',[self.name,self.descricao]);
end;

function TMedida.GetUnidadeApresentacao: String;
begin
   if not FValid then
      Result := INVALID_UNIT
   else if FEmpty then
      Result := FUnidade
   else
      Result := FUnidade;
end;

function TMedida.GetValorApresentacao: String;
var
   FormatMask : String;
begin
   if not FValid then
      Result := InvalidDescr //INVALID_VALUE
   else if FEmpty then
      Result := EMPTY_VALUE
   else
      begin
         Result := FValorNumerico;
         if Pos('.', Result) > 0 then
         begin
            Result[Pos('.', Result)] := DecimalSeparator;
            if FPrecisao = 0 then
               FormatMask := '0'
            else
               FormatMask := '0.'+ stringOfChar( '0', FPrecisao );
            Result := FormatFloat(FormatMask, StrToFloat( Result ));
         end;
      end;
end;

function TMedida.GetValorNumerico: String;
begin
   //Troca . pelo DecimalSeparator
   Result := FValorNumerico;
   if Pos('.', Result) > 0 then
      Result[Pos('.', Result)] := DecimalSeparator;
end;

function TMedida.GT(AnOperand: TMedida): Boolean;
var
   AMedida : TMedida;
begin
   if FEmpty or AnOperand.FEmpty then
      begin
         Result := False;
         exit;
      end;
   AMedida := TMedida.Create(Owner, AnOperand);
   AMedida.ConvertToUnit(FUnidade);
   Result := (AsFloat > AMedida.AsFloat);
   AMedida.free;
end;

function TMedida.GTE(AnOperand: TMedida): Boolean;
var
   AMedida : TMedida;
begin
   if FEmpty or AnOperand.FEmpty then
      begin
         Result := False;
         exit;
      end;
   AMedida := TMedida.Create(Owner, AnOperand);
   AMedida.ConvertToUnit(FUnidade);
   Result := (AsFloat >= AMedida.AsFloat);
   AMedida.free;
end;

procedure TMedida.Loaded;
begin
   inherited Loaded;
   //Levar em conta InternalStgValue pois a idade usa ele (a medida nao)
   if (InternalStgValue = '') and (FValorNumerico = '') and (FListaValores.Count <> 0) then
      ValorNumerico := FListaValores[FIdxVDefault];
   //Levar em conta InternalStgUnit pois a idade usa ele (a medida nao)
   if (InternalStgUnit = '') and (FUnidade = '') and (FListaUnidades.Count <> 0) then
      FUnidade := FListaUnidades[FIdxUDefault];
end;

procedure TMedida.Notification(AComponent: TComponent; Operation: TOperation);
begin
   inherited Notification(AComponent, Operation);
   if Operation <> opRemove then
      Exit;
   if AComponent = FDescritor then
      FDescritor := nil;
end;

