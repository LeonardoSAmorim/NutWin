procedure TMeasurementRanges.ValidateRename(AComponent: TComponent;
  const CurName, NewName: string);
begin
   if Assigned(AComponent) then
      begin
         if FPointList.IndexOf(CurName) >= 0 then
            FPointList.Delete(FPointList.IndexOf(CurName));
         if (NewName <> '') and (FPointList.IndexOf(NewName) < 0) then
            begin
               FPointList.Add(NewName);
            end;
      end;
   inherited;
end;

