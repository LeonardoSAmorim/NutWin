procedure TMedida.SetListaUnidades(Value: TStrings);
begin
   if ListaUnidades.Text <> Value.Text then
   begin
      ListaUnidades.BeginUpdate;
      try
         ListaUnidades.Assign(Value);
      finally
         ListaUnidades.EndUpdate;
      end;
   end;
end;

procedure TMedida.SetListaValores(Value: TStrings);
