   I: Integer;
   OwnedComponent: TComponent;
begin
   inherited GetChildren(Proc, Root);
   for I := 0 to ComponentCount - 1 do
      begin
         OwnedComponent := Components[I];
         if not OwnedComponent.HasParent then
            Proc(OwnedComponent);
      end;
end;

procedure TMeasurementRanges.Loaded;
var
   I : Integer;
   Temp, Obj : TComponent;
begin
   if Assigned(Owner) then
      for I := 0 to FPointList.Count-1 do
         begin
            //Procura o componente no form
            Obj := Owner.FindComponent(FPointList.Strings[I]);
            Temp := Obj;
            if not Assigned(Temp) then
               continue;
            //Tira do form
            Obj.Owner.RemoveComponent(Temp);
            //Poe no componente
            InsertComponent(Temp);
            //Acerta os Points dos Limits
            if ((I mod 2)=0) then
               FRanges.Items[I div 2].BeginPoint.Point := TMedida(Temp)
            else
               FRanges.Items[I div 2].EndPoint.Point := TMedida(Temp);
         end;
   inherited;
   AdjustPointNames;
end;

procedure TMeasurementRanges.Notification(AComponent: TComponent; Operation: TOperation);
var
   I : integer;
begin
   inherited;
   if (not Assigned(AComponent)) or (AComponent=self) then
      Exit;
   if (Operation = opRemove) and (AComponent.Owner = self) then
       if FPointList.IndexOf(AComponent.Name) > 0 then
          begin
             I := FPointList.IndexOf(AComponent.Name);
             FPointList.Delete(I);
          end;
end;

