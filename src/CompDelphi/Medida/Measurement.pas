function TMedida.SetMedida(Valor, Unidade: string): Boolean;
var
   FModifield : Boolean;
   OwnerNow : TComponent;
begin
   Result := False;
   if FReadOnly and not( csLoading in ComponentState ) then  // wgb
      raise EInvalidArgument.CreateFmt('Medida Somente para leitura, codigo: %s descricao: %s',[self.name,self.descricao])
   // Não mudou nada, portanto não precisa validar nem setar
   else if ( ValorNumerico = Valor ) and ( FUnidade = Unidade ) then  // www
      Result := True
   // Se tem um descritor, então vamos validar
   else if Assigned(FDescritor) then
      begin
         // medida vazia (com descritor) não precisa validar
         // isto deveria ser uma opcao do descritor (ValidarEmpty=True/False)
         if Trim(Valor) = '' then
         begin
            Result := True;
            exit;
         end;
         ValorNumerico := Valor;
         FUnidade := Unidade;
         FEmpty := False;
         FValid := False; // vai pra validar
         if (FDescritor.Validate(self)) then
            begin
               FValid := True;
               FModifield := ( ValorNumerico <> Valor ) or ( FUnidade <> Unidade );
               Result := True;
               // Só digo que modificou depois do assign acima
               // Esta variavel deveria ser public, mas fica pra outra versao
               if FModifield then
               begin
                  // Pra achar a memoria onde a medida está (se existir memoria)
                  OwnerNow := Owner;
                  while not ( OwnerNow is TMemoria ) and
                        not ( OwnerNow is TApplication ) do
                        OwnerNow := OwnerNow.Owner;
                  if OwnerNow is TMemoria then
                     TMemoria( OwnerNow ).AddModified;
               end;
            end
         else
            begin
               FValid := False;
            end;
      end
   else
      begin
         FModifield := ( ValorNumerico <> Valor ) or ( FUnidade <> Unidade );
         ValorNumerico := Valor;
         FUnidade := Unidade;
         FValid := True; // se não tem descritor, está válida???
         Result := True;
         // Só digo que modificou depois do assign acima
         // Esta variavel deveria ser public, mas fica pra outra versao
         if FModifield then
            begin
               // Pra achar a memoria onde a medida está (se existir memoria)
               OwnerNow := Owner;
               while not ( OwnerNow is TMemoria ) and
                     not ( OwnerNow is TApplication ) do
                     OwnerNow := OwnerNow.Owner;
               if OwnerNow is TMemoria then
                  TMemoria( OwnerNow ).AddModified;
            end;
      end;
end;

