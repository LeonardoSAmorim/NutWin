function TMeasurementInterval.GetDisplayName: string;
   function ChangeIdent(const Ident: string): string;
   const
      Alpha = ['A'..'Z', 'a'..'z', '_'];
      AlphaNumeric = Alpha + ['0'..'9'] + [' '];
   var
      I: Integer;
   begin
      Result := '';
      if (Length(Ident) = 0) then
         Result := Ident
      else
         for I := 1 to Length(Ident) do
      if (Ident[I] in AlphaNumeric) then
         Result := Result + Ident[I];
   end;
var
   I : integer;
begin
   Result := ChangeIdent( Caption );
   if ( Result = '' ) or FAutoName then
      begin
         Result := inherited GetDisplayName + inttostr(Index);
         Result := copy(Result,2,Length(Result));
      end;
   repeat
      I := Pos(' ', Result);
      if (I > 0) then
         Result [I] := '_';
   until I = 0;
end;

function TMeasurementInterval.Has(AMedida: TMedida;
  var ANearPoint: TMeasureLimit; var Percent: Double): boolean;
var
   NearBegin,
   Delta : Double;
begin
   // A medida está dentro da faixa
   if Has( AMedida ) then
   begin
      Result := True;
      // Não existe ponto próximo pois ambos são infinitos
      if FBeginPoint.FOpened and FEndPoint.FOpened then
      begin
         ANearPoint := nil;
         Percent := 0;
      end
      // O mais próximo é o EndPoint
      else if FBeginPoint.FOpened then
      begin
         ANearPoint := FEndPoint;
         Percent := 0;
      end
      // O mais próximo é o BeginPoint
      else if FEndPoint.FOpened then
      begin
         ANearPoint := FBeginPoint;
         Percent := 0;
      end
      else // calculando sobre uma faixa fechada
      begin
         Delta := FEndPoint.Point.AsFloat - FBeginPoint.Point.AsFloat;
         // Os pontos são iguais
         if Delta = 0 then
         begin
            // Por eliminação é o EndPoint
            if FBeginPoint.Excluded and not FEndPoint.Excluded then
            begin
               ANearPoint := FEndPoint;
               Percent := 100;
            end
            // Por eliminação é o BeginPoint
            else if EndPoint.Excluded and not FBeginPoint.Excluded then
            begin
               ANearPoint := FBeginPoint;
               Percent := 100;
            end
            // intervalo vazio {} Isto nunca acontecerá, mas fica como documentação
            else if EndPoint.Excluded and not FBeginPoint.Excluded then
            begin
               ANearPoint := nil;
               Percent := 0;
            end;
         end
         else
         begin
            // Quantos % a medida está do BeginPoint
            NearBegin := 100-((AMedida.AsFloat - FBeginPoint.Point.AsFloat)/Delta*100);
            // Corrigindo o valor do NearBegin quando alguma ponta for excluded
            if FBeginPoint.Excluded then
               NearBegin := NearBegin + 0.0001
            else if FEndPoint.Excluded then
               NearBegin := NearBegin - 0.0001;
            if NearBegin = 50 then // Bem no meio, não tem um próximo
            begin
               ANearPoint := nil;
               Percent := 50;
            end
            else if NearBegin > 50 then // Mais próximo do BeginPoint
            begin
               ANearPoint := FBeginPoint;
               Percent := NearBegin;
            end
            else // Mais próximo do EndPoint
            begin
               ANearPoint := FEndPoint;
               Percent := 100-NearBegin;
            end;
         end;
      end;
   end
   else
   // Não está dentro da faixa
   begin
      ANearPoint := nil;
      Percent := 0;
      Result := False;
   end;
end;

function TMeasurementInterval.Has(AMedida: TMedida): boolean;
begin
   Result := True;
   if not FBeginPoint.FOpened then
      begin
         if FBeginPoint.FExcluded then
            Result := ( Result and (AMedida.GT(FBeginPoint.Point)))
         else
            Result := ( Result and (AMedida.GTE(FBeginPoint.Point)));
      end;
   if not  FEndPoint.FOpened then
      begin
         if FEndPoint.FExcluded then
            Result := ( Result and FEndPoint.Point.GT(AMedida))
         else
            Result := ( Result and FEndPoint.Point.GTE(AMedida));
      end;
end;

