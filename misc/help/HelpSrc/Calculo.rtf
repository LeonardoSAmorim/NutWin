\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Atividade F\'edsica para Pacientes}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Devem ser escolhidos os Fatores T\'edpicos de Stress.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Como Atividade F\'edsica temos:}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls17\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Acamado}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls17\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Acamado + m\'f3vel}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls17\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Ambulante}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 A Temperatura Corporal deve ser selecionada em caso de febre.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Varia de 37oC a 41oC}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Deve ser escolhido o Tipo de Les\'e3o:}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls18\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Fator Inj\'faria}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls18\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Paciente n\'e3o complicado}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls18\ilvl0 \fi-360\li720\tx720 {\f1\fs18 P\'f3s operat\'f3rio de C\'e2ncer}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls18\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Fratura}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls18\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Sepse}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls18\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Peritonite}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls18\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Multitrauma reabilita\'e7\'e3o}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls18\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Multitrauma + Sepse}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls18\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Queimadura 30-50%}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls18\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Queimadura 50-70%}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls18\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Queimadura 70-90%}\par 
