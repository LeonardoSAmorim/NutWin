\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Introdu\'e7\'e3o}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Escopo: Adulto (> 18 anos), ambos os sexos, n\'e3o gestante, n\'e3o nutriz e Pacientes.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Fonte: Dan Linetzky Waitzberg - Nutri\'e7\'e3o Enteral e Parenteral na Pr\'e1tica Cl\'ednica, Livraria Atheneu Editora, Rio de Janeiro, S\'e3o Paulo, 1990.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 A Recomenda\'e7\'e3o de Energia para Pacientes (Fatores T\'edpicos de Stress), deve ser calculada levando em considera\'e7\'e3o a Atividade F\'edsica para Pacientes, Temperatura Corporal e Tipo de Les\'e3o.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b \'a0}\par 
