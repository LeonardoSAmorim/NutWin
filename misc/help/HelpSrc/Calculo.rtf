\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Em rela\'e7\'e3o \'e0 Recomenda\'e7\'e3o de Energia existem 3 situa\'e7\'f5es distintas:}\par 
\trowd\trgaph24\cellx259\cellx8639 
