\pard\plain\s3\sb150\sa150\sl150\qj\f1\fs20 \sb280\sa280\ql {\f1\fs24\b\i Recomenda\'e7\'e3o de Energia para Pacientes (RCP)}\par {\plain\v \f1 {\plain\xe\fs020\v {Recomenda\'e7\'e3o Cal\'f3rica para Pacientes (RCP)}}}
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls16\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Introdu\'e7\'e3o}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls16\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Fatores t\'edpicos de Stress}\par 
