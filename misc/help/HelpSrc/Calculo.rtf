\pard\plain\s4\sb100\sa100\sl100\qj\f1\fs20\b \sb280\sa280\ql {\f1\fs24\b\i O que \'e9 Plano Alimentar ?}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Tamb\'e9m conhecido com Dieta, o Plano Alimentar \'e9 uma adequa\'e7\'e3o das prefer\'eancias do indiv\'edduo \'e0s suas necessidades nutricionais.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 O programa permite que a nutricionista calcule um plano alimentar personalizado para cada indiv\'edduo. }\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0 }\par 
}
