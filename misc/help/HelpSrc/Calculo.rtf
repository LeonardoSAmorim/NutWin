\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls5\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Escopo}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls5\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Nome do Plano Alimentar}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls5\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Recomenda\'e7\'e3o de Energia}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls5\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Refei\'e7\'f5es}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls5\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Itens Alimentares / Resultados}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls5\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Observa\'e7\'e3o}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0}\par 
