\pard\plain\s1\sb250\sa250\sl250\ql\f1\fs24\b\i Conhecendo a Calculadora\par
{
\pard\plain\s2\sb200\sa200\sl200\qj\f1\fs24\b\i \sb280\sa280\ql {\f1\fs24\b\i Programa de Apoio \'e0 Nutri\'e7\'e3o}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Este programa \'e9 voltado para profissionais da \'e1rea de Nutri\'e7\'e3o e Alimenta\'e7\'e3o, auxiliando na cria\'e7\'e3o de dados Antropom\'e9tricos, Anamnese Nutricional, Exames Laboratoriais, Inqu\'e9rito e Plano Alimentar.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\field{\*\fldinst INCLUDEPICTURE "C:\\\\PROJETO\\\\NUTWIN\\\\Help\\\\HTML\\\\Calculadora\\\\PrintDoc\\\\topo.bmp" \\* MERGEFORMAT \\d}{\fldrslt {\lang1024}}}
\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0 }\par 
}
\page 
{
\pard\plain\s2\sb200\sa200\sl200\qj\f1\fs24\b\i \sb280\sa280\ql {\f1\fs24\b\i Introdu\'e7\'e3o}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 A calculadora funciona como um gerenciador de documentos (.NUT), cujo o conte\'fado consiste de um ou mais tipos de c\'e1lculos para um determinado indiv\'edduo, ou seja, um documento corresponde a um \'fanico indiv\'edduo. Os dados do indiv\'edduo s\'e3o apenas os necess\'e1rios para os c\'e1lculos, sendo os demais solicitados pelo organizador quando no armazenamento.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 As fun\'e7\'f5es de gerenciamento destes documentos podem ser acessadas pelos menus ou pelos bot\'f5es, s\'e3o elas:}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Arquivo}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls21\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Novo}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls21\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Abrir}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls21\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Fechar}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls21\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Salvar }\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls21\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Salvar como}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls21\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Sair}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 As fun\'e7\'f5es que acessam os C\'e1lculos s\'e3o as seguintes:}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 C\'e1lculos}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls22\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Antropometria}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls22\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Recomenda\'e7\'f5es de Energia}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls22\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Atividades F\'edsicas}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls22\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Especiais}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls22\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Prepara\'e7\'e3o}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls22\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Inqu\'e9rito de Consumo}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls22\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Plano Alimentar}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls22\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Calcular}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls22\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Visualizar}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Os c\'e1lculos podem ter a sua opera\'e7\'e3o ou sa\'edda configurada pelas seguintes fun\'e7\'f5es:}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Configurar}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls23\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Antropometria}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls23\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Nutrientes}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 A ajuda \'e9 um manual on-line do sistema:}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Ajuda}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls24\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Conte\'fado}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls24\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Sobre}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\field{\*\fldinst INCLUDEPICTURE "C:\\\\PROJETO\\\\NUTWIN\\\\Help\\\\HTML\\\\Calculadora\\\\PrintDoc\\\\topo.bmp" \\* MERGEFORMAT \\d}{\fldrslt {\lang1024}}}
\par 
}
\page 
{
\pard\plain\s2\sb200\sa200\sl200\qj\f1\fs24\b\i \sb280\sa280\ql {\f1\fs24\b\i Abrindo um arquivo }\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Permite carregar do disco um c\'e1lculo gravado previamente. }\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Selecione o arquivo desejado. Ele trar\'e1 todos os c\'e1lculos j\'e1 feitos para um determinado indiv\'edduo.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\field{\*\fldinst INCLUDEPICTURE "C:\\\\PROJETO\\\\NUTWIN\\\\Help\\\\HTML\\\\Calculadora\\\\PrintDoc\\\\topo.bmp" \\* MERGEFORMAT \\d}{\fldrslt {\lang1024}}}
\par 
}
\page 
{
\pard\plain\s2\sb200\sa200\sl200\qj\f1\fs24\b\i \sb280\sa280\ql {\f1\fs24\b\i Definindo um escopo para todos os c\'e1lculos}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Voc\'ea dever\'e1 preencher todas as informa\'e7\'f5es solicitadas nesta tela.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Ap\'f3s a valida\'e7\'e3o dos dados inseridos, o programa disponibilizar\'e1 os demais c\'e1lculos :}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls12\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Antropometria}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls12\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Recomenda\'e7\'f5es de Energia}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls12\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Atividade F\'edsica}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls12\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Prepara\'e7\'e3o}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls12\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Inqu\'e9rito}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls12\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Plano Alimentar}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Alguns dados como Indiv\'edduo, Data da Visita, Nascimento ou Idade ( quando uma for preenchida, anula a outra) e Sexo, se vierem do Organizador, ter\'e3o seus valores preenchidos. Caso venham da Calculadora, estar\'e3o em branco.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Somente para mulheres:}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls13\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Gestante e o tempo em semanas da gesta\'e7\'e3o}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls13\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Nutriz e o tempo em semanas que amamenta}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Para deficientes, devem ser clicadas as partes amputadas.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Quando voc\'ea clicar o bot\'e3o de OK, toda a consist\'eancia do escopo ser\'e1 avaliada.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Ele avisar\'e1 quando os dados n\'e3o estiverem coerentes. Aceitar ou altere a entrada de dados.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Se desejar obter mais Informa\'e7\'f5es, estar\'e3o dispon\'edveis os crit\'e9rios utilizados para esta an\'e1lise.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\field{\*\fldinst INCLUDEPICTURE "C:\\\\PROJETO\\\\NUTWIN\\\\Help\\\\HTML\\\\Calculadora\\\\PrintDoc\\\\topo.bmp" \\* MERGEFORMAT \\d}{\fldrslt {\lang1024}}}
\par 
}
\page 
{
\pard\plain\s2\sb200\sa200\sl200\qj\f1\fs24\b\i \sb280\sa280\ql {\f1\fs24\b\i Iniciando um novo documento}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Para cada novo documento solicitado \'e9 apresentada uma tela de entrada dos dados b\'e1sicos do indiv\'edduo, tamb\'e9m chamado de dados de escopo. Estes dados v\'e3o identificar e definir quais tipos de c\'e1lculo podem ser realizados. Portanto, n\'e3o poder\'e3o ser alterados ap\'f3s a sua entrada.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Ap\'f3s terminado o preenchimento do escopo, o programa verifica a validade das informa\'e7\'f5es. Uma tela de Consist\'eancia das Informa\'e7\'f5es do Indiv\'edduo aparecer\'e1.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 A partir da\'ed estar\'e3o dispon\'edveis todos os c\'e1lculos.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0 }\par 
}
\page 
{
\pard\plain\s2\sb200\sa200\sl200\qj\f1\fs24\b\i \sb280\sa280\ql {\f1\fs24\b\i Abrindo um c\'e1lculo j\'e1 existente}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 O Programa permite carregar do disco outro c\'e1lculo gravado previamente.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Quando for chamada a fun\'e7\'e3o Abrir, aparecer\'e1 uma tela para que o usu\'e1rio localize o arquivo (.NUT). Quando selecionado, clique no bot\'e3o Abrir.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0 }\par 
}
\page 
{
\pard\plain\s2\sb200\sa200\sl200\qj\f1\fs24\b\i \sb280\sa280\ql {\f1\fs24\b\i Salvando um c\'e1lculo}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Grava em disco um arquivo .NUT .Ser\'e1 gravado num formato que o programa poder\'e1 ler, mesmo seja copiado em outra m\'e1quina que tamb\'e9m tenha o programa instalado.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Utilizando o comando Salvar, pode ser gravado em disco o documento que est\'e1 trabalhando, seja ele novo ou j\'e1 existente.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 O comando "Salvar como" serve para ser gravado um outro documento id\'eantico ao que j\'e1 tiver em disco, com novo nome e mantendo o antigo. Aparece tamb\'e9m quando o documento \'e9 salvo pela primeira vez.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Chame a fun\'e7\'e3o Salvar ou Salvar Como, escolha o local para a grava\'e7\'e3o e d\'ea um nome para o arquivo.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\field{\*\fldinst INCLUDEPICTURE "C:\\\\PROJETO\\\\NUTWIN\\\\Help\\\\HTML\\\\Calculadora\\\\PrintDoc\\\\topo.bmp" \\* MERGEFORMAT \\d}{\fldrslt {\lang1024}}}
\par 
}
\page 
{
\pard\plain\s2\sb200\sa200\sl200\qj\f1\fs24\b\i \sb280\sa280\ql {\f1\fs24\b\i Fechando o c\'e1lculo ativo}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Fecha o c\'e1lculo aberto sem sair do programa. Para voltar para o Windows, utilize o Sair. }\par 
}
\page 
{
\pard\plain\s2\sb200\sa200\sl200\qj\f1\fs24\b\i \sb280\sa280\ql {\f1\fs24\b\i Imprimindo um c\'e1lculo}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Envia para a impressora o documento que estiver ativo no programa. }\par 
}
