\pard\plain\s4\sb100\sa100\sl100\qj\f1\fs20\b \sb280\sa280\ql {\f1\fs24\b\i Que resultados podemos obter de um Plano Alimentar ?}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0Resumo do Plano Alimentar: mostra os alimentos utilizados no Plano alimentar com as suas respectivas medidas caseiras, quantidade e valor em gramas, al\'e9m de indicar a refei\'e7\'e3o \'e0 qual pertence.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b C\'e1lculos Nutricionais: }{\f1\fs18 a nutricionista tem oportunidade de observar quanto de cada nutriente est\'e1 sendo ingerido pelo indiv\'edduo.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Adequa\'e7\'e3o pela RDA:}{\f1\fs18  apresenta representa\'e7\'e3o gr\'e1fica que indica, em forma de porcentagem, quanto foi ingerido dos nutrientes que formam a RDA.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Plano Alimentar para o indiv\'edduo: }{\f1\fs18 Formato de f\'e1cil entendimento dos dados gerados pelo Plano Alimentar para os indiv\'edduos, com observa\'e7\'f5es descritas.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Equivalentes de Energ\'e9ticos e Prot\'e9icos : }{\f1\fs18 Para o Plano Alimentar prescrito pela nutricionista, para os alimentos que possu\'edrem cadastrados seus Equivalentes, ser\'e3o geradas listas de alimentos para substitui\'e7\'e3o.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0 }\par 
}
