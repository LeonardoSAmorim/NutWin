{
\pard\plain\s3\sb150\sa150\sl150\qj\f1\fs20 \sb280\sa280\ql {\f1\fs24\b\i Recomenda\'e7\'e3o de Energia pela FAO/OMS (RCFAO)}\par {\plain\v \f1 {\plain\xe\fs020\v {Recomenda\'e7\'e3o Cal\'f3rica pela FAO/OMS (RCFAO)}}}
\pard\plain\s3\sb150\sa150\sl150\qj\f1\fs20 \sb280\sa280\ql {\f1\fs24\b\i \'a0}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls19\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Introdu\'e7\'e3o}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls19\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Sele\'e7\'e3o de Atividades F\'edsicas}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Introdu\'e7\'e3o}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Escopo: Adulto (> 18 anos), ambos os sexos, n\'e3o gestante e n\'e3o nutriz.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Fonte: Recommended Dietary Allowances - 10th Edition - National Academy Press, Washington, D.C. 1989.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Na Recomenda\'e7\'e3o de Energia pela FAO/OMS \'e9 levada em considera\'e7\'e3o a Freq\'fc\'eancia da Atividade F\'edsica exercida pelo indiv\'edduo.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\field{\*\fldinst INCLUDEPICTURE "C:\\\\PROJETO\\\\NUTWIN\\\\Help\\\\HTML\\\\Calculadora\\\\PrintDoc\\\\topo.bmp" \\* MERGEFORMAT \\d}{\fldrslt {\lang1024}}}
\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b \'a0}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Sele\'e7\'e3o das Atividades F\'edsicas}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Se escolhida a Atividade F\'edsica por dia, deve ser informada uma intensidade que mais se adapte ao indiv\'edduo}{\f1\fs18 .}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Atividade F\'edsica por dia}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls20\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Muito leve: Atividades sentado ou em p\'e9, parado, dirigir, trabalho de laborat\'f3rio, datilografar, costurar, passar roupa, cozinhar, jogar cartas, tocar instrumento musical.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls20\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Leve: Andar 5 a 6 km/h. Trabalhos como: eletricista, carpintaria, em restaurantes, limpeza de casa, cuidar de crian\'e7a, golf, velejar, t\'eanis de mesa.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls20\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Moderada: Andar 7 a 8 km/h, capinar e cavar, carregando peso, andando de bicicleta, esquiar, jogar t\'eanis, dan\'e7ar.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls20\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Pesada ou Intensa: Trabalho em usina, atletas, soldados em atividades, agricultores n\'e3o mecanizados.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 \ls20\ilvl0 \fi-360\li720\tx720 {\f1\fs18 Excepcional ou Muito Intensa: Lenhadores, pedreiros, ferreiros}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\field{\*\fldinst INCLUDEPICTURE "C:\\\\PROJETO\\\\NUTWIN\\\\Help\\\\HTML\\\\Calculadora\\\\PrintDoc\\\\topo.bmp" \\* MERGEFORMAT \\d}{\fldrslt {\lang1024}}}
\par 
}
