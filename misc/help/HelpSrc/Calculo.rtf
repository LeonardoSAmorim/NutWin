\pard\plain\sb80\sa120\qj\f1\fs18 \intbl {\f1\fs18 Perda de Peso}\cell \row 
\trowd\trgaph24\cellx259\cellx8639 
\pard\plain\sb80\sa120\qj\f1\fs18 \intbl {\f1\fs18 2.}\cell 
\pard\plain\sb80\sa120\qj\f1\fs18 \intbl {\f1\fs18 Ganho de Peso}\cell \row 
\trowd\trgaph24\cellx259\cellx8639 
