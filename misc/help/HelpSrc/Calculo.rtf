\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Nome do Plano Alimentar}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Deve ser dado um Nome. Ele facilita a localiza\'e7\'e3o dos Planos Alimentares gravados.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0}\par 
