\pard\plain\s1\sb250\sa250\sl250\ql\f1\fs24\b\i Trabalhando com C\'e1lculos\par
{
\pard\plain\s2\sb200\sa200\sl200\qj\f1\fs24\b\i \sb280\sa280\ql {\f1\fs24\b\i Iniciando um c\'e1lculo}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Para criar um novo arquivo ou abrir um j\'e1 existente, usar os bot\'f5es ou menu em arquivo.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Caso seja um novo arquivo, selecione um dos tipos de c\'e1lculo nos bot\'f5es ou menu em c\'e1lculos, para visualizar ou imprimir o resultado. Pressione, ent\'e3o, a op\'e7\'e3o Calcular.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Para cada novo c\'e1lculo solicitado \'e9 apresentada uma tela de entrada dos dados b\'e1sicos do indiv\'edduo, tamb\'e9m chamado de Dados de Escopo. Estes dados v\'e3o identificar e definir quais tipos de c\'e1lculo podem ser realizados, portanto, estes n\'e3o poder\'e3o ser alterados ap\'f3s a sua entrada.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Data da Visita}{\f1\fs18 : para efeito de c\'e1lculo da idade.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Nascimento}{\f1\fs18 : para c\'e1lculo da idade.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Anos, Meses e Dias}{\f1\fs18 : podem ser digitados ou calculados, definindo a faixa et\'e1ria.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Sexo}{\f1\fs18 : Feminino ou Masculino.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Peso Atual}{\f1\fs18 : mensurado ou informado. Necess\'e1rio para definir algumas tabelas de percentil.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Estatura}{\f1\fs18 : mensurado. Necess\'e1rio para definir algumas tabelas de percentil.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Gestante a}{\f1\fs18 : indica ao mesmo tempo se \'e9 gestante (<> 0 ) e a quanto tempo.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18\b Nutriz a}{\f1\fs18 : indica ao mesmo tempo se \'e9 nutriz (<> 0 ) e a quanto tempo.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 \'a0}\par 
