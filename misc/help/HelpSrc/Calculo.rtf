\pard\plain\sb80\sa120\qj\f1\fs18 \intbl {\f1\fs18 Manuten\'e7\'e3o do Peso}\cell \row 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 A Recomenda\'e7\'e3o de Energia de um indiv\'edduo \'e9 determinada atrav\'e9s de algumas f\'f3rmulas:}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Recomenda\'e7\'e3o de Energia pela FAO/OMS (RCFAO)}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Recomenda\'e7\'e3o de Energia para pacientes}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Recomenda\'e7\'e3o de Energia pela RDA}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\f1\fs18 Com estas informa\'e7\'f5es, a nutricionista vai analisar um Plano Alimentar adequado as necessidades do indiv\'edduo.}\par 
\pard\plain\sb80\sa120\qj\f1\fs18 {\field{\*\fldinst INCLUDEPICTURE "C:\\\\PROJETO\\\\NUTWIN\\\\Help\\\\HTML\\\\Calculadora\\\\PrintDoc\\\\topo.bmp" \\* MERGEFORMAT \\d}{\fldrslt {\lang1024}}}
