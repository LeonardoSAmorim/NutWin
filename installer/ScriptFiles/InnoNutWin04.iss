;;Filename: {pf}\MySQL\MySQL Server 5.1\bin\MySQLInstanceConfig; Parameters: "  -r "; WorkingDir: {tmp}; StatusMsg: Verificando instancia do MySQL; Flags: waituntilterminated

Filename: {pf}\MySQL\MySQL Server 5.1\bin\MySQLInstanceConfig; Parameters: " -i  RootPassword=masterkey ServiceName=MySQL  ""-p{pf}\MySQL\MySQL Server 5.1"" AddBinToPath=yes ServerType=SERVER DatabaseType=MIXED ConnectionUsage=DSS Port=3306 StrictMode=yes Charset=latin1 ""-l{pf}\MySQL\MySQL Server 5.1\instanceConfig.log"""; WorkingDir: {tmp}; StatusMsg: Configurando instancia do MySQL; Flags: waituntilterminated
