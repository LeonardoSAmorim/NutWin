function Testa_NS(LsSerial,LsSistema,LsVersao: string): Integer;
external 'Testa_NS@files:NWInstUtils.dll cdecl setuponly delayload';
//external 'Testa_NS@files:NWInstUtils.dll stdcall setuponly delayload';


function CheckSerial(Serial: String): Boolean;
var serialKey:String;
	info:string;
	cripto:string;
	Sistema,Versao:string;
begin

	// SeriaKey[  2,  4 ] => Software (NutWin = "NU")
	// SeriaKey[  6, 10 ] =>
	// SeriaKey[ 10, 12, 14, 16 ] => Numero do Usuário (0000 = avaliacao, 9999 = desenvolvimento)
	//		usuário

	Sistema := 'NU';
	Versao  := '02';

	//serialKey := UpperCase(Trim(ExpandConstant('{userinfoserial}')));
	serialKey := UpperCase(Serial);

  MsgBox(intToStr(Testa_NS(serialKey,Sistema, Versao))+ ' - ['+serial+']' , mbInformation, MB_OK);
	if  (Testa_NS(SerialKey, Sistema, Versao) = 0) then
		result := true
	else
		result := false;
		//7N9U208180S8U7J2

end;
