[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{68EF2352-3243-463D-88F6-B628747A695E}
AppName=Programa de Apoio à Nutrição
AppVerName=Programa de Apoio à Nutrição 1.6
AppPublisher=Departamento de Informática em Saúde - UNIFESP
AppPublisherURL=http://www.unifesp.br/dis/produtos/nutwin/
AppSupportURL=http://www.unifesp.br/dis/produtos/nutwin/
AppUpdatesURL=http://www.unifesp.br/dis/produtos/nutwin/
DefaultDirName={pf}\DIS-EPM\NutWin-1.6
DefaultGroupName=Programa de Apoio à Nutrição 1.6
AllowNoIcons=true
LicenseFile=E:\G\nutwin\src\InnoNutWin\SourceFiles\installFiles\License.txt
InfoAfterFile=E:\G\nutwin\src\InnoNutWin\SourceFiles\MirrorDest\Leia-me.txt
OutputDir=E:\G\nutwin\src\InnoNutWin\output
OutputBaseFilename=NutWin-1.6-beta
SetupIconFile=
Compression=lzma/ultra64
SolidCompression=true
ShowTasksTreeLines=true

;;     MySQL     = 155 MiB
;;   + MyODBC    =   9 MiB
;;   + ScriptSQL =  17 MiB
;;	 + MySQLData = 391 MiB
;;   + BDE          13 MiB
;;   ------------------
;;   total    =    585 MiB => 613416960 Bytes
;; ainda falta BDE, Dados ...
ExtraDiskSpaceRequired=5613416960
UserInfoPage=true
VersionInfoVersion=1.6
ShowLanguageDialog=auto
AppVersion=1.6
VersionInfoCopyright=Departamento de Informática em Saúde - UNIFESP
VersionInfoProductName=NutWin
VersionInfoProductVersion=1.6
AppCopyright=Departamento de Informática em Saúde - UNIFESP
DefaultUserInfoSerial={userinfoserial}
UsePreviousUserInfo=false
InfoBeforeFile=E:\G\nutwin\src\InnoNutWin\SourceFiles\installFiles\APRESENTAÇÃO.txt
WindowVisible=true
WindowResizable=false
WizardImageFile=E:\G\nutwin\src\InnoNutWin\SourceFiles\installFiles\Imagens\WizardImageFile.bmp
WizardSmallImageFile=E:\G\nutwin\src\InnoNutWin\SourceFiles\installFiles\Imagens\WizardSmallImageFile.bmp

[Languages]
Name: brazilianportuguese; MessagesFile: compiler:Languages\BrazilianPortuguese.isl

[Types]
Name: full; Description: Completa - Instala todos os recursos
Name: client; Description: Cliente - Instala Organizador e Calculadora
Name: server; Description: Servidor - Instala Sevidor e Base de Dados
Name: custom; Description: Personalizada - permite escolher os componentes; Flags: iscustom

[Components]
;; instalação para uso isolado
Name: Client; Description: Organizador e Calculadora; Types: full client
Name: BDE; Description: Borland Database Engine; types: full client
name: ODBC; Description: MyODBC Connector; types: full client
;; Instalação para uso na rede local
Name: Server; Description: MySQL Server; Types: full server
;; Database, datafiles, application data,
Name: DataBase; Description: Base de Dados Padrão; Types: full server
Name: Help; Description: Arquivos de Ajuda; Types: full client



[Tasks]
Name: desktopicon; Description: {cm:CreateDesktopIcon}; GroupDescription: {cm:AdditionalIcons}; Flags: unchecked
Name: quicklaunchicon; Description: {cm:CreateQuickLaunchIcon}; GroupDescription: {cm:AdditionalIcons}; Flags: unchecked



;; Name: standalone; Description: Instalação isolada, para uso somente na máquina local; GroupDescription: Configuração do Servidor; Flags: unchecked
;;;; para uso em rede, Ativar acesso de maquinas remotas (Ativar TCP/IP, abrir exceção no firewall), aumentar o número de conexões simultâneas,
;;Name: network; Description: Intalação em Rede, ativa o acesso a máquinas remotas; GroupDescription: Configuração do Servidor; Flags: unchecked
;;;; Standalone Application "autônomo" "isolado"
;;;; Local Network Application (ativa o acesso a máquinas remotas, e permite mais conexões ao BD)

[Files]


Source: SourceFiles\MirrorDest\*; DestDir: {app}; Flags: ignoreversion recursesubdirs createallsubdirs
Source: SourceFiles\components\SQLScript\dumpNutWin.sql; DestDir: {tmp}; Flags: deleteafterinstall
Source: SourceFiles\components\MySQL\*; DestDir: {tmp}; Flags: deleteafterinstall
Source: SourceFiles\components\BDE\BdeInst.dll; DestDir: {tmp}; Flags: deleteafterinstall
Source: SourceFiles\components\NWInstUtils\NWInstUtils.dll; Flags: dontcopy


[Icons]

Name: {commondesktop}\Organizador; Filename: {app}\OrgNut\PNutwin.exe; Tasks: desktopicon
Name: {userappdata}\Microsoft\Internet Explorer\Quick Launch\Organizador; Filename: {app}\OrgNut\PNutwin.exe; Tasks: quicklaunchicon
Name: {group}\Ajuda da Calculadora; Filename: {app}\Help\Calculo.chm
Name: {group}\Ajuda do Organizador; Filename: {app}\Help\Organiza.chm
Name: {group}\Calculadora; Filename: {app}\Calc\CalcNut.exe
Name: {group}\Atualizações; Filename: {app}\NutWin.txt
Name: {group}\Guia-Nut; Filename: {app}\Help\Guia-Nut.html
Name: {group}\Organizador; Filename: {app}\OrgNut\PNutwin.exe
Name: {group}\{cm:ProgramOnTheWeb,Programa de Apoio à Nutrição}; Filename: http://www.unifesp.br/dis/produtos/nutwin/
Name: {group}\{cm:UninstallProgram,Programa de Apoio à Nutrição}; Filename: {uninstallexe}

[Run]
Filename: "notepad "; Description: Exibir arquivo Leia-me; Flags: nowait postinstall skipifsilent; Parameters: {app}\Leia-me.txt
Filename: {app}\OrgNut\PNutwin.exe; Description: {cm:LaunchProgram,Programa de Apoio à Nutrição}; Flags: nowait postinstall skipifsilent


;; instala o MySQL Server
Filename: msiexec.exe; Parameters: "/qb /i ""{tmp}\mysql-5.1.33-win32.msi"""; WorkingDir: {tmp}; StatusMsg: Instalando MySQL Server 5.1; Flags: waituntilterminated
;; msiexec.exe "/qb /i mysql-5.1.33-win32.msi"

;; Configura MySQL
;;Filename: {pf}\MySQL\MySQL Server 5.1\bin\MySQLInstanceConfig; Parameters: -q -i -nMySQL AddBinToPath=yes ServerType=SERVER DatabaseType=MIXED ConnectionUsage=DSS Port=3306 StrictMode=yes Charset=latin1 RootPassword=masterkey; WorkingDir: {tmp}; StatusMsg: Configurando instancia do MySQL
;; -s para o serviço
;; -i inicia o servico/reconfigura (Instala)
;; -r remove o servico
;;	Filename: net; Parameters: start MySQL; WorkingDir: {tmp}; StatusMsg: Verificando instancia do MySQL; Flags: waituntilterminated
;;	Filename: net; Parameters: start MySQL; WorkingDir: {tmp}; StatusMsg: Verificando instancia do MySQL; Flags: waituntilterminated
;;"%programfiles%\MySQL\MySQL Server 5.1\bin\MySQLInstanceConfig" -r
Filename: {pf}\MySQL\MySQL Server 5.1\bin\MySQLInstanceConfig; Parameters: " -i -q "; WorkingDir: {tmp}; StatusMsg: Iniciando Serviço MySQL; Flags: waituntilterminated
;;Filename: {pf}\MySQL\MySQL Server 5.1\bin\MySQLInstanceConfig; Parameters: "  -r "; WorkingDir: {tmp}; StatusMsg: Verificando instancia do MySQL; Flags: waituntilterminated

Filename: {pf}\MySQL\MySQL Server 5.1\bin\MySQLInstanceConfig; Parameters: " -i  RootPassword=masterkey ServiceName=MySQL  ""-p{pf}\MySQL\MySQL Server 5.1"" AddBinToPath=yes ServerType=SERVER DatabaseType=MIXED ConnectionUsage=DSS Port=3306 StrictMode=yes Charset=latin1 ""-l{pf}\MySQL\MySQL Server 5.1\instanceConfig.log"""; WorkingDir: {tmp}; StatusMsg: Configurando instancia do MySQL; Flags: waituntilterminated
;;"%programfiles%\MySQL\MySQL Server 5.1\bin\MySQLInstanceConfig" -i -q RootPassword=masterkey ServiceName=MySQL  "-p%programfiles%\MySQL\MySQL Server 5.1" AddBinToPath=yes ServerType=SERVER DatabaseType=MIXED ConnectionUsage=DSS Port=3306 StrictMode=yes Charset=latin1 "-l%programfiles%\MySQL\MySQL Server 5.1\instanceConfig.log"

