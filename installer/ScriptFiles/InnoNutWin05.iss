Filename: msiexec.exe; Parameters: "/qb /i  ""{tmp}\mysql-connector-odbc-3.51.27-win32.msi"""; WorkingDir: {tmp}; StatusMsg: Instalando MySQL Connector/ODBC 3.51; Flags: waituntilterminated

;; Instala BDE
;;Filename: {src}\BDE\MiniReg\MiniReg.exe; Parameters: {src}\BDE\BdeInst.dll; WorkingDir: {tmp}; StatusMsg: Instalando Borland Database Engine e SQL Links; Flags: waituntilterminated
