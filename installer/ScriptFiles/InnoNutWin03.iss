; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{68EF2352-3243-463D-88F6-B628747A695E}
AppName=Programa de Apoio à Nutrição
AppVerName=Programa de Apoio à Nutrição 1.6
AppPublisher=Departamento de Informática em Saúde - UNIFESP
AppPublisherURL=http://www.unifesp.br/dis/produtos/nutwin/
AppSupportURL=http://www.unifesp.br/dis/produtos/nutwin/
AppUpdatesURL=http://www.unifesp.br/dis/produtos/nutwin/
DefaultDirName={pf}\DIS-EPM\NutWin
DefaultGroupName=Programa de Apoio à Nutrição
AllowNoIcons=true
LicenseFile=G:\nutwin\src\InnoNutWin\SourceFiles\installFiles\License.txt
InfoAfterFile=G:\nutwin\src\InnoNutWin\SourceFiles\MirrorDest\Leia-me.txt
OutputDir=G:\nutwin\src\InnoNutWin\output
OutputBaseFilename=config
SetupIconFile=G:\nutwin\src\InnoNutWin\SourceFiles\NutWin.ico
Compression=lzma/ultra64
SolidCompression=true
ShowTasksTreeLines=true

;;     MySQL     = 155 MiB
;;   + MyODBC    =   9 MiB
;;   + ScriptSQL =  17 MiB
;;	 + MySQLData = 391 MiB
;;   ------------------
;;   total    =   MiB => 599785472 Bytes
;; ainda falta BDE, Dados ...
ExtraDiskSpaceRequired=599785472
UserInfoPage=true

[Languages]
Name: brazilianportuguese; MessagesFile: compiler:Languages\BrazilianPortuguese.isl

[Tasks]
Name: desktopicon; Description: {cm:CreateDesktopIcon}; GroupDescription: {cm:AdditionalIcons}; Flags: unchecked
Name: quicklaunchicon; Description: {cm:CreateQuickLaunchIcon}; GroupDescription: {cm:AdditionalIcons}; Flags: unchecked

[Files]
;Source: G:\nutwin\src\InnoNutWin\SourceFiles\MirrorDest\OrgNut\PNutwin.exe; DestDir: {app}; Flags: ignoreversion
;Source: G:\nutwin\src\InnoNutWin\SourceFiles\MirrorDest\Leia-me.txt; DestDir: {app}; Flags: ignoreversion
;Source: G:\nutwin\src\InnoNutWin\SourceFiles\MirrorDest\NutWin.txt; DestDir: {app}; Flags: ignoreversion
Source: SourceFiles\MirrorDest\*; DestDir: {app}; Flags: ignoreversion recursesubdirs createallsubdirs deleteafterinstall
;Source: G:\nutwin\src\InnoNutWin\SourceFiles\MirrorDest\Calc\*; DestDir: {app}\Calc; Flags: ignoreversion recursesubdirs createallsubdirs
;Source: G:\nutwin\src\InnoNutWin\SourceFiles\MirrorDest\Help\*; DestDir: {app}\Help; Flags: ignoreversion recursesubdirs createallsubdirs
;Source: G:\nutwin\src\InnoNutWin\SourceFiles\MirrorDest\OrgNut\*; DestDir: {app}\OrgNut; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files
;Source: SourceFiles\components\SQLScript\dumpNutWin.sql; DestDir: {tmp}

[Icons]
Name: {group}\Programa de Apoio à Nutrição; Filename: {app}\OrgNut\PNutwin.exe
Name: {group}\{cm:ProgramOnTheWeb,Programa de Apoio à Nutrição}; Filename: http://www.unifesp.br/dis/produtos/nutwin/
Name: {group}\{cm:UninstallProgram,Programa de Apoio à Nutrição}; Filename: {uninstallexe}
Name: {commondesktop}\Programa de Apoio à Nutrição; Filename: {app}\PNutwin.exe; Tasks: desktopicon
Name: {userappdata}\Microsoft\Internet Explorer\Quick Launch\Programa de Apoio à Nutrição; Filename: {app}\OrgNut\PNutwin.exe; Tasks: quicklaunchicon

[Run]
Filename: {app}\OrgNut\PNutwin.exe; Description: {cm:LaunchProgram,Programa de Apoio à Nutrição}; Flags: nowait postinstall skipifsilent

;; instala o MySQL Server
Filename: msiexec.exe; Parameters: "/i ""{src}\MySQL\mysql-5.1.33-win32.msi"" /qr"; WorkingDir: {tmp}; StatusMsg: Instalando MySQL Server 5.1

;; Configura MySQL
;;Filename: {pf}\MySQL\MySQL Server 5.1\bin\MySQLInstanceConfig; Parameters: -i -q -nMySQL AddBinToPath=yes ServerType=SERVER DatabaseType=MIXED ConnectionUsage=DSS Port=3306 StrictMode=yes Charset=latin1 RootPassword=masterkey; WorkingDir: {tmp}; StatusMsg: Configurando instancia do MySQL
Filename: {pf}\MySQL\MySQL Server 5.1\bin\MySQLInstanceConfig; Parameters: " -q ServiceName=MySQL RootCurrentPassword=masterkey RootPassword=masterkey ""-p{pf}\MySQL\MySQL Server 5.1"" AddBinToPath=yes ServerType=SERVER DatabaseType=MIXED ConnectionUsage=DSS Port=3306 StrictMode=yes Charset=latin1 ""-l{pf}\MySQL\MySQL Server 5.1\instanceConfig.log"""; WorkingDir: {tmp}; StatusMsg: Configurando instancia do MySQL

;; Instala Base de Dados
;;Filename: {pf}\MySQL\MySQL Server 5.1\bin\mysql; Parameters: -u root -pmasterkey < {tmp}\dumpNutWin.sql; WorkingDir: {tmp}; StatusMsg: Gerando Base de dados e Registros ( {tmp}\dumpNutWin.sql)
Filename: {pf}\MySQL\MySQL Server 5.1\bin\mysql; Parameters: "-u root -pmasterkey --execute=""source {tmp}\dumpNutWin.sql"""; WorkingDir: {tmp}; StatusMsg: Gerando Base de dados e Registros; Flags: runminimized

;; Instala MyODBC (veja configuracao na seção [Registry]
Filename: msiexec.exe; Parameters: "/i /qr ""{src}\MySQL\mysql-connector-odbc-3.51.27-win32.msi"""; WorkingDir: {tmp}; StatusMsg: Instalando MySQL Connector/ODBC 3.51

;; Instala BDE
Filename: {src}\BDE\MiniReg\MiniReg.exe; Parameters: {src}\BDE\BdeInst.dll; WorkingDir: {tmp}; StatusMsg: Instalando Borland Database Engine e SQL Links
;;
[Registry]
;;;;;NutWin
;;By registering your application under the App Paths key, users can start your application from Explorer's Run dialog by entering just the EXE's filename and no path.
Root: HKLM; Subkey: SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\YourApplicationName.exe; ValueType: string; ValueName: ; ValueData: {app}\OrgNut\PNutwin.exe; Flags: uninsdeletekey
Root: HKLM; Subkey: SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\YourApplicationName.exe; ValueType: string; ValueName: ; ValueData: {app}\Calc\Calcnut.exe; Flags: uninsdeletekey
;; primeira fase
Root: HKLM; Subkey: SOFTWARE\DIS-EPM; Flags: createvalueifdoesntexist uninsdeletekeyifempty
Root: HKLM; Subkey: SOFTWARE\DIS-EPM\NutWin; Flags: createvalueifdoesntexist uninsdeletekey
Root: HKLM; Subkey: SOFTWARE\DIS-EPM\NutWin\0; Flags: createvalueifdoesntexist
;; [PROVISÓRIO] DEVERÁ SER ADICIONADO  na segunda fase de instalação [usuário e nome]
Root: HKLM; Subkey: SOFTWARE\DIS-EPM\NutWin; ValueName: Name; ValueData: DTI; ValueType: string
Root: HKLM; Subkey: SOFTWARE\DIS-EPM\NutWin; ValueName: Company; ValueData: EmpresaDoUsuario; ValueType: string
Root: HKLM; Subkey: SOFTWARE\DIS-EPM\NutWin; ValueName: Serial; ValueData: 7N9U208180S8U7J2; ValueType: string
;; [PROVISÓRIO] DEVERÁ SER ADICIONADO na terceira fase da instalacao [diretorio destino]
Root: HKLM; Subkey: SOFTWARE\DIS-EPM\NutWin; ValueName: Tipo; ValueData: Cliente/Servidor; ValueType: string
Root: HKLM; Subkey: SOFTWARE\DIS-EPM\NutWin; ValueName: PERSONA FILE NAME; ValueData: {app}; ValueType: string
Root: HKLM; Subkey: SOFTWARE\DIS-EPM\NutWin; ValueName: LOGO FILE NAME; ValueData: {app}; ValueType: string
Root: HKLM; Subkey: SOFTWARE\DIS-EPM\NutWin; ValueName: Path; ValueData: {app}; ValueType: string

;;;;; MyODBC
